#!/usr/bin/env python3

import argparse
import hashlib
import json
import os
import platform
import statistics
import subprocess
import sys
import tempfile
from pathlib import Path

import tomllib


def fail(message, code=1):
    print(f"\033[1;31merror:\033[0m {message}", file=sys.stderr)
    raise SystemExit(code)


def command_output(command):
    result = subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def read_spec(path):
    try:
        with path.open("rb") as source:
            spec = tomllib.load(source)
    except (OSError, tomllib.TOMLDecodeError) as error:
        fail(f"cannot read benchmark spec {path}: {error}", 2)
    required = {"name", "cpu", "baseline", "candidate"}
    missing = required - spec.keys()
    if missing:
        fail(f"benchmark spec is missing: {', '.join(sorted(missing))}", 2)
    if not isinstance(spec["cpu"], int) or spec["cpu"] < 0:
        fail("cpu must be a non-negative integer", 2)
    spec["runs"] = spec.get("runs", 7)
    spec["warmups"] = spec.get("warmups", 2)
    if not isinstance(spec["runs"], int) or spec["runs"] < 3:
        fail("runs must be an integer of at least 3", 2)
    if not isinstance(spec["warmups"], int) or spec["warmups"] < 1:
        fail("warmups must be an integer of at least 1", 2)
    spec["output_equivalence"] = spec.get("output_equivalence", "exact")
    if spec["output_equivalence"] not in {"exact", "per-arm"}:
        fail("output_equivalence must be 'exact' or 'per-arm'", 2)
    for name in ("baseline", "candidate"):
        validate_arm(name, spec[name], path.parent)
    return spec


def validate_arm(name, arm, spec_root):
    if not isinstance(arm, dict):
        fail(f"{name} must be a TOML table", 2)
    command = arm.get("command")
    if (
        not isinstance(command, list)
        or not command
        or not all(isinstance(value, str) and value for value in command)
    ):
        fail(f"{name}.command must be a non-empty string array", 2)
    cwd = resolve_path(spec_root, arm.get("cwd", "."))
    if not cwd.is_dir():
        fail(f"{name}.cwd is not a directory: {cwd}", 2)
    environment = arm.get("environment", {})
    if not isinstance(environment, dict) or not all(
        isinstance(key, str) and isinstance(value, str)
        for key, value in environment.items()
    ):
        fail(f"{name}.environment must contain string values", 2)
    if "result_file" in arm and not isinstance(arm["result_file"], str):
        fail(f"{name}.result_file must be a path string", 2)


def resolve_path(root, value):
    path = Path(value)
    return path.resolve() if path.is_absolute() else (root / path).resolve()


def child_environment(arm):
    environment = os.environ.copy()
    environment.update(arm.get("environment", {}))
    return environment


def run_command(arm, spec_root, cpu, measured):
    cwd = resolve_path(spec_root, arm.get("cwd", "."))
    command = arm["command"]
    environment = child_environment(arm)
    perf_path = None
    if measured:
        scratch = Path.home() / "Scratch"
        scratch.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            prefix="instruction-bench-", suffix=".perf", dir=scratch, delete=False
        ) as handle:
            perf_path = Path(handle.name)
        launch = [
            "perf",
            "stat",
            "--no-big-num",
            "-x",
            "\t",
            "-e",
            "instructions:u",
            "-o",
            str(perf_path),
            "--",
            *command,
        ]
    else:
        launch = command
    try:
        result = subprocess.run(
            launch,
            cwd=cwd,
            env=environment,
            capture_output=True,
            check=False,
            preexec_fn=lambda: os.sched_setaffinity(0, {cpu}),
        )
        if result.returncode != 0:
            stderr = result.stderr.decode(errors="replace").strip()
            fail(f"command failed ({result.returncode}): {' '.join(command)}\n{stderr}")
        evidence = result.stdout
        evidence_source = "stdout"
        if "result_file" in arm:
            result_path = resolve_path(cwd, arm["result_file"])
            try:
                evidence = result_path.read_bytes()
            except OSError as error:
                fail(f"cannot read result_file {result_path}: {error}")
            evidence_source = str(result_path)
        if not evidence and not arm.get("allow_empty_output", False):
            fail(
                f"{' '.join(command)} produced empty equivalence evidence; set result_file or explicitly allow_empty_output"
            )
        instructions = parse_perf(perf_path) if measured else None
        return {
            "instructions": instructions,
            "output_sha256": hashlib.sha256(evidence).hexdigest(),
            "output_bytes": len(evidence),
            "output_source": evidence_source,
        }
    finally:
        if perf_path and perf_path.exists():
            perf_path.unlink()


def parse_perf(path):
    counts = []
    for line in path.read_text().splitlines():
        fields = line.split("\t")
        if len(fields) < 3 or "instructions" not in fields[2]:
            continue
        value = fields[0].strip()
        if value.startswith("<"):
            continue
        try:
            counts.append(int(value))
        except ValueError:
            fail(f"could not parse perf instruction count: {line}")
    if not counts:
        fail("perf returned no supported userspace instruction counter")
    return sum(counts)


def git_state(cwd):
    head = command_output(["git", "-C", str(cwd), "rev-parse", "HEAD"])
    if not head:
        return None
    status = subprocess.run(
        ["git", "-C", str(cwd), "status", "--porcelain=v1"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    ).stdout
    return {
        "head": head,
        "dirty": bool(status.strip()),
        "status_sha256": hashlib.sha256(status.encode()).hexdigest(),
    }


def arm_metadata(arm, spec_root):
    cwd = resolve_path(spec_root, arm.get("cwd", "."))
    return {
        "label": arm.get("label"),
        "command": arm["command"],
        "cwd": str(cwd),
        "environment_names": sorted(arm.get("environment", {})),
        "result_file": arm.get("result_file"),
        "allow_empty_output": bool(arm.get("allow_empty_output", False)),
        "git": git_state(cwd),
    }


def summary(values):
    median = statistics.median(values)
    deviations = [abs(value - median) for value in values]
    return {
        "samples": values,
        "median": median,
        "minimum": min(values),
        "maximum": max(values),
        "median_absolute_deviation": statistics.median(deviations),
    }


def machine_metadata(cpu):
    model = None
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("model name"):
                model = line.split(":", 1)[1].strip()
                break
    except OSError:
        pass
    return {
        "architecture": platform.machine(),
        "kernel": platform.release(),
        "cpu": cpu,
        "cpu_model": model,
        "python": platform.python_version(),
        "perf": command_output(["perf", "--version"]),
    }


def benchmark(spec, spec_path):
    spec_root = spec_path.parent
    cpu = spec["cpu"]
    available = os.sched_getaffinity(0)
    if cpu not in available:
        fail(f"cpu {cpu} is not in this process's affinity set: {sorted(available)}", 2)
    observed_hashes = {"baseline": set(), "candidate": set()}
    for _ in range(spec["warmups"]):
        for name in ("baseline", "candidate"):
            observation = run_command(spec[name], spec_root, cpu, measured=False)
            observed_hashes[name].add(observation["output_sha256"])
    samples = {"baseline": [], "candidate": []}
    raw = []
    for index in range(spec["runs"]):
        order = (
            ("baseline", "candidate") if index % 2 == 0 else ("candidate", "baseline")
        )
        for name in order:
            observation = run_command(spec[name], spec_root, cpu, measured=True)
            observed_hashes[name].add(observation["output_sha256"])
            samples[name].append(observation["instructions"])
            raw.append({"round": index + 1, "arm": name, **observation})
    for name, hashes in observed_hashes.items():
        if len(hashes) != 1:
            fail(f"{name} output evidence changed across runs: {sorted(hashes)}")
    if (
        spec["output_equivalence"] == "exact"
        and observed_hashes["baseline"] != observed_hashes["candidate"]
    ):
        fail("baseline and candidate output evidence differs")
    baseline = summary(samples["baseline"])
    candidate = summary(samples["candidate"])
    reduction = (baseline["median"] - candidate["median"]) / baseline["median"] * 100
    return {
        "schema": 1,
        "name": spec["name"],
        "metric": "retired userspace instructions",
        "event": "instructions:u",
        "runs": spec["runs"],
        "warmups": spec["warmups"],
        "output_equivalence": spec["output_equivalence"],
        "machine": machine_metadata(cpu),
        "baseline": {**arm_metadata(spec["baseline"], spec_root), **baseline},
        "candidate": {**arm_metadata(spec["candidate"], spec_root), **candidate},
        "instruction_reduction_percent": reduction,
        "raw_order": raw,
    }


def print_summary(result):
    baseline = result["baseline"]
    candidate = result["candidate"]
    print(f"\033[1;35m◇ {result['name']}\033[0m")
    print(
        f"  baseline   {baseline['median']:,.0f} instructions  MAD {baseline['median_absolute_deviation']:,.0f}"
    )
    print(
        f"  candidate  {candidate['median']:,.0f} instructions  MAD {candidate['median_absolute_deviation']:,.0f}"
    )
    print(f"  reduction  {result['instruction_reduction_percent']:.2f}%")
    print(
        f"  evidence   {result['runs']} interleaved runs · output {result['output_equivalence']}"
    )


def main():
    parser = argparse.ArgumentParser(
        description="Compare retired userspace instructions with an interleaved, output-checked workload."
    )
    parser.add_argument("spec", type=Path)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    arguments = parser.parse_args()
    spec_path = arguments.spec.resolve()
    spec = read_spec(spec_path)
    if arguments.dry_run:
        plan = {
            "name": spec["name"],
            "cpu": spec["cpu"],
            "runs": spec["runs"],
            "warmups": spec["warmups"],
            "baseline": arm_metadata(spec["baseline"], spec_path.parent),
            "candidate": arm_metadata(spec["candidate"], spec_path.parent),
        }
        print(json.dumps(plan, indent=2, sort_keys=True))
        return
    if arguments.output and arguments.output.exists() and not arguments.force:
        fail(f"output exists: {arguments.output}; pass --force to replace it", 2)
    result = benchmark(spec, spec_path)
    encoded = json.dumps(result, indent=2, sort_keys=True) + "\n"
    if arguments.output:
        arguments.output.parent.mkdir(parents=True, exist_ok=True)
        arguments.output.write_text(encoded)
    if arguments.json:
        print(encoded, end="")
    else:
        print_summary(result)
        if arguments.output:
            print(f"  raw        {arguments.output.resolve()}")


if __name__ == "__main__":
    main()
