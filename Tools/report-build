def render_latex(project):
    metadata = project.metadata
    settings = presentation_settings(metadata)
    font_size = settings["font_size_pt"]
    class_size = min((10, 11, 12), key=lambda value: abs(value - font_size))
    baseline = font_size * settings["line_height"]
    margins = settings["margins_mm"]
    heading_spacing = settings["heading_spacing_pt"]
    caption_spacing = settings["caption_spacing_pt"]
    title_treatment = settings["title"]
    title = latex_escape(metadata["title"])
    subtitle = metadata.get("subtitle")
    date = metadata.get("date", "")
    assessment = metadata.get("assessment")
    identities = cover_identities(metadata)
    author_lines = []
    for identity in identities:
        author_lines.append(
            r" \,\textperiodcentered\, ".join(
                latex_escape(str(value))
                for value in (
                    identity.get("name"),
                    identity.get("identifier"),
                    identity.get("role"),
                )
                if value
            )
        )
    institution = [latex_escape(value) for value in institution_details(metadata)]
    alignment = {
        "left": "flushleft",
        "center": "center",
        "right": "flushright",
    }[title_treatment["alignment"]]
    title_block = [
        f"\\begin{{{alignment}}}",
        f"{{\\fontsize{{{title_treatment['size_pt']:g}}}{{{title_treatment['size_pt'] * 1.2:g}}}\\selectfont\\bfseries {title}\\par}}",
    ]
    if subtitle:
        title_block.extend(
            (r"\vspace{0.8em}", f"{{\\large {latex_escape(str(subtitle))}\\par}}")
        )
    if assessment:
        title_block.extend(
            (r"\vspace{1em}", f"{{\\large {latex_escape(str(assessment))}\\par}}")
        )
    title_block.append(f"\\end{{{alignment}}}")
    cover_options = cover_page_options(metadata)
    if cover_options is not None:
        cover = [
            r"\begin{titlepage}",
            r"\thispagestyle{empty}",
            f"\\vspace*{{{title_treatment['top_margin_mm']:g}mm}}",
            *title_block,
            r"\vfill",
        ]
        if author_lines:
            author_heading = cover_options.get(
                "author_heading", "Author" if len(author_lines) == 1 else "Authors"
            )
            cover.extend(
                (
                    f"{{\\bfseries {latex_escape(str(author_heading))}\\par}}",
                    r"\vspace{0.45em}",
                    *(f"{line}\\par" for line in author_lines if line),
                )
            )
        if institution:
            institution_heading = cover_options.get(
                "institution_heading", "Institution"
            )
            cover.extend(
                (
                    r"\vspace{1.6em}",
                    f"{{\\bfseries {latex_escape(str(institution_heading))}\\par}}",
                    r"\vspace{0.45em}",
                    *(f"{line}\\par" for line in institution),
                )
            )
        if date:
            cover.extend((r"\vspace{1.6em}", f"{latex_escape(str(date))}\\par"))
        cover.extend((r"\vspace*{20mm}", r"\end{titlepage}", r"\setcounter{page}{1}"))
    else:
        cover = title_block
    content = []
    for position, section in enumerate(project.sections):
        if section.kind == "references":
            if content and content[-1] != r"\clearpage":
                content.append(r"\clearpage")
            if settings["columns"] == 2:
                content.append(r"\onecolumn")
            content.extend(latex_references(project, section))
            if position < len(project.sections) - 1:
                content.append(r"\clearpage")
                if settings["columns"] == 2:
                    content.append(r"\twocolumn")
            continue
        if section.page_break_before:
            content.append(r"\clearpage")
        content.extend(latex_block(block, project) for block in section.blocks)
    toc = (
        r"\tableofcontents\clearpage"
        if metadata.get("table_of_contents") is True
        else ""
    )
    column_command = r"\twocolumn" if settings["columns"] == 2 else ""
    if cover_options is None and settings["columns"] == 2:
        cover = [r"\twocolumn[", *cover, r"\vspace{1em}]"]
        column_command = ""
    return "\n".join(
        (
            f"\\documentclass[{class_size}pt,a4paper]{{article}}",
            r"\usepackage[T1]{fontenc}",
            r"\usepackage{lmodern}",
            f"\\usepackage[top={margins['top']:g}mm,right={margins['right']:g}mm,bottom={margins['bottom']:g}mm,left={margins['left']:g}mm]{{geometry}}",
            r"\usepackage{microtype}",
            r"\usepackage{graphicx}",
            r"\usepackage{booktabs}",
            r"\usepackage{tabularx}",
            r"\usepackage{float}",
            r"\usepackage{hanging}",
            r"\usepackage{titlesec}",
            r"\usepackage{caption}",
            r"\usepackage[hidelinks]{hyperref}",
            r"\setlength{\parindent}{0pt}",
            f"\\setlength{{\\parskip}}{{{settings['paragraph_spacing_pt']:g}pt}}",
            f"\\setlength{{\\columnsep}}{{{settings['column_gap_mm']:g}mm}}",
            f"\\setlength{{\\abovecaptionskip}}{{{caption_spacing['before']:g}pt}}",
            f"\\setlength{{\\belowcaptionskip}}{{{caption_spacing['after']:g}pt}}",
            f"\\titlespacing*{{\\section}}{{0pt}}{{{heading_spacing['before']:g}pt}}{{{heading_spacing['after']:g}pt}}",
            f"\\titlespacing*{{\\subsection}}{{0pt}}{{{heading_spacing['before']:g}pt}}{{{heading_spacing['after']:g}pt}}",
            f"\\titlespacing*{{\\subsubsection}}{{0pt}}{{{heading_spacing['before']:g}pt}}{{{heading_spacing['after']:g}pt}}",
            r"\begin{document}",
            f"\\fontsize{{{font_size:g}}}{{{baseline:g}}}\\selectfont",
            *cover,
            column_command,
            toc,
            *content,
            r"\end{document}",
            "",
        )
    )


class TrueTypeFont:
    def __init__(self, path, name, italic=False):
        self.data = path.read_bytes()
        self.name = re.sub(r"[^A-Za-z0-9-]", "", name)
        self.italic = italic
        self.tables = {}
        table_count = struct.unpack_from(">H", self.data, 4)[0]
        for position in range(table_count):
            offset = 12 + position * 16
            tag, _, table_offset, length = struct.unpack_from(
                ">4sIII", self.data, offset
            )
            self.tables[tag.decode("ascii")] = (table_offset, length)
        head = self.table("head")
        hhea = self.table("hhea")
        maxp = self.table("maxp")
        self.units = struct.unpack_from(">H", head, 18)[0]
        self.bbox = struct.unpack_from(">hhhh", head, 36)
        self.ascent, self.descent = struct.unpack_from(">hh", hhea, 4)
        self.metric_count = struct.unpack_from(">H", hhea, 34)[0]
        self.glyph_count = struct.unpack_from(">H", maxp, 4)[0]
        hmtx = self.table("hmtx")
        self.widths = [
            struct.unpack_from(">H", hmtx, position * 4)[0]
            for position in range(self.metric_count)
        ]
        if self.metric_count < self.glyph_count:
            self.widths.extend(
                [self.widths[-1]] * (self.glyph_count - self.metric_count)
            )
        self.cmap_format, self.cmap = self.read_cmap()
        self.used = {}

    def table(self, name):
        offset, length = self.tables[name]
        return memoryview(self.data)[offset : offset + length]

    def read_cmap(self):
        cmap = self.table("cmap")
        count = struct.unpack_from(">H", cmap, 2)[0]
        candidates = []
        for position in range(count):
            platform, encoding, offset = struct.unpack_from(">HHI", cmap, 4 + position * 8)
            format_number = struct.unpack_from(">H", cmap, offset)[0]
            score = (
                4
                if format_number == 12 and platform == 3 and encoding == 10
                else 3
                if format_number == 12
                else 2
                if format_number == 4 and platform == 3
                else 1
                if format_number == 4
                else 0
            )
            if score:
                candidates.append((score, format_number, cmap[offset:]))
        if not candidates:
            raise ValueError(f"font has no Unicode cmap: {self.name}")
        _, format_number, selected = max(candidates, key=lambda item: item[0])
        if format_number == 12:
            group_count = struct.unpack_from(">I", selected, 12)[0]
            groups = [
                struct.unpack_from(">III", selected, 16 + position * 12)
                for position in range(group_count)
            ]
            return 12, groups
        segment_count = struct.unpack_from(">H", selected, 6)[0] // 2
        end_offset = 14
        start_offset = end_offset + segment_count * 2 + 2
        delta_offset = start_offset + segment_count * 2
        range_offset = delta_offset + segment_count * 2
        segments = []
        for position in range(segment_count):
            end = struct.unpack_from(">H", selected, end_offset + position * 2)[0]
            start = struct.unpack_from(">H", selected, start_offset + position * 2)[0]
            delta = struct.unpack_from(">h", selected, delta_offset + position * 2)[0]
            range_value_offset = range_offset + position * 2
            range_value = struct.unpack_from(">H", selected, range_value_offset)[0]
            segments.append(
                (start, end, delta, range_value, range_value_offset, selected)
            )
        return 4, segments

    def glyph(self, codepoint):
        if self.cmap_format == 12:
            low = 0
            high = len(self.cmap)
            while low < high:
                middle = (low + high) // 2
                start, end, first = self.cmap[middle]
                if codepoint < start:
                    high = middle
                elif codepoint > end:
                    low = middle + 1
                else:
                    return first + codepoint - start
            return 0
        if codepoint > 0xFFFF:
            return 0
        for start, end, delta, range_value, range_offset, selected in self.cmap:
            if not start <= codepoint <= end:
                continue
            if range_value == 0:
                return (codepoint + delta) & 0xFFFF
            glyph_offset = range_offset + range_value + 2 * (codepoint - start)
            if glyph_offset + 2 > len(selected):
                return 0
            glyph = struct.unpack_from(">H", selected, glyph_offset)[0]
            return (glyph + delta) & 0xFFFF if glyph else 0
        return 0

    def width(self, text, size):
        total = sum(self.widths[self.glyph(ord(character))] for character in text)
        return total * size / self.units

    def encode(self, text):
        encoded = bytearray()
        for character in text:
            codepoint = ord(character)
            glyph = self.glyph(codepoint)
            if glyph == 0 and character != "\0":
                glyph = self.glyph(ord("?"))
            self.used.setdefault(glyph, codepoint)
            encoded.extend(struct.pack(">H", glyph))
        return encoded.hex().upper()

    def scaled(self, value):
        return round(value * 1000 / self.units)

    def pdf_objects(self, document):
        font_file = document.stream(
            {"Length1": len(self.data)}, self.data, compress=True
        )
        descriptor = document.add(
            (
                f"<< /Type /FontDescriptor /FontName /{self.name} "
                f"/Flags {98 if self.italic else 34} /FontBBox "
                f"[{' '.join(str(self.scaled(value)) for value in self.bbox)}] "
                f"/ItalicAngle {-12 if self.italic else 0} /Ascent {self.scaled(self.ascent)} "
                f"/Descent {self.scaled(self.descent)} /CapHeight {self.scaled(self.ascent)} "
                f"/StemV 80 /FontFile2 {font_file} 0 R >>"
            ).encode()
        )
        widths = " ".join(
            f"{glyph} [{self.scaled(self.widths[glyph])}]"
            for glyph in sorted(self.used)
        )
        descendant = document.add(
            (
                f"<< /Type /Font /Subtype /CIDFontType2 /BaseFont /{self.name} "
                "/CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> "
                f"/FontDescriptor {descriptor} 0 R /DW 1000 /W [{widths}] "
                "/CIDToGIDMap /Identity >>"
            ).encode()
        )
        mappings = [
            f"<{glyph:04X}> <{chr(codepoint).encode('utf-16-be').hex().upper()}>"
            for glyph, codepoint in sorted(self.used.items())
        ]
        cmap_lines = [
            "/CIDInit /ProcSet findresource begin",
            "12 dict begin",
            "begincmap",
            "/CIDSystemInfo << /Registry (Adobe) /Ordering (UCS) /Supplement 0 >> def",
            f"/CMapName /{self.name}-UCS def",
            "/CMapType 2 def",
            "1 begincodespacerange",
            "<0000> <FFFF>",
            "endcodespacerange",
        ]
        for position in range(0, len(mappings), 100):
            group = mappings[position : position + 100]
            cmap_lines.extend([f"{len(group)} beginbfchar", *group, "endbfchar"])
        cmap_lines.extend(
            ["endcmap", "CMapName currentdict /CMap defineresource pop", "end", "end"]
        )
        to_unicode = document.stream({}, "\n".join(cmap_lines).encode(), compress=True)
        return document.add(
            (
                f"<< /Type /Font /Subtype /Type0 /BaseFont /{self.name} "
                f"/Encoding /Identity-H /DescendantFonts [{descendant} 0 R] "
                f"/ToUnicode {to_unicode} 0 R >>"
            ).encode()
        )


class PdfDocument:
    def __init__(self):
        self.objects = [None]

    def reserve(self):
        self.objects.append(None)
        return len(self.objects) - 1

    def set(self, identifier, value):
        self.objects[identifier] = value

    def add(self, value):
        identifier = self.reserve()
        self.set(identifier, value)
        return identifier

    def stream(self, attributes, data, compress=False):
        if compress:
            data = zlib.compress(data, 9)
            attributes = {**attributes, "Filter": "/FlateDecode"}
        entries = " ".join(
            f"/{key} {value if isinstance(value, str) and value.startswith('/') else value}"
            for key, value in attributes.items()
        )
        header = f"<< {entries} /Length {len(data)} >>\nstream\n".encode()
        return self.add(header + data + b"\nendstream")

    def build(self, root):
        output = bytearray(b"%PDF-1.7\n%\xe2\xe3\xcf\xd3\n")
        offsets = [0]
        for identifier, value in enumerate(self.objects[1:], 1):
            if value is None:
                raise ValueError(f"unresolved PDF object {identifier}")
            offsets.append(len(output))
            output.extend(f"{identifier} 0 obj\n".encode())
            output.extend(value)
            output.extend(b"\nendobj\n")
        xref = len(output)
        output.extend(f"xref\n0 {len(self.objects)}\n".encode())
        output.extend(b"0000000000 65535 f \n")
        for offset in offsets[1:]:
            output.extend(f"{offset:010d} 00000 n \n".encode())
        output.extend(
            (
                f"trailer\n<< /Size {len(self.objects)} /Root {root} 0 R >>\n"
                f"startxref\n{xref}\n%%EOF\n"
            ).encode()
        )
        return bytes(output)


@dataclass
class HtmlNode:
    tag: str
    attrs: dict
    children: list = field(default_factory=list)


class ReportHtmlParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.root = HtmlNode("document", {})
        self.stack = [self.root]

    def handle_starttag(self, tag, attrs):
        node = HtmlNode(tag, dict(attrs))
        self.stack[-1].children.append(node)
        if tag not in {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "wbr"}:
            self.stack.append(node)

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        if self.stack[-1].tag == tag:
            self.stack.pop()

    def handle_endtag(self, tag):
        for position in range(len(self.stack) - 1, 0, -1):
            if self.stack[position].tag == tag:
                del self.stack[position:]
                return

    def handle_data(self, data):
        self.stack[-1].children.append(data)


class PdfImage:
    def __init__(self, path):
        self.path = path
        data = path.read_bytes()
        if data.startswith(b"\x89PNG\r\n\x1a\n"):
            self.read_png(data)
        elif data.startswith(b"\xff\xd8"):
            self.read_jpeg(data)
        else:
            raise ValueError(f"native PDF figures require PNG or JPEG: {path.name}")

    def read_png(self, data):
        position = 8
        chunks = {}
        while position + 12 <= len(data):
            length = struct.unpack_from(">I", data, position)[0]
            kind = data[position + 4 : position + 8]
            value = data[position + 8 : position + 8 + length]
            chunks.setdefault(kind, []).append(value)
            position += length + 12
            if kind == b"IEND":
                break
        header = chunks.get(b"IHDR", [b""])[0]
        if len(header) != 13:
            raise ValueError(f"invalid PNG header: {self.path.name}")
        self.width, self.height, depth, colour_type, compression, filtering, interlace = struct.unpack(
            ">IIBBBBB", header
        )
        if depth != 8 or compression != 0 or filtering != 0 or interlace != 0:
            raise ValueError(
                f"native PDF supports non-interlaced 8-bit PNG figures: {self.path.name}"
            )
        channels = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}.get(colour_type)
        if not channels:
            raise ValueError(f"unsupported PNG colour type: {self.path.name}")
        compressed = b"".join(chunks.get(b"IDAT", []))
        decoded = zlib.decompress(compressed)
        stride = self.width * channels
        rows = []
        previous = bytearray(stride)
        offset = 0
        for _ in range(self.height):
            filter_type = decoded[offset]
            source = decoded[offset + 1 : offset + 1 + stride]
            offset += stride + 1
            row = bytearray(stride)
            for column, value in enumerate(source):
                left = row[column - channels] if column >= channels else 0
                above = previous[column]
                upper_left = previous[column - channels] if column >= channels else 0
                if filter_type == 0:
                    result = value
                elif filter_type == 1:
                    result = value + left
                elif filter_type == 2:
                    result = value + above
                elif filter_type == 3:
                    result = value + ((left + above) // 2)
                elif filter_type == 4:
                    prediction = left + above - upper_left
                    distances = (
                        abs(prediction - left),
                        abs(prediction - above),
                        abs(prediction - upper_left),
                    )
                    predictor = (left, above, upper_left)[distances.index(min(distances))]
                    result = value + predictor
                else:
                    raise ValueError(f"invalid PNG row filter: {self.path.name}")
                row[column] = result & 0xFF
            rows.append(row)
            previous = row
        palette = b"".join(chunks.get(b"PLTE", []))
        transparency = b"".join(chunks.get(b"tRNS", []))
        rgb = bytearray()
        alpha = bytearray()
        for row in rows:
            for column in range(self.width):
                start = column * channels
                if colour_type == 0:
                    value = row[start]
                    rgb.extend((value, value, value))
                elif colour_type == 2:
                    rgb.extend(row[start : start + 3])
                elif colour_type == 3:
                    index = row[start]
                    palette_start = index * 3
                    if palette_start + 3 > len(palette):
                        raise ValueError(f"invalid PNG palette: {self.path.name}")
                    rgb.extend(palette[palette_start : palette_start + 3])
                    alpha.append(transparency[index] if index < len(transparency) else 255)
                elif colour_type == 4:
                    value = row[start]
                    rgb.extend((value, value, value))
                    alpha.append(row[start + 1])
                else:
                    rgb.extend(row[start : start + 3])
                    alpha.append(row[start + 3])
        self.colour_space = "/DeviceRGB"
        self.bits = 8
        self.data = bytes(rgb)
        self.alpha = bytes(alpha) if alpha and any(value != 255 for value in alpha) else b""
        self.filter = "/FlateDecode"

    def read_jpeg(self, data):
        position = 2
        width = height = components = 0
        while position + 4 <= len(data):
            if data[position] != 0xFF:
                position += 1
                continue
            marker = data[position + 1]
            position += 2
            if marker in {0xD8, 0xD9}:
                continue
            length = struct.unpack_from(">H", data, position)[0]
            if marker in {0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF}:
                _, height, width, components = struct.unpack_from(">BHHB", data, position + 2)
                break
            position += length
        if not width or not height:
            raise ValueError(f"invalid JPEG dimensions: {self.path.name}")
        self.width = width
        self.height = height
        self.colour_space = "/DeviceGray" if components == 1 else "/DeviceRGB"
        self.bits = 8
        self.data = data
        self.alpha = b""
        self.filter = "/DCTDecode"

    def pdf_object(self, document):
        alpha_object = 0
        if self.alpha:
            alpha_object = document.stream(
                {
                    "Type": "/XObject",
                    "Subtype": "/Image",
                    "Width": self.width,
                    "Height": self.height,
                    "ColorSpace": "/DeviceGray",
                    "BitsPerComponent": 8,
                },
                self.alpha,
                compress=True,
            )
        attributes = {
            "Type": "/XObject",
            "Subtype": "/Image",
            "Width": self.width,
            "Height": self.height,
            "ColorSpace": self.colour_space,
            "BitsPerComponent": self.bits,
        }
        if alpha_object:
            attributes["SMask"] = f"{alpha_object} 0 R"
        return document.stream(
            attributes,
            self.data,
            compress=self.filter == "/FlateDecode",
        ) if self.filter == "/FlateDecode" else document.stream(
            {**attributes, "Filter": self.filter}, self.data
        )


class NativePdfRenderer:
    width = 595.276
    height = 841.89

    def __init__(self, project):
        self.project = project
        self.settings = presentation_settings(project.metadata)
        self.base_size = self.settings["font_size_pt"]
        points_per_mm = 72 / 25.4
        margins = self.settings["margins_mm"]
        self.margin_top = margins["top"] * points_per_mm
        self.margin_right = margins["right"] * points_per_mm
        self.margin_bottom = margins["bottom"] * points_per_mm
        self.margin_left = margins["left"] * points_per_mm
        self.column_count = self.settings["columns"]
        self.column_gap = self.settings["column_gap_mm"] * points_per_mm
        self.column = 0
        self.in_cover = False
        self.full_width = False
        self.fonts = self.load_fonts()
        self.images = {}
        self.pages = []
        self.destinations = {}
        self.new_page()

    def font_path(self, filename):
        configured = os.environ.get("REPORT_BUILD_FONT_DIR")
        roots = [
            *([Path(configured)] if configured else []),
            Path("/usr/share/fonts"),
            Path("/usr/local/share/fonts"),
            Path.home() / ".local/share/fonts",
        ]
        for root in roots:
            if not root.is_dir():
                continue
            match = next(root.rglob(filename), None)
            if match:
                return match
        fail(
            f"native PDF output requires {filename}; run "
            "scripts/install-report-fonts.sh or set REPORT_BUILD_FONT_DIR",
            2,
        )

    def load_fonts(self):
        definitions = {
            "regular": (
                "cmunrm.ttf",
                "CMUSerif-Roman",
                False,
            ),
            "bold": (
                "cmunbx.ttf",
                "CMUSerif-Bold",
                False,
            ),
            "italic": (
                "cmunti.ttf",
                "CMUSerif-Italic",
                True,
            ),
            "bolditalic": (
                "cmunbi.ttf",
                "CMUSerif-BoldItalic",
                True,
            ),
        }
        return {
            style: TrueTypeFont(self.font_path(filename), name, italic)
            for style, (filename, name, italic) in definitions.items()
        }

    def new_page(self):
        self.pages.append(
            {
                "commands": [],
                "links": [],
                "images": [],
                "lines": [],
                "numbered": True,
            }
        )
        self.page = len(self.pages) - 1
        self.column = 0
        self.y = self.height - self.margin_top

    def page_number_command(self, page_number):
        text = str(page_number)
        size = max(9, self.base_size - 2)
        x = (self.width - self.measure(text, "regular", size)) / 2
        return ("regular", size, x, self.margin_bottom / 2, text, (0, 0, 0))

    def active_column_count(self):
        return 1 if self.in_cover or self.full_width else self.column_count

    def content_width(self):
        width = self.width - self.margin_left - self.margin_right
        columns = self.active_column_count()
        return (width - self.column_gap * (columns - 1)) / columns

    def content_left(self):
        return self.margin_left + self.column * (self.content_width() + self.column_gap)

    def page_break(self):
        if self.pages[self.page]["commands"]:
            self.new_page()

    def ensure_space(self, height):
        if self.y - height >= self.margin_bottom:
            return
        if not self.in_cover and self.column < self.column_count - 1:
            self.column += 1
            self.y = self.height - self.margin_top
            return
        self.new_page()

    def measure(self, text, style, size):
        return self.fonts[style].width(text, size)

    def add_command(self, text, style, size, x, colour, link=None):
        if not text:
            return
        width = self.measure(text, style, size)
        self.pages[self.page]["commands"].append(
            (style, size, x, self.y, text, colour)
        )
        if link and text.strip():
            self.pages[self.page]["links"].append(
                (x, self.y - size * 0.22, x + width, self.y + size, link)
            )

    def compact_spans(self, spans):
        compact = []
        for span in spans:
            text = re.sub(r"\s+", " ", span["text"])
            if not text:
                continue
            value = {**span, "text": text}
            if compact and all(
                compact[-1].get(key) == value.get(key)
                for key in ("style", "link")
            ):
                compact[-1]["text"] += text
            else:
                compact.append(value)
        return compact

    def span_units(self, spans):
        units = []
        for span in self.compact_spans(spans):
            for value in re.findall(r"\s+|\S+", span["text"]):
                if value.isspace():
                    if units and not units[-1]["text"].endswith(" "):
                        units[-1]["text"] += " "
                    continue
                units.append({**span, "text": value})
        return units

    def append_line_span(self, line, span):
        if line and all(
            line[-1].get(key) == span.get(key) for key in ("style", "link")
        ):
            line[-1]["text"] += span["text"]
        else:
            line.append(dict(span))

    def wrapped_lines(self, spans, size, first_width, later_width):
        lines = []
        line = []
        line_width = 0
        limit = first_width
        for unit in self.span_units(spans):
            value = unit["text"]
            unit_width = self.measure(value, unit["style"], size)
            if line and line_width + unit_width > limit:
                if value[0] in ".,;:!?)]}":
                    self.append_line_span(line, unit)
                    line_width += unit_width
                    continue
                carry = []
                if line[-1]["text"].endswith(("(", "[", "{", "“")):
                    opener = line[-1]["text"][-1]
                    carry.append({**line[-1], "text": opener})
                    line[-1]["text"] = line[-1]["text"][:-1].rstrip()
                    if not line[-1]["text"]:
                        line.pop()
                lines.append(line)
                line = carry
                line_width = sum(
                    self.measure(span["text"], span["style"], size)
                    for span in line
                )
                limit = later_width
            if unit_width <= limit:
                self.append_line_span(line, unit)
                line_width += unit_width
                continue
            for character in value:
                character_width = self.measure(character, unit["style"], size)
                if line and line_width + character_width > limit:
                    line[-1]["text"] = line[-1]["text"].rstrip()
                    lines.append(line)
                    line = []
                    line_width = 0
                    limit = later_width
                self.append_line_span(line, {**unit, "text": character})
                line_width += character_width
        if line:
            line[-1]["text"] = line[-1]["text"].rstrip()
            lines.append(line)
        return lines

    def write_spans(
        self,
        spans,
        size=None,
        left=0,
        right=0,
        hanging=0,
        before=0,
        after=None,
        colour=(0, 0, 0),
        destination=None,
        justify=False,
        align="left",
    ):
        size = size or self.base_size
        after = (
            self.settings["paragraph_spacing_pt"] if after is None else after
        )
        line_height = size * self.settings["line_height"]
        available = self.content_width() - left - right
        lines = self.wrapped_lines(spans, size, available, available - hanging)
        self.ensure_space(before + line_height)
        self.y -= before
        if destination:
            self.destinations[destination] = (self.page, self.y + size)
        for position, line in enumerate(lines):
            self.ensure_space(line_height)
            indent = hanging if position else 0
            x = self.content_left() + left + indent
            target_width = available - indent
            line_width = sum(
                self.measure(span["text"], span["style"], size) for span in line
            )
            if align == "center":
                x += max(0, target_width - line_width) / 2
            elif align == "right":
                x += max(0, target_width - line_width)
            spaces = sum(span["text"].count(" ") for span in line)
            extra_space = (
                max(0, target_width - line_width) / spaces
                if justify and align == "left" and position < len(lines) - 1 and spaces
                else 0
            )
            for span in line:
                fragments = (
                    re.findall(r" +|[^ ]+", span["text"])
                    if extra_space
                    else [span["text"]]
                )
                for fragment in fragments:
                    self.add_command(
                        fragment,
                        span["style"],
                        size,
                        x,
                        colour,
                        span.get("link"),
                    )
                    x += self.measure(fragment, span["style"], size)
                    if fragment.isspace():
                        x += extra_space * len(fragment)
            self.y -= line_height
        self.y -= after

    def inline_spans(self, node, style="regular", link=None):
        spans = []
        for child in node.children:
            if isinstance(child, str):
                spans.append({"text": child, "style": style, "link": link})
                continue
            child_style = style
            if child.tag in {"strong", "b"}:
                child_style = "bolditalic" if style == "italic" else "bold"
            elif child.tag in {"em", "i"}:
                child_style = "bolditalic" if style == "bold" else "italic"
            child_link = child.attrs.get("href", link) if child.tag == "a" else link
            if child.tag == "br":
                spans.append({"text": " ", "style": style, "link": link})
            else:
                spans.extend(self.inline_spans(child, child_style, child_link))
        return self.compact_spans(spans)

    def text_content(self, node):
        return "".join(
            child if isinstance(child, str) else self.text_content(child)
            for child in node.children
        ).strip()

    def render_list(self, node, ordered=False):
        items = [child for child in node.children if isinstance(child, HtmlNode) and child.tag == "li"]
        references = bool(items) and all(
            item.attrs.get("id", "").startswith("ref-") for item in items
        )
        for position, item in enumerate(items, 1):
            destination = item.attrs.get("id")
            if references:
                self.write_spans(
                    self.inline_spans(item),
                    hanging=34,
                    destination=destination,
                    after=self.base_size * 0.8,
                )
                continue
            marker = f"{position}. " if ordered else "• "
            spans = [
                {"text": marker, "style": "regular", "link": None},
                *self.inline_spans(item),
            ]
            self.write_spans(spans, left=18, hanging=14, after=self.base_size * 0.3)

    def render_table(self, node):
        rows = []
        for row in self.find_all(node, "tr"):
            cells = [
                self.inline_spans(child)
                for child in row.children
                if isinstance(child, HtmlNode) and child.tag in {"th", "td"}
            ]
            if cells:
                rows.append(cells)
        if not rows:
            return
        column_count = max(len(row) for row in rows)
        table_width = self.content_width()
        gap = 10
        column_width = (table_width - gap * (column_count - 1)) / column_count
        size = max(8, self.base_size - 2)
        line_height = size * 1.35

        def prepare_row(row, header=False):
            cells = [
                self.wrapped_lines(
                    [
                        {
                            **span,
                            "style": "bold" if header else span["style"],
                        }
                        for span in cell
                    ],
                    size,
                    column_width,
                    column_width,
                )
                for cell in row
            ]
            row_height = max((len(cell) for cell in cells), default=1) * line_height + 8
            return cells, row_height

        def draw_row(cells, row_height, header=False):
            top = self.y
            if header:
                self.pages[self.page]["lines"].append(
                    (
                        self.content_left(),
                        top + 3,
                        self.content_left() + table_width,
                        top + 3,
                        0.8,
                    )
                )
            for column, cell in enumerate(cells):
                x_origin = self.content_left() + column * (column_width + gap)
                for line_number, line in enumerate(cell):
                    x = x_origin
                    baseline = top - 3 - size - line_number * line_height
                    previous_y = self.y
                    self.y = baseline
                    for span in line:
                        self.add_command(
                            span["text"],
                            span["style"],
                            size,
                            x,
                            (0, 0, 0),
                            span.get("link"),
                        )
                        x += self.measure(span["text"], span["style"], size)
                    self.y = previous_y
            self.y = top - row_height
            self.pages[self.page]["lines"].append(
                (
                    self.content_left(),
                    self.y + 3,
                    self.content_left() + table_width,
                    self.y + 3,
                    0.8 if header else 0.35,
                )
            )

        prepared_rows = [
            prepare_row(row, header=position == 0)
            for position, row in enumerate(rows)
        ]
        header_cells, header_height = prepared_rows[0]
        self.ensure_space(header_height)
        draw_row(header_cells, header_height, header=True)
        for cells, row_height in prepared_rows[1:]:
            if self.y - row_height < self.margin_bottom:
                self.ensure_space(header_height + row_height)
                draw_row(header_cells, header_height, header=True)
            draw_row(cells, row_height)
        self.y -= self.base_size * 0.7

    def render_image(self, node):
        source = node.attrs.get("src", "")
        relative = source[3:] if source.startswith("../") else source
        path = safe_path(self.project.root, relative)
        if not path.is_file():
            raise ValueError(f"figure does not exist: {relative}")
        key = str(path)
        if key not in self.images:
            self.images[key] = PdfImage(path)
        image = self.images[key]
        style = node.attrs.get("style", "")
        width_match = re.search(r"max-width:\s*([0-9.]+)%", style)
        fraction = float(width_match.group(1)) / 100 if width_match else 1
        available_width = self.content_width() * min(1, fraction)
        rendered_width = available_width
        rendered_height = rendered_width * image.height / image.width
        maximum_height = self.height - self.margin_top - self.margin_bottom
        if rendered_height > maximum_height:
            scale = maximum_height / rendered_height
            rendered_width *= scale
            rendered_height *= scale
        self.ensure_space(rendered_height + self.base_size)
        x = self.content_left() + (self.content_width() - rendered_width) / 2
        bottom = self.y - rendered_height
        self.pages[self.page]["images"].append(
            (key, x, bottom, rendered_width, rendered_height)
        )
        self.y = bottom - self.base_size * 1.3

    def find_all(self, node, tag):
        found = []
        for child in node.children:
            if not isinstance(child, HtmlNode):
                continue
            if child.tag == tag:
                found.append(child)
            found.extend(self.find_all(child, tag))
        return found

    def render_node(self, node):
        if isinstance(node, str):
            return
        classes = node.attrs.get("class", "").split()
        if node.tag == "section" and "cover-page" in classes:
            if self.pages[self.page]["commands"]:
                self.new_page()
            self.pages[self.page]["numbered"] = False
            self.in_cover = True
            title_margin = self.settings["title"]["top_margin_mm"] * 72 / 25.4
            self.y = self.height - self.margin_top - title_margin
            for child in node.children:
                self.render_node(child)
            self.in_cover = False
            self.new_page()
            return
        if node.tag == "section" and "references" in classes:
            self.page_break()
            self.full_width = True
            self.column = 0
            for child in node.children:
                self.render_node(child)
            self.full_width = False
            return
        if node.tag == "section" and "page-break" in classes:
            self.page_break()
        if node.tag in {"h1", "h2", "h3", "h4", "h5", "h6"}:
            level = int(node.tag[1])
            if "cover-title" in classes:
                size = self.settings["title"]["size_pt"]
                before = 0
                after = self.base_size * 1.2
                align = self.settings["title"]["alignment"]
            elif "cover-label" in classes:
                size = self.base_size
                before = (
                    self.base_size * 6
                    if "cover-author-label" in classes
                    else self.base_size * 1.4
                )
                after = self.base_size * 0.4
                align = "center"
            else:
                size = {
                    1: self.settings["title"]["size_pt"],
                    2: self.base_size * 1.36,
                    3: self.base_size * 1.18,
                    4: self.base_size * 1.09,
                }.get(level, self.base_size)
                before = self.settings["heading_spacing_pt"]["before"]
                after = self.settings["heading_spacing_pt"]["after"]
                align = "left"
            self.write_spans(
                self.inline_spans(node, "bold"),
                size=size,
                before=before,
                after=after,
                colour=(0, 0, 0),
                destination=node.attrs.get("id"),
                align=align,
            )
            return
        if node.tag == "p":
            cover_text = bool(
                {"cover-subtitle", "cover-assessment", "cover-detail", "cover-date"}
                & set(classes)
            )
            self.write_spans(
                self.inline_spans(node),
                justify=not cover_text
                and not ({"subtitle", "byline"} & set(classes)),
                align="center" if cover_text else "left",
                after=(
                    self.base_size * 0.35
                    if cover_text
                    else self.settings["paragraph_spacing_pt"]
                ),
            )
            return
        if node.tag in {"ol", "ul"}:
            self.render_list(node, node.tag == "ol")
            return
        if node.tag == "blockquote":
            self.write_spans(self.inline_spans(node, "italic"), left=22, right=12)
            return
        if node.tag == "pre":
            self.write_spans(
                [{"text": self.text_content(node), "style": "regular", "link": None}],
                size=max(8, self.base_size - 1),
                left=14,
                right=14,
            )
            return
        if node.tag == "table":
            self.render_table(node)
            return
        if node.tag == "figcaption":
            self.write_spans(
                self.inline_spans(node, "italic"),
                size=max(8, self.base_size - 1),
                left=18,
                right=18,
                before=self.settings["caption_spacing_pt"]["before"],
                after=self.settings["caption_spacing_pt"]["after"],
            )
            return
        if node.tag == "img":
            self.render_image(node)
            return
        for child in node.children:
            self.render_node(child)

    def render(self, source):
        parser = ReportHtmlParser()
        parser.feed(source)
        body = next(
            (node for node in self.find_all(parser.root, "body")), parser.root
        )
        self.render_node(body)

    def pdf(self):
        document = PdfDocument()
        catalog = document.reserve()
        pages_object = document.reserve()
        page_objects = [document.reserve() for _ in self.pages]
        displayed_page_number = 0
        for page in self.pages:
            for style, _, _, _, text, _ in page["commands"]:
                self.fonts[style].encode(text)
            if page["numbered"]:
                displayed_page_number += 1
                self.fonts["regular"].encode(str(displayed_page_number))
        font_objects = {
            style: font.pdf_objects(document) for style, font in self.fonts.items()
        }
        image_objects = {
            key: image.pdf_object(document) for key, image in self.images.items()
        }
        image_names = {
            key: f"Im{position}"
            for position, key in enumerate(sorted(self.images), 1)
        }
        resource_names = {
            "regular": "F1",
            "bold": "F2",
            "italic": "F3",
            "bolditalic": "F4",
        }
        font_resources = " ".join(
            f"/{resource_names[style]} {identifier} 0 R"
            for style, identifier in font_objects.items()
        )
        displayed_page_number = 0
        for page_index, page in enumerate(self.pages):
            commands = []
            page_commands = list(page["commands"])
            if page["numbered"]:
                displayed_page_number += 1
                page_commands.append(self.page_number_command(displayed_page_number))
            for style, size, x, y, text, colour in page_commands:
                red, green, blue = colour
                encoded = self.fonts[style].encode(text)
                commands.append(
                    f"BT /{resource_names[style]} {size:g} Tf {red:g} {green:g} {blue:g} rg 1 0 0 1 {x:.3f} {y:.3f} Tm <{encoded}> Tj ET"
                )
            for key, x, y, width, height in page["images"]:
                commands.append(
                    f"q {width:.3f} 0 0 {height:.3f} {x:.3f} {y:.3f} cm /{image_names[key]} Do Q"
                )
            for left, bottom, right, top, thickness in page["lines"]:
                commands.append(
                    f"q 0 0 0 RG {thickness:.3f} w {left:.3f} {bottom:.3f} m {right:.3f} {top:.3f} l S Q"
                )
            content = document.stream({}, "\n".join(commands).encode(), compress=True)
            annotations = []
            for left, bottom, right, top, target in page["links"]:
                rectangle = f"[{left:.3f} {bottom:.3f} {right:.3f} {top:.3f}]"
                if target.startswith("#") and target[1:] in self.destinations:
                    destination_page, destination_y = self.destinations[target[1:]]
                    action = f"/Dest [{page_objects[destination_page]} 0 R /XYZ null {destination_y:.3f} null]"
                elif target.startswith(("http://", "https://")):
                    escaped = target.replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)")
                    action = f"/A << /S /URI /URI ({escaped}) >>"
                else:
                    continue
                annotations.append(
                    document.add(
                        f"<< /Type /Annot /Subtype /Link /Rect {rectangle} /Border [0 0 0] {action} >>".encode()
                    )
                )
            annotation_value = (
                f"/Annots [{' '.join(f'{identifier} 0 R' for identifier in annotations)}]"
                if annotations
                else ""
            )
            page_images = " ".join(
                f"/{image_names[key]} {image_objects[key]} 0 R"
                for key, *_ in page["images"]
            )
            image_resources = f"/XObject << {page_images} >>" if page_images else ""
            document.set(
                page_objects[page_index],
                (
                    f"<< /Type /Page /Parent {pages_object} 0 R /MediaBox [0 0 {self.width:.3f} {self.height:.3f}] "
                    f"/Resources << /Font << {font_resources} >> {image_resources} >> /Contents {content} 0 R {annotation_value} >>"
                ).encode(),
            )
        document.set(
            pages_object,
            (
                f"<< /Type /Pages /Count {len(page_objects)} /Kids "
                f"[{' '.join(f'{identifier} 0 R' for identifier in page_objects)}] >>"
            ).encode(),
        )
        document.set(catalog, f"<< /Type /Catalog /Pages {pages_object} 0 R >>".encode())
        return document.build(catalog)


def render_pdf(project):
    renderer = NativePdfRenderer(project)
    renderer.render(render_html(project))
    return renderer.pdf()


def serialise_check(project):
    counted_words = sum(
        section.words for section in project.sections if section.count_words
    )
    return {
        "index": str(project.index),
        "title": project.metadata.get("title"),
        "counted_words": counted_words,
        "sections": [
            {
                "path": section.path,
                "words": section.words,
                "count_words": section.count_words,
                "max_words": section.max_words,
            }
            for section in project.sections
        ],
        "citations": sorted(project.citations),
        "references": len(project.references),
        "figures": sum(1 for kind, _ in project.labels.values() if kind == "Figure"),
        "tables": sum(1 for kind, _ in project.labels.values() if kind == "Table"),
        "issues": [issue.__dict__ for issue in project.issues],
    }


def print_check(project):
    result = serialise_check(project)
    print(f"{PURPLE}◇ {result['title']}{RESET}")
    print(f"  words       {result['counted_words']:,}")
    print(f"  sections    {len(result['sections'])}")
    print(
        f"  citations   {len(result['citations'])} keys · {result['references']} records"
    )
    print(f"  floats      {result['figures']} figures · {result['tables']} tables")
    for section in result["sections"]:
        if section["count_words"]:
            limit = f" / {section['max_words']}" if section["max_words"] else ""
            print(f"{PINK}  {section['path']:<32}{RESET} {section['words']}{limit}")
    for issue in project.issues:
        colour = RED if issue.level == "error" else YELLOW
        location = f" [{issue.path}]" if issue.path else ""
        print(f"{colour}  {issue.level}:{RESET} {issue.message}{location}")


def ensure_valid(project, as_json=False):
    if as_json:
        print(json.dumps(serialise_check(project), indent=2, sort_keys=True))
    else:
        print_check(project)
    if any(issue.level == "error" for issue in project.issues):
        raise SystemExit(1)


def write_output(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)


def write_binary_output(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(content)


def command_check(arguments):
    ensure_valid(load_project(arguments.path), arguments.json)


def command_build(arguments):
    project = load_project(arguments.path)
    ensure_valid(project, arguments.json)
    output = safe_path(project.root, arguments.output)
    output.mkdir(parents=True, exist_ok=True)
    requested = (
        {"text", "html", "tex", "pdf"}
        if arguments.format == "all"
        else {arguments.format}
    )
    text_path = output / "report.txt"
    html_path = output / "report.html"
    tex_path = output / "report.tex"
    if "text" in requested:
        write_output(text_path, render_text(project))
    if "html" in requested:
        write_output(html_path, render_html(project))
    if requested & {"tex", "pdf"}:
        write_output(tex_path, render_latex(project))
    if "pdf" in requested:
        write_binary_output(output / "report.pdf", render_pdf(project))
    if not arguments.json:
        for name in ("report.txt", "report.html", "report.tex", "report.pdf"):
            path = output / name
            if path.exists() and name.rsplit(".", 1)[1] in requested:
                print(f"{PINK}  wrote       {path}{RESET}")


def initial_index(
    title, authors, identifiers, roles, institution="", course="", assessment=""
):
    identity_count = max(1, len(authors), len(identifiers), len(roles))
    identity_lines = []
    for position in range(identity_count):
        name = authors[position] if position < len(authors) else ""
        identifier = identifiers[position] if position < len(identifiers) else ""
        role = roles[position] if position < len(roles) else ""
        identity_lines.append(
            f"  - {{name: {json.dumps(name)}, identifier: {json.dumps(identifier)}, "
            f"role: {json.dumps(role)}}}"
        )
    institution_block = ""
    if institution or course:
        institution_block = (
            "institution:\n"
            f"  name: {json.dumps(institution)}\n"
            f"  course: {json.dumps(course)}\n"
            "required_institution_fields: [name, course]\n"
        )
    assessment_line = f"assessment: {json.dumps(assessment)}\n" if assessment else ""
    return f"""---
schema_version: 1
title: {json.dumps(title)}
{assessment_line}cover_page: {{enabled: true}}
{institution_block}language: en-AU
citation_style: apa-7
citation_markup:
  encoding: yaml_flow_mapping
  id_source: {{path: references.md, field: id}}
identities:
{chr(10).join(identity_lines)}
presentation: {{font_size_pt: 12}}
require_verified_references: true
required_identity_fields: [name]
sections:
  - {{id: report, order: 1, path: sections/01-report.md, include_in_submission: true, include_in_word_count: true}}
  - {{id: references, order: 2, path: references.md, include_in_submission: true, include_in_word_count: false, record_encoding: yaml}}
---

# Report source

The YAML frontmatter controls assembly. Keep planning notes below it; only the
listed section files and cited reference records enter the rendered report.
"""


def command_init(arguments):
    root = Path(arguments.path).resolve()
    if root.exists() and any(root.iterdir()):
        fail(f"refusing to initialise non-empty directory: {root}", 2)
    root.mkdir(parents=True, exist_ok=True)
    (root / "sections").mkdir(exist_ok=True)
    (root / "assets").mkdir(exist_ok=True)
    (root / "index.md").write_text(
        initial_index(
            arguments.title,
            arguments.author,
            arguments.identifier,
            arguments.role,
            arguments.institution,
            arguments.course,
            arguments.assessment,
        )
    )
    (root / "sections/01-report.md").write_text(
        "# Introduction\n\nWrite the report here. Use explicit citation keys, labelled figures, and captioned tables when the evidence calls for them.\n"
    )
    (root / "references.md").write_text(
        "---\nschema_version: 1\ncitation_style: apa-7\nrecord_encoding: yaml\n---\n\n# References\n\nAdd one fenced YAML record for each verified source cited by the report.\n"
    )
    print(f"{PURPLE}◇ report source created{RESET}\n  {root}")


def parser():
    root = argparse.ArgumentParser(
        description="Build and validate modular Markdown reports with mapped citations, figures, tables, and print output."
    )
    commands = root.add_subparsers(dest="command", required=True)
    initialise = commands.add_parser("init", help="create a report source tree")
    initialise.add_argument("path")
    initialise.add_argument("--title", required=True)
    initialise.add_argument(
        "--author", action="append", default=[], help="repeat for multiple identities"
    )
    initialise.add_argument(
        "--identifier",
        action="append",
        default=[],
        help="repeat in the same order as --author",
    )
    initialise.add_argument(
        "--role", action="append", default=[], help="optional repeated identity role"
    )
    initialise.add_argument("--institution", default="")
    initialise.add_argument("--course", default="")
    initialise.add_argument("--assessment", default="")
    initialise.set_defaults(handler=command_init)
    check = commands.add_parser(
        "check",
        help="validate structure, references, labels, figures, tables, and word limits",
    )
    check.add_argument("path", nargs="?", default=".")
    check.add_argument("--json", action="store_true")
    check.set_defaults(handler=command_check)
    build = commands.add_parser(
        "build", help="validate and render plain text, HTML, TeX, or PDF"
    )
    build.add_argument("path", nargs="?", default=".")
    build.add_argument(
        "--format", choices=("all", "text", "html", "tex", "pdf"), default="all"
    )
    build.add_argument("--output", default="build")
    build.add_argument("--json", action="store_true")
    build.set_defaults(handler=command_build)
    return root


def main():
    arguments = parser().parse_args()
    arguments.handler(arguments)


if __name__ == "__main__":
    main()
