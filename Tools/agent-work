#!/usr/bin/env python3

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import secrets
import shutil
import sqlite3
import subprocess
import sys
import tempfile
from pathlib import Path

ACTIVE_STATES = ("active", "waiting")
TERMINAL_STATES = ("complete", "failed", "abandoned", "superseded")
PURPLE = "\033[1;35m"
PINK = "\033[38;5;183m"
DIM = "\033[2m"
RESET = "\033[0m"


def fail(message, code=1):
    print(f"\033[1;31merror:\033[0m {message}", file=sys.stderr)
    raise SystemExit(code)


def parse_duration(value):
    match = re.fullmatch(r"([1-9][0-9]*)([smhd]?)", value)
    if not match:
        fail(f"invalid duration {value!r}; use 30m, 2h, or 1d", 2)
    amount = int(match.group(1))
    multiplier = {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]
    return amount * multiplier


def positive_integer(value):
    try:
        number = int(value)
    except ValueError:
        fail(f"invalid positive integer: {value!r}", 2)
    if number < 1:
        fail(f"invalid positive integer: {value!r}", 2)
    return number


def utc_now():
    return dt.datetime.now(dt.UTC)


def iso_time(value):
    return value.isoformat(timespec="seconds").replace("+00:00", "Z")


def state_root():
    override = os.environ.get("AGENT_WORK_STATE_DIR")
    root = (
        Path(override)
        if override
        else Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
        / "agent-work"
    )
    root.mkdir(parents=True, exist_ok=True)
    return root


def database():
    path = state_root() / "tasks.sqlite3"
    connection = sqlite3.connect(path, timeout=10)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA journal_mode=WAL")
    connection.execute("PRAGMA foreign_keys=ON")
    connection.executescript(
        """
        CREATE TABLE IF NOT EXISTS tasks (
            id TEXT PRIMARY KEY,
            repo_id TEXT NOT NULL,
            repo_root TEXT NOT NULL,
            git_common_dir TEXT,
            task TEXT NOT NULL,
            worktree TEXT NOT NULL,
            branch TEXT,
            scratch TEXT NOT NULL,
            pid INTEGER,
            pid_started TEXT,
            started_at TEXT NOT NULL,
            deadline_at TEXT NOT NULL,
            heartbeat_at TEXT NOT NULL,
            status TEXT NOT NULL,
            owner TEXT,
            latest_note TEXT,
            summary TEXT,
            checks_json TEXT NOT NULL DEFAULT '[]',
            changed_json TEXT NOT NULL DEFAULT '[]'
        );
        CREATE TABLE IF NOT EXISTS claims (
            task_id TEXT NOT NULL REFERENCES tasks(id),
            path TEXT NOT NULL,
            PRIMARY KEY (task_id, path)
        );
        CREATE INDEX IF NOT EXISTS claims_path ON claims(path);
        CREATE INDEX IF NOT EXISTS tasks_repo_status ON tasks(repo_id, status);
        """
    )
    columns = {row[1] for row in connection.execute("PRAGMA table_info(tasks)")}
    missing = [name for name in ("owner", "latest_note") if name not in columns]
    if missing:
        timestamp = utc_now().strftime("%Y%m%dT%H%M%S%fZ")
        backup = sqlite3.connect(
            path.with_name(f"tasks.pre-migration-{timestamp}.sqlite3")
        )
        try:
            connection.backup(backup)
        finally:
            backup.close()
        connection.execute("BEGIN IMMEDIATE")
        columns = {row[1] for row in connection.execute("PRAGMA table_info(tasks)")}
        for name in missing:
            if name not in columns:
                connection.execute(f"ALTER TABLE tasks ADD COLUMN {name} TEXT")
        connection.commit()
    connection.execute(
        """
        CREATE TABLE IF NOT EXISTS task_events (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            task_id TEXT NOT NULL REFERENCES tasks(id),
            occurred_at TEXT NOT NULL,
            kind TEXT NOT NULL,
            actor TEXT,
            status TEXT,
            note TEXT,
            details_json TEXT NOT NULL DEFAULT '{}'
        )
        """
    )
    connection.execute(
        "CREATE INDEX IF NOT EXISTS task_events_task_time "
        "ON task_events(task_id, occurred_at, id)"
    )
    connection.commit()
    return connection


def git_value(cwd, *arguments):
    result = subprocess.run(
        ["git", "-C", str(cwd), *arguments],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def repository(cwd):
    worktree = Path(cwd).resolve()
    root_value = git_value(worktree, "rev-parse", "--show-toplevel")
    if root_value:
        root = Path(root_value).resolve()
        common_value = git_value(root, "rev-parse", "--git-common-dir")
        common = (root / common_value).resolve() if common_value else None
        identity = str(common or root)
        branch = git_value(root, "branch", "--show-current") or None
    else:
        root = worktree
        common = None
        identity = str(root)
        branch = None
    repo_id = hashlib.sha256(identity.encode()).hexdigest()[:12]
    return root, common, repo_id, branch


def normalize_claim(root, value):
    path = Path(value)
    absolute = path.resolve() if path.is_absolute() else (root / path).resolve()
    try:
        relative = absolute.relative_to(root)
        normalized = relative.as_posix() or "."
    except ValueError:
        normalized = absolute.as_posix()
    return normalized.rstrip("/") or "."


def claims_overlap(first, second):
    if first == "." or second == ".":
        return True
    return (
        first == second
        or first.startswith(second + "/")
        or second.startswith(first + "/")
    )


def process_started(pid):
    if not pid:
        return None
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()
        return fields[19]
    except (FileNotFoundError, PermissionError, IndexError):
        return None


def process_alive(row):
    if not row["pid"] or not row["pid_started"]:
        return None
    return process_started(row["pid"]) == row["pid_started"]


def slug(value):
    clean = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return clean[:24] or "task"


def task_record(connection, task_id):
    row = connection.execute("SELECT * FROM tasks WHERE id = ?", (task_id,)).fetchone()
    if not row:
        fail(f"unknown task: {task_id}", 2)
    return row


def task_id_from(arguments):
    positional = getattr(arguments, "task_id", None)
    option = getattr(arguments, "task_option", None)
    if positional and option and positional != option:
        fail("task ID was supplied twice with different values", 2)
    task_id = positional or option or os.environ.get("AGENT_WORK_ID")
    if not task_id:
        fail("task ID is required; pass TASK_ID or --task TASK_ID", 2)
    return task_id


def claims_by_task(connection, task_ids):
    claims = {task_id: [] for task_id in task_ids}
    if not task_ids:
        return claims
    placeholders = ",".join("?" for _ in task_ids)
    for row in connection.execute(
        f"SELECT task_id, path FROM claims WHERE task_id IN ({placeholders}) "
        "ORDER BY task_id, path",
        task_ids,
    ):
        claims[row["task_id"]].append(row["path"])
    return claims


def append_event(
    connection,
    task_id,
    kind,
    occurred_at,
    *,
    actor=None,
    status=None,
    note=None,
    details=None,
):
    connection.execute(
        """
        INSERT INTO task_events (
            task_id, occurred_at, kind, actor, status, note, details_json
        ) VALUES (?, ?, ?, ?, ?, ?, ?)
        """,
        (
            task_id,
            occurred_at,
            kind,
            actor,
            status,
            note,
            json.dumps(details or {}, sort_keys=True),
        ),
    )


def serialize_task(connection, row, claims=None):
    now = utc_now()
    deadline = dt.datetime.fromisoformat(row["deadline_at"].replace("Z", "+00:00"))
    return {
        "id": row["id"],
        "task": row["task"],
        "status": row["status"],
        "repo_id": row["repo_id"],
        "repo_root": row["repo_root"],
        "worktree": row["worktree"],
        "branch": row["branch"],
        "scratch": row["scratch"],
        "claims": claims
        if claims is not None
        else claims_by_task(connection, [row["id"]])[row["id"]],
        "owner": row["owner"],
        "latest_note": row["latest_note"],
        "pid": row["pid"],
        "process_alive": process_alive(row),
        "started_at": row["started_at"],
        "deadline_at": row["deadline_at"],
        "heartbeat_at": row["heartbeat_at"],
        "seconds_remaining": int((deadline - now).total_seconds()),
        "summary": row["summary"],
        "checks": json.loads(row["checks_json"]),
        "changed": json.loads(row["changed_json"]),
    }


def serialize_tasks(connection, rows):
    claims = claims_by_task(connection, [row["id"] for row in rows])
    return [serialize_task(connection, row, claims[row["id"]]) for row in rows]


def serialize_event(row):
    return {
        "id": row["id"],
        "task_id": row["task_id"],
        "occurred_at": row["occurred_at"],
        "kind": row["kind"],
        "actor": row["actor"],
        "status": row["status"],
        "note": row["note"],
        "details": json.loads(row["details_json"]),
    }


def emit(value, as_json):
    if as_json:
        print(json.dumps(value, indent=2, sort_keys=True))
        return
    if isinstance(value, list):
        emit_table(value)
        return
    remaining = value["seconds_remaining"]
    left = human_duration(abs(remaining))
    left = f"{left} left" if remaining >= 0 else f"{left} late"
    print(f"{PURPLE}◇ {value['id']}{RESET}  {value['status']} · {left}")
    print(f"  {value['task']}")
    print(f"  worktree  {value['worktree']}")
    print(f"  scope     {', '.join(value['claims'])}")
    print(f"  scratch   {value['scratch']}")
    if value["owner"]:
        print(f"  owner     {value['owner']}")
    if value["latest_note"]:
        print(f"  note      {value['latest_note']}")
    if value["summary"]:
        print(f"  summary   {value['summary']}")


def human_duration(seconds):
    seconds = max(0, int(seconds))
    if seconds >= 86400:
        return f"{seconds // 86400}d"
    if seconds >= 3600:
        return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}m"
    return f"{seconds // 60}m"


def emit_table(tasks):
    if not tasks:
        print(f"{PINK}♡ No matching agent tasks.{RESET}")
        return
    print(
        f"{PURPLE}{'TASK':<31} {'STATE':<10} {'LEFT':>8}  "
        f"{'OWNER':<18} {'SCOPE'}{RESET}"
    )
    for task in tasks:
        remaining = task["seconds_remaining"]
        left = human_duration(abs(remaining))
        if remaining < 0:
            left = f"-{left}"
        scope = ", ".join(task["claims"])
        owner = task["owner"] or "-"
        print(f"{task['id']:<31} {task['status']:<10} {left:>8}  {owner:<18} {scope}")
        if task["latest_note"]:
            print(f"  ↳ {task['latest_note']}")


def find_conflicts(connection, repo_id, claims, exclude_task=None):
    placeholders = ",".join("?" for _ in ACTIVE_STATES)
    parameters = [repo_id, *ACTIVE_STATES]
    query = f"""
        SELECT t.id, t.task, c.path
        FROM tasks t JOIN claims c ON c.task_id = t.id
        WHERE t.repo_id = ? AND t.status IN ({placeholders})
    """
    if exclude_task:
        query += " AND t.id != ?"
        parameters.append(exclude_task)
    conflicts = []
    for row in connection.execute(query, parameters):
        for claim in claims:
            if claims_overlap(claim, row["path"]):
                conflicts.append(
                    {
                        "task_id": row["id"],
                        "task": row["task"],
                        "existing": row["path"],
                        "requested": claim,
                    }
                )
    return conflicts


def board_repo_id(arguments):
    if arguments.all_repos:
        return None
    return repository(arguments.repo or os.getcwd())[2]


def board_rows(connection, arguments, states, *, bounded=True):
    clauses = [f"status IN ({','.join('?' for _ in states)})"]
    parameters = list(states)
    repo_id = board_repo_id(arguments)
    if repo_id:
        clauses.append("repo_id = ?")
        parameters.append(repo_id)
    if arguments.since:
        cutoff = utc_now() - dt.timedelta(seconds=parse_duration(arguments.since))
        clauses.append("started_at >= ?")
        parameters.append(iso_time(cutoff))
    limit = ""
    if bounded:
        limit = " LIMIT ?"
        parameters.append(arguments.limit)
    return connection.execute(
        f"SELECT * FROM tasks WHERE {' AND '.join(clauses)} "
        f"ORDER BY started_at DESC, id DESC{limit}",
        parameters,
    ).fetchall()


def command_start(arguments, as_json):
    root, common, repo_id, branch = repository(arguments.worktree)
    claims = sorted({normalize_claim(root, value) for value in arguments.scope})
    duration = parse_duration(arguments.timebox)
    now = utc_now()
    task_id = f"{slug(arguments.task)}-{secrets.token_hex(3)}"
    scratch_root = Path.home() / "Scratch"
    scratch_root.mkdir(parents=True, exist_ok=True)
    connection = database()
    connection.execute("BEGIN IMMEDIATE")
    conflicts = find_conflicts(connection, repo_id, claims)
    if conflicts:
        connection.rollback()
        if as_json:
            print(
                json.dumps(
                    {"error": "scope conflict", "conflicts": conflicts}, indent=2
                )
            )
        else:
            for conflict in conflicts:
                print(
                    f"{conflict['requested']} overlaps {conflict['existing']} "
                    f"claimed by {conflict['task_id']} ({conflict['task']})",
                    file=sys.stderr,
                )
        raise SystemExit(3)
    scratch = tempfile.mkdtemp(prefix=f"{task_id}-", dir=scratch_root)
    pid = arguments.pid
    started = process_started(pid)
    connection.execute(
        """
        INSERT INTO tasks (
            id, repo_id, repo_root, git_common_dir, task, worktree, branch,
            scratch, pid, pid_started, started_at, deadline_at, heartbeat_at,
            status, owner
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'active', ?)
        """,
        (
            task_id,
            repo_id,
            str(root),
            str(common) if common else None,
            arguments.task,
            str(Path(arguments.worktree).resolve()),
            branch,
            scratch,
            pid,
            started,
            iso_time(now),
            iso_time(now + dt.timedelta(seconds=duration)),
            iso_time(now),
            arguments.owner,
        ),
    )
    connection.executemany(
        "INSERT INTO claims (task_id, path) VALUES (?, ?)",
        [(task_id, claim) for claim in claims],
    )
    append_event(
        connection,
        task_id,
        "start",
        iso_time(now),
        actor=arguments.owner,
        status="active",
        details={"claims": claims, "worktree": str(Path(arguments.worktree).resolve())},
    )
    connection.commit()
    record = serialize_task(connection, task_record(connection, task_id))
    emit(record, as_json)
    if not as_json:
        print(f"{DIM}export AGENT_WORK_ID={task_id}{RESET}")


def command_claim(arguments, as_json):
    connection = database()
    connection.execute("BEGIN IMMEDIATE")
    if arguments.task_option:
        task_id = arguments.task_option
        paths = arguments.values
    else:
        if len(arguments.values) < 2:
            connection.rollback()
            fail("claim requires TASK_ID and at least one path", 2)
        task_id, *paths = arguments.values
    row = task_record(connection, task_id)
    if row["status"] not in ACTIVE_STATES:
        connection.rollback()
        fail(f"cannot add scope to {row['status']} task {row['id']}", 2)
    root = Path(row["repo_root"])
    claims = sorted({normalize_claim(root, value) for value in paths})
    conflicts = find_conflicts(connection, row["repo_id"], claims, row["id"])
    if conflicts:
        connection.rollback()
        if as_json:
            print(
                json.dumps(
                    {"error": "scope conflict", "conflicts": conflicts}, indent=2
                )
            )
        else:
            for conflict in conflicts:
                print(
                    f"{conflict['requested']} overlaps {conflict['existing']} claimed by {conflict['task_id']}",
                    file=sys.stderr,
                )
        raise SystemExit(3)
    connection.executemany(
        "INSERT OR IGNORE INTO claims (task_id, path) VALUES (?, ?)",
        [(row["id"], claim) for claim in claims],
    )
    append_event(
        connection,
        row["id"],
        "claim",
        iso_time(utc_now()),
        actor=row["owner"],
        status=row["status"],
        details={"claims": claims},
    )
    connection.commit()
    emit(serialize_task(connection, task_record(connection, row["id"])), as_json)


def command_heartbeat(arguments, as_json):
    connection = database()
    connection.execute("BEGIN IMMEDIATE")
    row = task_record(connection, task_id_from(arguments))
    if row["status"] not in ACTIVE_STATES:
        connection.rollback()
        fail(f"cannot heartbeat {row['status']} task {row['id']}", 2)
    now = iso_time(utc_now())
    connection.execute(
        """
        UPDATE tasks
        SET heartbeat_at = ?, status = ?,
            owner = COALESCE(owner, ?),
            latest_note = COALESCE(?, latest_note)
        WHERE id = ?
        """,
        (now, arguments.status, arguments.agent, arguments.note, row["id"]),
    )
    append_event(
        connection,
        row["id"],
        "heartbeat",
        now,
        actor=arguments.agent or row["owner"],
        status=arguments.status,
        note=arguments.note,
    )
    connection.commit()
    emit(serialize_task(connection, task_record(connection, row["id"])), as_json)


def command_finish(arguments, as_json):
    connection = database()
    connection.execute("BEGIN IMMEDIATE")
    row = task_record(connection, task_id_from(arguments))
    if row["status"] not in ACTIVE_STATES:
        connection.rollback()
        fail(f"task {row['id']} is already {row['status']}", 2)
    now = iso_time(utc_now())
    connection.execute(
        """
        UPDATE tasks
        SET status = ?, summary = ?, checks_json = ?, changed_json = ?, heartbeat_at = ?
        WHERE id = ?
        """,
        (
            arguments.status,
            arguments.summary,
            json.dumps(arguments.check),
            json.dumps(arguments.changed),
            now,
            row["id"],
        ),
    )
    append_event(
        connection,
        row["id"],
        "finish",
        now,
        actor=arguments.agent or row["owner"],
        status=arguments.status,
        note=arguments.summary,
        details={"checks": arguments.check, "changed": arguments.changed},
    )
    connection.commit()
    emit(serialize_task(connection, task_record(connection, row["id"])), as_json)


def command_status(arguments, as_json):
    connection = database()
    if arguments.task_id or arguments.task_option:
        emit(
            serialize_task(
                connection, task_record(connection, task_id_from(arguments))
            ),
            as_json,
        )
        return
    states = (*ACTIVE_STATES, *TERMINAL_STATES) if arguments.all else ACTIVE_STATES
    emit(
        serialize_tasks(connection, board_rows(connection, arguments, states)), as_json
    )


def command_inspect(arguments, as_json):
    connection = database()
    states = (*ACTIVE_STATES, *TERMINAL_STATES) if arguments.all else ACTIVE_STATES
    tasks = serialize_tasks(connection, board_rows(connection, arguments, states))
    if as_json or not sys.stdout.isatty() or not shutil.which("fzf"):
        emit(tasks, as_json)
        return
    choices = []
    for task in tasks:
        left = human_duration(abs(task["seconds_remaining"]))
        if task["seconds_remaining"] < 0:
            left = f"-{left}"
        choices.append(
            "\t".join(
                (
                    task["id"],
                    task["status"],
                    left,
                    task["owner"] or "-",
                    task["task"],
                    ", ".join(task["claims"]),
                    task["latest_note"] or "",
                )
            )
        )
    if not choices:
        emit([], False)
        return
    selected = subprocess.run(
        [
            "fzf",
            "--layout=reverse",
            "--border=rounded",
            "--delimiter=\\t",
            "--with-nth=1,2,3,4,5,6,7",
            "--prompt=  task › ",
            "--pointer=♥",
            "--header=TASK · STATE · LEFT · OWNER · DESCRIPTION · SCOPE · NOTE",
        ],
        input="\n".join(choices) + "\n",
        text=True,
        stdout=subprocess.PIPE,
        check=False,
    )
    if selected.returncode == 0 and selected.stdout.strip():
        task_id = selected.stdout.split("\t", 1)[0]
        emit(serialize_task(connection, task_record(connection, task_id)), False)


def command_stale(arguments, as_json):
    cutoff = utc_now() - dt.timedelta(seconds=parse_duration(arguments.after))
    connection = database()
    rows = board_rows(connection, arguments, ACTIVE_STATES, bounded=False)
    stale = []
    for row in rows:
        heartbeat = dt.datetime.fromisoformat(
            row["heartbeat_at"].replace("Z", "+00:00")
        )
        record = serialize_task(connection, row)
        reasons = []
        if heartbeat < cutoff:
            reasons.append("heartbeat")
        if record["seconds_remaining"] < 0:
            reasons.append("deadline")
        if record["process_alive"] is False:
            reasons.append("process")
        if reasons:
            record["stale_reasons"] = reasons
            stale.append(record)
    emit(stale[: arguments.limit], as_json)


def command_history(arguments, as_json):
    connection = database()
    task_id = task_id_from(arguments)
    task_record(connection, task_id)
    rows = connection.execute(
        """
        SELECT * FROM (
            SELECT * FROM task_events
            WHERE task_id = ?
            ORDER BY id DESC
            LIMIT ?
        ) ORDER BY id
        """,
        (task_id, arguments.limit),
    ).fetchall()
    events = [serialize_event(row) for row in rows]
    if as_json:
        print(json.dumps(events, indent=2, sort_keys=True))
        return
    if not events:
        print(f"{PINK}♡ No recorded task events.{RESET}")
        return
    for event in events:
        actor = f" · {event['actor']}" if event["actor"] else ""
        note = f" · {event['note']}" if event["note"] else ""
        print(f"{event['occurred_at']}  {event['kind']}{actor}{note}")


def add_json_option(command):
    command.add_argument(
        "--json",
        action="store_true",
        default=argparse.SUPPRESS,
        help="emit stable JSON",
    )


def add_task_option(command):
    command.add_argument("task_id", nargs="?", metavar="TASK_ID")
    command.add_argument(
        "--task",
        dest="task_option",
        metavar="TASK_ID",
        help="named alternative to the positional task ID",
    )


def add_board_options(command, *, include_all=True):
    if include_all:
        command.add_argument(
            "--all", action="store_true", help="include terminal tasks"
        )
    location = command.add_mutually_exclusive_group()
    location.add_argument("--repo", metavar="PATH", help="select a repository")
    location.add_argument(
        "--all-repos", action="store_true", help="query the machine-wide ledger"
    )
    command.add_argument("--since", metavar="DURATION", help="limit by start time")
    command.add_argument(
        "--limit", type=positive_integer, default=100, help="maximum rows to emit"
    )
    add_json_option(command)


def parser():
    root = argparse.ArgumentParser(
        description="Coordinate parallel agent work without sharing transient state through Git."
    )
    root.add_argument("--json", action="store_true", help="emit stable JSON")
    commands = root.add_subparsers(dest="command", required=True)

    start = commands.add_parser(
        "start", help="register a timeboxed task and atomically claim scope"
    )
    start.add_argument("--task", required=True, metavar="DESCRIPTION")
    start.add_argument("--scope", action="append", required=True)
    start.add_argument("--timebox", default="1h")
    start.add_argument("--worktree", default=os.getcwd())
    start.add_argument("--pid", type=int)
    start.add_argument("--owner", metavar="AGENT", help="task owner label")
    add_json_option(start)
    start.set_defaults(handler=command_start)

    claim = commands.add_parser(
        "claim", help="add non-overlapping scope to an active task"
    )
    claim.add_argument("values", nargs="+", metavar="TASK_ID_OR_PATH")
    claim.add_argument(
        "--task",
        dest="task_option",
        metavar="TASK_ID",
        help="named task ID; all positional values are paths",
    )
    add_json_option(claim)
    claim.set_defaults(handler=command_claim)

    heartbeat = commands.add_parser(
        "heartbeat", help="refresh task liveness and working state"
    )
    add_task_option(heartbeat)
    heartbeat.add_argument("--status", choices=ACTIVE_STATES, default="active")
    heartbeat.add_argument("--agent", metavar="AGENT", help="event actor label")
    heartbeat.add_argument("--note", help="stage note retained in task history")
    add_json_option(heartbeat)
    heartbeat.set_defaults(handler=command_heartbeat)

    finish = commands.add_parser(
        "finish", help="close a task with an evidence-bearing handoff"
    )
    add_task_option(finish)
    finish.add_argument("--status", choices=TERMINAL_STATES, default="complete")
    finish.add_argument("--summary", required=True)
    finish.add_argument("--check", action="append", default=[])
    finish.add_argument("--changed", action="append", default=[])
    finish.add_argument("--agent", metavar="AGENT", help="event actor label")
    add_json_option(finish)
    finish.set_defaults(handler=command_finish)

    status = commands.add_parser("status", help="show one task or the active board")
    add_task_option(status)
    add_board_options(status)
    status.set_defaults(handler=command_status)

    inspect = commands.add_parser("inspect", help="show the active board")
    add_board_options(inspect)
    inspect.set_defaults(handler=command_inspect)

    stale = commands.add_parser(
        "stale", help="find overdue, unresponsive, or dead tasks without changing them"
    )
    stale.add_argument("--after", default="15m")
    add_board_options(stale, include_all=False)
    stale.set_defaults(all=False)
    stale.set_defaults(handler=command_stale)

    history = commands.add_parser("history", help="show retained task events")
    add_task_option(history)
    history.add_argument(
        "--limit", type=positive_integer, default=100, help="maximum events to emit"
    )
    add_json_option(history)
    history.set_defaults(handler=command_history)
    return root


def main():
    arguments = parser().parse_args()
    arguments.handler(arguments, arguments.json)


if __name__ == "__main__":
    main()
