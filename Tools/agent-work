        now,
        actor=arguments.agent or row["owner"],
        status=arguments.status,
        note=arguments.summary,
        details={"checks": arguments.check, "changed": arguments.changed},
    )
    messages.finish_requests(sys.modules[__name__], connection, row)
    messages.claim_notice(sys.modules[__name__], connection, row,
                          claims_by_task(connection, [row['id']])[row['id']], "claim-released")
