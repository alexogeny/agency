def serialize_task(connection, row, claims=None, *, attention_view=None):
    now = utc_now()
    deadline = dt.datetime.fromisoformat(row["deadline_at"].replace("Z", "+00:00"))
    return {
        "id": row["id"],
        "task": row["task"],
        "status": row["status"],
        "repo_id": row["repo_id"],
        "repo_root": row["repo_root"],
        "worktree": row["worktree"],
        "branch": row["branch"],
        "scratch": row["scratch"],
        "claim_kind": "write",
        "claims": claims
        if claims is not None
        else claims_by_task(connection, [row["id"]])[row["id"]],
        "owner": row["owner"],
        "latest_note": row["latest_note"],
        "pid": row["pid"],
        "process_alive": process_alive(row),
        "started_at": row["started_at"],
        "deadline_at": row["deadline_at"],
        "heartbeat_at": row["heartbeat_at"],
        "seconds_remaining": int((deadline - now).total_seconds()),
        "summary": row["summary"],
        "checks": json.loads(row["checks_json"]),
        "changed": json.loads(row["changed_json"]),
        "credential_file": str(messages.credential_path(sys.modules[__name__], row["id"]))
            if (row["id"] in attention_view.authenticated if attention_view is not None else
                connection.execute("SELECT 1 FROM task_auth WHERE task_id=?", (row["id"],)).fetchone()) else None,
        "claim_protocol": 2,
        **messages.attention(sys.modules[__name__], connection, row, view=attention_view),
    }


def serialize_tasks(connection, rows):
    with messages.read_snapshot(connection):
        claims = claims_by_task(connection, [row["id"] for row in rows])
        attention_view = messages.AttentionView(sys.modules[__name__], connection, rows)
        return [serialize_task(connection, row, claims[row["id"]], attention_view=attention_view) for row in rows]


def serialize_event(row):
    return {
        "id": row["id"],
        "task_id": row["task_id"],
        "occurred_at": row["occurred_at"],
        "kind": row["kind"],
        "actor": row["actor"],
        "status": row["status"],
        "note": row["note"],
        "details": json.loads(row["details_json"]),
    }


def emit(value, as_json):
    task_value = isinstance(value, dict) and "seconds_remaining" in value
    task_list = isinstance(value, list) and (not value or "seconds_remaining" in value[0])
    if as_json or not (task_value or task_list):
        print(json.dumps(value, indent=2, sort_keys=True))
        return
    if isinstance(value, list):
        emit_table(value)
        return
    remaining = value["seconds_remaining"]
    left = human_duration(abs(remaining))
    left = f"{left} left" if remaining >= 0 else f"{left} late"
    print(f"{PURPLE}◇ {value['id']}{RESET}  {value['status']} · {left}")
    print(f"  {value['task']}")
    print(f"  worktree  {value['worktree']}")
    print(f"  writes    {', '.join(value['claims'])}")
    print(f"  scratch   {value['scratch']}")
    if value["owner"]:
        print(f"  owner     {value['owner']}")
    if value["latest_note"]:
        print(f"  note      {value['latest_note']}")
    if value["summary"]:
        print(f"  summary   {value['summary']}")
    if value["exclusions"]:
        print(f"  excludes  {json.dumps(value['exclusions'])}")
    if value["paused_scopes"]:
        print(f"  paused    {json.dumps(value['paused_scopes'])}")
    if value["unread_messages"] or value["pending_requests"]:
        print(f"  attention {value['unread_messages']} unread · {len(value['pending_requests'])} pending requests")


def human_duration(seconds):
    seconds = max(0, int(seconds))
    if seconds >= 86400:
        return f"{seconds // 86400}d"
    if seconds >= 3600:
        return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}m"
    return f"{seconds // 60}m"


def emit_table(tasks):
    if not tasks:
        print(f"{PINK}♡ No matching agent tasks.{RESET}")
        return
    print(
        f"{PURPLE}{'TASK':<31} {'STATE':<10} {'LEFT':>8}  "
        f"{'OWNER':<18} {'WRITES'}{RESET}"
    )
    for task in tasks:
        remaining = task["seconds_remaining"]
        left = human_duration(abs(remaining))
        if remaining < 0:
            left = f"-{left}"
        scope = ", ".join(task["claims"])
        owner = task["owner"] or "-"
        print(f"{task['id']:<31} {task['status']:<10} {left:>8}  {owner:<18} {scope}")
        if task["latest_note"]:
            print(f"  ↳ {task['latest_note']}")
        if task["exclusions"] or task["paused_scopes"]:
            print(f"  ↳ exclusions {json.dumps(task['exclusions'])} · paused {json.dumps(task['paused_scopes'])}")
        if task["unread_messages"] or task["pending_requests"]:
            print(f"  ↳ {task['unread_messages']} unread · {len(task['pending_requests'])} pending requests")


def find_conflicts(connection, repo_id, claims, exclude_task=None, *, ownership=None):
    placeholders = ",".join("?" for _ in ACTIVE_STATES)
    parameters = [repo_id, *ACTIVE_STATES]
    query = f"""
        SELECT t.id, t.task, c.path
        FROM tasks t JOIN claims c ON c.task_id = t.id
        WHERE t.repo_id = ? AND t.status IN ({placeholders})
    """
    if exclude_task:
        query += " AND t.id != ?"
        parameters.append(exclude_task)
    conflicts = []
    requested = messages.ScopeIndex(claims)
    if ownership is None:
        ownership = messages.ownership_exclusions(connection, repo_id, exclude_task)
    for row in connection.execute(query, parameters):
        for index in requested.overlapping(row["path"]):
            claim = claims[index]
            if messages.overlaps(sys.modules[__name__], connection, row["id"], row["path"], claim, ownership=ownership):
                conflicts.append(
                    {
                        "task_id": row["id"],
                        "task": row["task"],
                        "existing": row["path"],
                        "requested": claim,
                    }
                )
    return conflicts


def board_repo_id(arguments):
    if arguments.all_repos:
        return None
    return repository(arguments.repo or os.getcwd())[2]


def board_rows(connection, arguments, states, *, bounded=True):
    clauses = [f"status IN ({','.join('?' for _ in states)})"]
    parameters = list(states)
    repo_id = board_repo_id(arguments)
    if repo_id:
        clauses.append("repo_id = ?")
        parameters.append(repo_id)
    if arguments.since:
        cutoff = utc_now() - dt.timedelta(seconds=parse_duration(arguments.since))
        clauses.append("started_at >= ?")
        parameters.append(iso_time(cutoff))
    limit = ""
    if bounded:
        limit = " LIMIT ?"
        parameters.append(arguments.limit)
    return connection.execute(
        f"SELECT * FROM tasks WHERE {' AND '.join(clauses)} "
        f"ORDER BY started_at DESC, id DESC{limit}",
        parameters,
    ).fetchall()


def command_start(arguments, as_json):
    if bool(arguments.client) != bool(arguments.session):
        fail("--client and --session must be supplied together", 2)
    root, common, repo_id, branch = repository(arguments.worktree)
    claims = sorted({normalize_claim(root, value) for value in arguments.scope or []})
    duration = parse_duration(arguments.timebox)
    now = utc_now()
    task_id = f"{slug(arguments.task)}-{secrets.token_hex(3)}"
    scratch_root = Path.home() / "Scratch"
    scratch_root.mkdir(parents=True, exist_ok=True)
    connection = database()
    connection.execute("BEGIN IMMEDIATE")
    conflicts = find_conflicts(connection, repo_id, claims)
    if conflicts:
        connection.rollback()
        if as_json:
            print(
                json.dumps(
                    {
                        "error": "scope conflict",
                        "claim_kind": "write",
                        "read_allowed": True,
                        "conflicts": conflicts,
                    },
                    indent=2,
                )
            )
        else:
            for conflict in conflicts:
                print(
                    f"{conflict['requested']} overlaps {conflict['existing']} "
                    f"write-claimed by {conflict['task_id']} ({conflict['task']}); "
                    "read-only access remains allowed",
                    file=sys.stderr,
                )
        raise SystemExit(3)
    scratch = tempfile.mkdtemp(prefix=f"{task_id}-", dir=scratch_root)
    pid = arguments.pid
    started = process_started(pid)
    connection.execute(
        """
        INSERT INTO tasks (
            id, repo_id, repo_root, git_common_dir, task, worktree, branch,
            scratch, pid, pid_started, started_at, deadline_at, heartbeat_at,
            status, owner
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'active', ?)
        """,
        (
            task_id,
            repo_id,
            str(root),
            str(common) if common else None,
            arguments.task,
            str(Path(arguments.worktree).resolve()),
            branch,
            scratch,
            pid,
            started,
            iso_time(now),
            iso_time(now + dt.timedelta(seconds=duration)),
            iso_time(now),
            arguments.owner,
        ),
    )
    connection.executemany(
        "INSERT INTO claims (task_id, path) VALUES (?, ?)",
        [(task_id, claim) for claim in claims],
    )
    append_event(
        connection,
        task_id,
        "start",
        iso_time(now),
        actor=arguments.owner,
        status="active",
        details={"claims": claims, "worktree": str(Path(arguments.worktree).resolve())},
    )
    token = secrets.token_hex(32)
    connection.execute("INSERT INTO task_auth(task_id,token_hash) VALUES(?,?)", (task_id, messages.token_hash(token)))
    messages.save_credential(sys.modules[__name__], task_id, token)
    if arguments.client and arguments.session:
        messages.register_session(sys.modules[__name__], connection, task_record(connection, task_id), arguments.client, arguments.session)
    messages.claim_notice(sys.modules[__name__], connection, task_record(connection, task_id), claims)
    connection.commit()
    messages.wake(connection)
    record = serialize_task(connection, task_record(connection, task_id))
    record["task_token"] = token
    emit(record, as_json)
    if not as_json:
        print(f"{DIM}export AGENT_WORK_ID={task_id}{RESET}")
        print(f"export AGENT_WORK_TOKEN={token}")


def command_claim(arguments, as_json):
    connection = database()
    connection.execute("BEGIN IMMEDIATE")
    if arguments.task_option:
        task_id = arguments.task_option
        paths = arguments.values
    else:
        if len(arguments.values) < 2:
            connection.rollback()
            fail("claim requires TASK_ID and at least one path", 2)
        task_id, *paths = arguments.values
    row = task_record(connection, task_id)
    messages.authorize(sys.modules[__name__], connection, row, legacy=True)
    if row["status"] not in ACTIVE_STATES:
        connection.rollback()
        fail(f"cannot add write scope to {row['status']} task {row['id']}", 2)
    root = Path(row["repo_root"])
    claims = sorted({normalize_claim(root, value) for value in paths})
    messages.assert_not_paused(sys.modules[__name__], connection, task_id, claims)
    conflicts = find_conflicts(connection, row["repo_id"], claims, row["id"])
    if conflicts:
        connection.rollback()
        if as_json:
            print(
                json.dumps(
                    {
                        "error": "scope conflict",
                        "claim_kind": "write",
                        "read_allowed": True,
                        "conflicts": conflicts,
                        "next_action": f"agent-work request-claim {task_id} {' '.join(claims)} --message REASON",
                    },
                    indent=2,
                )
            )
        else:
            for conflict in conflicts:
                print(
                    f"{conflict['requested']} overlaps {conflict['existing']} "
                    f"write-claimed by {conflict['task_id']}; read-only access remains allowed",
                    file=sys.stderr,
                )
        raise SystemExit(3)
    messages.grant_paths(connection, row["id"], claims)
    append_event(
        connection,
        row["id"],
        "claim",
        iso_time(utc_now()),
        actor=row["owner"],
        status=row["status"],
        details={"claims": claims},
    )
    messages.claim_notice(sys.modules[__name__], connection, row, claims)
    connection.commit()
    messages.wake(connection)
    emit(serialize_task(connection, task_record(connection, row["id"])), as_json)


def command_heartbeat(arguments, as_json):
    connection = database()
    connection.execute("BEGIN IMMEDIATE")
    row = task_record(connection, task_id_from(arguments))
    messages.authorize(sys.modules[__name__], connection, row, legacy=True)
    if row["status"] not in ACTIVE_STATES:
        connection.rollback()
        fail(f"cannot heartbeat {row['status']} task {row['id']}", 2)
    now = iso_time(utc_now())
    connection.execute(
        """
        UPDATE tasks
        SET heartbeat_at = ?, status = ?,
            owner = COALESCE(owner, ?),
            latest_note = COALESCE(?, latest_note)
        WHERE id = ?
        """,
        (now, arguments.status, arguments.agent, arguments.note, row["id"]),
    )
    append_event(
        connection,
        row["id"],
        "heartbeat",
        now,
        actor=arguments.agent or row["owner"],
        status=arguments.status,
        note=arguments.note,
    )
    connection.commit()
    emit(serialize_task(connection, task_record(connection, row["id"])), as_json)


def command_finish(arguments, as_json):
    connection = database()
    connection.execute("BEGIN IMMEDIATE")
    row = task_record(connection, task_id_from(arguments))
    messages.authorize(sys.modules[__name__], connection, row, legacy=True)
    if row["status"] not in ACTIVE_STATES:
