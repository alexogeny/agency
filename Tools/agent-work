def command_status(arguments, as_json):
    connection = database()
    with messages.read_snapshot(connection):
        if arguments.task_id or arguments.task_option:
            result = serialize_task(connection, task_record(connection, task_id_from(arguments)))
        else:
            states = (*ACTIVE_STATES, *TERMINAL_STATES) if arguments.all else ACTIVE_STATES
            result = serialize_tasks(connection, board_rows(connection, arguments, states))
    emit(result, as_json)


def command_inspect(arguments, as_json):
    connection = database()
    with messages.read_snapshot(connection):
        if arguments.task_id or arguments.task_option:
            record = serialize_task(connection, task_record(connection, task_id_from(arguments)))
            tasks = None
        else:
            states = (*ACTIVE_STATES, *TERMINAL_STATES) if arguments.all else ACTIVE_STATES
            tasks = serialize_tasks(connection, board_rows(connection, arguments, states))
    if tasks is None:
        emit(record, as_json)
        return
    if as_json or not sys.stdout.isatty() or not shutil.which("fzf"):
        emit(tasks, as_json)
        return
    choices = []
    for task in tasks:
        left = human_duration(abs(task["seconds_remaining"]))
        if task["seconds_remaining"] < 0:
            left = f"-{left}"
        choices.append(
            "\t".join(
                (
                    task["id"],
                    task["status"],
                    left,
                    task["owner"] or "-",
                    task["task"],
                    ", ".join(task["claims"]),
                    task["latest_note"] or "",
                )
            )
        )
    if not choices:
        emit([], False)
        return
    selected = subprocess.run(
        [
            "fzf",
            "--layout=reverse",
            "--border=rounded",
            "--delimiter=\\t",
            "--with-nth=1,2,3,4,5,6,7",
            "--prompt=  task › ",
            "--pointer=♥",
            "--header=TASK · STATE · LEFT · OWNER · DESCRIPTION · WRITES · NOTE",
        ],
        input="\n".join(choices) + "\n",
        text=True,
        stdout=subprocess.PIPE,
        check=False,
    )
    if selected.returncode == 0 and selected.stdout.strip():
        task_id = selected.stdout.split("\t", 1)[0]
        with messages.read_snapshot(connection):
            record = serialize_task(connection, task_record(connection, task_id))
        emit(record, False)


def command_stale(arguments, as_json):
    cutoff = utc_now() - dt.timedelta(seconds=parse_duration(arguments.after))
    connection = database()
    with messages.read_snapshot(connection):
        records = serialize_tasks(connection, board_rows(connection, arguments, ACTIVE_STATES, bounded=False))
    stale = []
    for record in records:
        heartbeat = dt.datetime.fromisoformat(
            record["heartbeat_at"].replace("Z", "+00:00")
        )
        reasons = []
        if heartbeat < cutoff:
            reasons.append("heartbeat")
        if record["seconds_remaining"] < 0:
            reasons.append("deadline")
        if record["process_alive"] is False:
            reasons.append("process")
        if reasons:
            record["stale_reasons"] = reasons
            stale.append(record)
    emit(stale[: arguments.limit], as_json)


def command_history(arguments, as_json):
    connection = database()
    task_id = task_id_from(arguments)
    task_record(connection, task_id)
    rows = connection.execute(
        """
        SELECT * FROM (
            SELECT * FROM task_events
            WHERE task_id = ?
            ORDER BY id DESC
            LIMIT ?
        ) ORDER BY id
        """,
        (task_id, arguments.limit),
    ).fetchall()
    events = [serialize_event(row) for row in rows]
    if as_json:
        print(json.dumps(events, indent=2, sort_keys=True))
        return
    if not events:
        print(f"{PINK}♡ No recorded task events.{RESET}")
        return
    for event in events:
        actor = f" · {event['actor']}" if event["actor"] else ""
        note = f" · {event['note']}" if event["note"] else ""
        print(f"{event['occurred_at']}  {event['kind']}{actor}{note}")


def add_json_option(command):
    command.add_argument(
        "--json",
        action="store_true",
        default=argparse.SUPPRESS,
        help="emit stable JSON",
    )


def add_task_option(command):
    command.add_argument("task_id", nargs="?", metavar="TASK_ID")
    command.add_argument(
        "--task",
        dest="task_option",
        metavar="TASK_ID",
        help="named alternative to the positional task ID",
    )


def add_board_options(command, *, include_all=True):
    if include_all:
        command.add_argument(
            "--all", action="store_true", help="include terminal tasks"
        )
    location = command.add_mutually_exclusive_group()
    location.add_argument("--repo", metavar="PATH", help="select a repository")
    location.add_argument(
        "--all-repos", action="store_true", help="query the machine-wide ledger"
    )
    command.add_argument("--since", metavar="DURATION", help="limit by start time")
    command.add_argument(
        "--limit", type=positive_integer, default=100, help="maximum rows to emit"
    )
    add_json_option(command)


def parser():
    root = argparse.ArgumentParser(
        description="Coordinate parallel agent work without sharing transient state through Git."
    )
    root.add_argument("--json", action="store_true", help="emit stable JSON")
    commands = root.add_subparsers(dest="command", required=True)

    start = commands.add_parser(
        "start", help="register a timeboxed task and atomically claim write scope"
    )
    start.add_argument("--task", required=True, metavar="DESCRIPTION")
    scope = start.add_mutually_exclusive_group(required=True)
    scope.add_argument(
        "--scope",
        action="append",
        help="path reserved for writes; repeatable; reads never require a claim",
    )
    scope.add_argument("--no-claims", action="store_true", help="register a task before negotiating its first write claim")
    start.add_argument("--timebox", default="1h")
    start.add_argument("--worktree", default=os.getcwd())
    start.add_argument("--pid", type=int)
    start.add_argument("--owner", metavar="AGENT", help="task owner label")
    start.add_argument("--client", choices=("codex", "claude", "pi"))
    start.add_argument("--session", help="bind delivery to this client session")
    add_json_option(start)
    start.set_defaults(handler=command_start)

    claim = commands.add_parser(
        "claim", help="add non-overlapping write scope to an active task"
    )
    claim.add_argument("values", nargs="+", metavar="TASK_ID_OR_PATH")
    claim.add_argument(
        "--task",
        dest="task_option",
        metavar="TASK_ID",
        help="named task ID; all positional values are paths",
    )
    add_json_option(claim)
    claim.set_defaults(handler=command_claim)

    heartbeat = commands.add_parser(
        "heartbeat", help="refresh task liveness and working state"
    )
    add_task_option(heartbeat)
    heartbeat.add_argument("--status", choices=ACTIVE_STATES, default="active")
    heartbeat.add_argument("--agent", metavar="AGENT", help="event actor label")
    heartbeat.add_argument("--note", help="stage note retained in task history")
    add_json_option(heartbeat)
    heartbeat.set_defaults(handler=command_heartbeat)

    finish = commands.add_parser(
        "finish", help="close a task with an evidence-bearing handoff"
    )
    add_task_option(finish)
    finish.add_argument("--status", choices=TERMINAL_STATES, default="complete")
    finish.add_argument("--summary", required=True)
    finish.add_argument("--check", action="append", default=[])
    finish.add_argument("--changed", action="append", default=[])
    finish.add_argument("--agent", metavar="AGENT", help="event actor label")
    add_json_option(finish)
    finish.set_defaults(handler=command_finish)

    status = commands.add_parser("status", help="show one task or the active board")
    add_task_option(status)
    add_board_options(status)
    status.set_defaults(handler=command_status)

    inspect = commands.add_parser(
        "inspect", help="show one task or choose from the active board"
    )
    add_task_option(inspect)
    add_board_options(inspect)
    inspect.set_defaults(handler=command_inspect)

    stale = commands.add_parser(
        "stale", help="find overdue, unresponsive, or dead tasks without changing them"
    )
    stale.add_argument("--after", default="15m")
    add_board_options(stale, include_all=False)
    stale.set_defaults(all=False)
    stale.set_defaults(handler=command_stale)

    history = commands.add_parser("history", help="show retained task events")
    add_task_option(history)
    history.add_argument(
        "--limit", type=positive_integer, default=100, help="maximum events to emit"
    )
    add_json_option(history)
    history.set_defaults(handler=command_history)
    messages.parser(sys.modules[__name__], commands)
    return root


def main():
    arguments = parser().parse_args()
    arguments.handler(arguments, arguments.json)


if __name__ == "__main__":
    main()
