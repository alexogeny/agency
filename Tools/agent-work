ACTIVE_STATES = ("active", "waiting")
TERMINAL_STATES = ("complete", "failed", "abandoned", "superseded")
PURPLE = "\033[1;35m"
PINK = "\033[38;5;183m"
DIM = "\033[2m"
RESET = "\033[0m"


def fail(message, code=1):
    print(f"\033[1;31merror:\033[0m {message}", file=sys.stderr)
    raise SystemExit(code)


def parse_duration(value):
    match = re.fullmatch(r"([1-9][0-9]*)([smhd]?)", value)
    if not match:
        fail(f"invalid duration {value!r}; use 30m, 2h, or 1d", 2)
    amount = int(match.group(1))
    multiplier = {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]
    return amount * multiplier


def positive_integer(value):
    try:
        number = int(value)
    except ValueError:
        fail(f"invalid positive integer: {value!r}", 2)
    if number < 1:
        fail(f"invalid positive integer: {value!r}", 2)
    return number


def utc_now():
    return dt.datetime.now(dt.UTC)


def iso_time(value):
    return value.isoformat(timespec="seconds").replace("+00:00", "Z")


def state_root():
    override = os.environ.get("AGENT_WORK_STATE_DIR")
    root = (
        Path(override)
        if override
        else Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
        / "agent-work"
    )
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    root.chmod(0o700)
    return root


SCHEMA_VERSION = 2
CLAIM_IDLE_HOURS = 6


def database():
    path = state_root() / "tasks.sqlite3"
    connection = sqlite3.connect(path, timeout=10)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA foreign_keys=ON")
    os.chmod(path, 0o600)
    if connection.execute("PRAGMA user_version").fetchone()[0] < SCHEMA_VERSION:
        migrate_database(connection, path)
    messages.provision_legacy(sys.modules[__name__], connection)
    expire_claims(connection)
    return connection


def migrate_database(connection, path):
    connection.execute("PRAGMA journal_mode=WAL")
    columns = {row[1] for row in connection.execute("PRAGMA table_info(tasks)")}
    if columns and any(name not in columns for name in ("owner", "latest_note")):
        timestamp = utc_now().strftime("%Y%m%dT%H%M%S%fZ")
        backup = sqlite3.connect(path.with_name(f"tasks.pre-migration-{timestamp}.sqlite3"))
        try:
            connection.backup(backup)
        finally:
            backup.close()
    connection.execute("BEGIN IMMEDIATE")
    try:
        if connection.execute("PRAGMA user_version").fetchone()[0] >= SCHEMA_VERSION:
            connection.commit()
            return
        statements = """
        CREATE TABLE IF NOT EXISTS tasks (
            id TEXT PRIMARY KEY,
            repo_id TEXT NOT NULL,
            repo_root TEXT NOT NULL,
            git_common_dir TEXT,
            task TEXT NOT NULL,
            worktree TEXT NOT NULL,
            branch TEXT,
            scratch TEXT NOT NULL,
            pid INTEGER,
            pid_started TEXT,
            started_at TEXT NOT NULL,
            deadline_at TEXT NOT NULL,
            heartbeat_at TEXT NOT NULL,
            status TEXT NOT NULL,
            owner TEXT,
            latest_note TEXT,
            summary TEXT,
            checks_json TEXT NOT NULL DEFAULT '[]',
            changed_json TEXT NOT NULL DEFAULT '[]'
        );
        CREATE TABLE IF NOT EXISTS claims (
            task_id TEXT NOT NULL REFERENCES tasks(id),
            path TEXT NOT NULL,
            PRIMARY KEY (task_id, path)
        );
        CREATE INDEX IF NOT EXISTS claims_path ON claims(path);
        CREATE INDEX IF NOT EXISTS tasks_repo_status ON tasks(repo_id, status);
        CREATE TABLE IF NOT EXISTS ledger_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
        """
        for statement in statements.split(';'):
            if statement.strip():
                connection.execute(statement)
        columns = {row[1] for row in connection.execute("PRAGMA table_info(tasks)")}
        for name in ("owner", "latest_note"):
            if name not in columns:
                connection.execute(f"ALTER TABLE tasks ADD COLUMN {name} TEXT")
        connection.execute("""CREATE TABLE IF NOT EXISTS task_events (
            id INTEGER PRIMARY KEY AUTOINCREMENT, task_id TEXT NOT NULL REFERENCES tasks(id),
            occurred_at TEXT NOT NULL, kind TEXT NOT NULL, actor TEXT, status TEXT, note TEXT,
            details_json TEXT NOT NULL DEFAULT '{}')""")
        connection.execute("CREATE INDEX IF NOT EXISTS task_events_task_time ON task_events(task_id,occurred_at,id)")
        connection.execute("CREATE INDEX IF NOT EXISTS tasks_status ON tasks(status)")
        messages.schema(connection)
        # Older cooperating binaries insert tasks without auth. Triggers queue
        # those IDs; modern starts remove them when inserting their credentials.
        connection.execute("""CREATE TRIGGER IF NOT EXISTS tasks_auth_pending_insert AFTER INSERT ON tasks
            WHEN NEW.status IN ('active','waiting') AND NOT EXISTS (SELECT 1 FROM task_auth WHERE task_id=NEW.id)
            BEGIN INSERT OR IGNORE INTO legacy_auth_pending VALUES(NEW.id); END""")
        connection.execute("""CREATE TRIGGER IF NOT EXISTS tasks_auth_pending_update AFTER UPDATE OF status ON tasks
            WHEN NEW.status IN ('active','waiting') AND NOT EXISTS (SELECT 1 FROM task_auth WHERE task_id=NEW.id)
            BEGIN INSERT OR IGNORE INTO legacy_auth_pending VALUES(NEW.id); END""")
        connection.execute("""CREATE TRIGGER IF NOT EXISTS tasks_auth_pending_clear AFTER INSERT ON task_auth
            BEGIN DELETE FROM legacy_auth_pending WHERE task_id=NEW.task_id; END""")
        connection.execute("""CREATE TRIGGER IF NOT EXISTS tasks_auth_pending_inactive AFTER UPDATE OF status ON tasks
            WHEN NEW.status NOT IN ('active','waiting')
            BEGIN DELETE FROM legacy_auth_pending WHERE task_id=NEW.id; END""")
        connection.execute("""INSERT OR IGNORE INTO legacy_auth_pending
            SELECT t.id FROM tasks t LEFT JOIN task_auth a ON a.task_id=t.id
            WHERE a.task_id IS NULL AND t.status IN ('active','waiting')""")
        messages.provision_legacy(sys.modules[__name__], connection, in_transaction=True)
        connection.execute(f"PRAGMA user_version={SCHEMA_VERSION}")
        connection.commit()
    except BaseException:
        connection.rollback()
        raise


@lru_cache(maxsize=1)
def boot_session():
    if sys.platform == "linux":
        try:
            identity = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
            match = re.search(r"^btime ([0-9]+)$", Path("/proc/stat").read_text(), re.M)
            started = dt.datetime.fromtimestamp(int(match[1]), dt.UTC) if match else None
            return identity or None, started
        except OSError:
            return None, None
    if sys.platform == "darwin":
        try:
            result = subprocess.run(["/usr/sbin/sysctl", "-n", "kern.boottime"],
                                    text=True, capture_output=True, check=False)
        except OSError:
            return None, None
        match = re.search(r"sec = ([0-9]+), usec = ([0-9]+)", result.stdout)
        if result.returncode == 0 and match:
            return match[0], dt.datetime.fromtimestamp(int(match[1]), dt.UTC)
    return None, None


def expire_claims(connection):
    """Recheck under the writer lock so a concurrent heartbeat can renew claims."""
    boot_id, boot_started = boot_session()
    current = utc_now()
    cutoff = iso_time(current - dt.timedelta(hours=CLAIM_IDLE_HOURS))

    def candidates():
        previous = connection.execute("SELECT value FROM ledger_meta WHERE key='boot_id'").fetchone()
        reboot = bool(boot_id and previous and previous[0] != boot_id)
        first_boot = iso_time(boot_started) if boot_id and not previous and boot_started else None
        rows = connection.execute("""SELECT *, (? OR julianday(started_at)<julianday(?)) AS previous_boot
            FROM tasks WHERE status IN ('active','waiting')
            AND (? OR (julianday(started_at)<julianday(?)) OR julianday(heartbeat_at)<=julianday(?))""",
            (reboot, first_boot, reboot, first_boot, cutoff)).fetchall()
        return previous, rows

    previous, rows = candidates()
    if not rows and (not boot_id or (previous and previous[0] == boot_id)):
        return
    connection.execute("BEGIN IMMEDIATE")
    try:
        previous, rows = candidates()
        h = sys.modules[__name__]
        owned = claims_by_task(connection, [row["id"] for row in rows])
        expired = {row["id"]: row for row in rows}
        for row in rows:
            from_previous_boot = bool(row["previous_boot"])
            reason = "reboot" if from_previous_boot else "heartbeat-timeout"
            summary = "Claims cleared after reboot" if from_previous_boot else "Claims expired after six hours without a task heartbeat"
            connection.execute("UPDATE tasks SET status='abandoned',summary=? WHERE id=?", (summary, row["id"]))
            append_event(connection, row["id"], "claims-expired", iso_time(current),
                         status="abandoned", note=summary,
                         details={"reason": reason, "claims": owned[row["id"]]})
        cancelled = []
        for repo_id in sorted({row["repo_id"] for row in rows}):
            requests = connection.execute("""SELECT * FROM claim_requests
                WHERE repo_id=? AND status IN ('pending','needs-review')""", (repo_id,)).fetchall()
            for request in requests:
                participants = {request["requester"], *(item["task_id"] for item in json.loads(request["snapshot_json"]))}
                affected = participants.intersection(expired)
                if affected:
                    connection.execute("UPDATE claim_requests SET status='cancelled' WHERE id=?", (request["id"],))
                    cancelled.append((request["id"], expired[min(affected)]))
        if cancelled:
            view = messages.RequestView(h, connection, [identity for identity, _ in cancelled])
            for identity, sender in cancelled:
                messages.request_notice(h, connection, sender,
                                        messages.request_record(h, connection, identity, view=view), "request-cancelled")
        for row in rows:
            for table in ("claims", "claim_exclusions", "work_sessions"):
                connection.execute(f"DELETE FROM {table} WHERE task_id=?", (row["id"],))
            messages.claim_notice(h, connection, row, owned[row["id"]], "claim-released")
        if boot_id:
            connection.execute("INSERT OR REPLACE INTO ledger_meta VALUES('boot_id',?)", (boot_id,))
        connection.commit()
    except BaseException:
        connection.rollback()
        raise
    if rows:
        messages.wake(connection)


def git_value(cwd, *arguments):
    result = subprocess.run(
        ["git", "-C", str(cwd), *arguments],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def repository(cwd):
    worktree = Path(cwd).resolve()
    root_value = git_value(worktree, "rev-parse", "--show-toplevel")
    if root_value:
        root = Path(root_value).resolve()
        common_value = git_value(root, "rev-parse", "--git-common-dir")
        common = (root / common_value).resolve() if common_value else None
        identity = str(common or root)
        branch = git_value(root, "branch", "--show-current") or None
    else:
        root = worktree
        common = None
        identity = str(root)
        branch = None
    repo_id = hashlib.sha256(identity.encode()).hexdigest()[:12]
    return root, common, repo_id, branch


def normalize_claim(root, value):
    path = Path(value)
    absolute = path.resolve() if path.is_absolute() else (root / path).resolve()
    try:
        relative = absolute.relative_to(root)
        normalized = relative.as_posix() or "."
    except ValueError:
        normalized = absolute.as_posix()
    return normalized.rstrip("/") or "."


def claims_overlap(first, second):
    if first.startswith("/") != second.startswith("/"):
        return False
    if first == "." or second == ".":
        return True
    return (
        first == second
        or first.startswith(second + "/")
        or second.startswith(first + "/")
    )


def process_started(pid):
    if not pid:
        return None
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()
        return fields[19]
    except (FileNotFoundError, PermissionError, IndexError):
        return None


def process_alive(row):
    if not row["pid"] or not row["pid_started"]:
        return None
    return process_started(row["pid"]) == row["pid_started"]


def slug(value):
    clean = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return clean[:24] or "task"


def task_record(connection, task_id):
    row = connection.execute("SELECT * FROM tasks WHERE id = ?", (task_id,)).fetchone()
    if not row:
        fail(f"unknown task: {task_id}", 2)
    return row


def task_id_from(arguments):
    positional = getattr(arguments, "task_id", None)
    option = getattr(arguments, "task_option", None)
    if positional and option and positional != option:
        fail("task ID was supplied twice with different values", 2)
    task_id = positional or option or os.environ.get("AGENT_WORK_ID")
    if not task_id:
        fail("task ID is required; pass TASK_ID or --task TASK_ID", 2)
    return task_id


def claims_by_task(connection, task_ids):
    claims = {task_id: [] for task_id in task_ids}
    if not task_ids:
        return claims
    placeholders = ",".join("?" for _ in task_ids)
    for row in connection.execute(
        f"SELECT task_id, path FROM claims WHERE task_id IN ({placeholders}) "
        "ORDER BY task_id, path",
        task_ids,
    ):
        claims[row["task_id"]].append(row["path"])
    return claims


