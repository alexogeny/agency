        fail(f"task {row['id']} is already {row['status']}", 2)
    now = iso_time(utc_now())
    connection.execute(
        """
        UPDATE tasks
        SET status = ?, summary = ?, checks_json = ?, changed_json = ?, heartbeat_at = ?
        WHERE id = ?
        """,
        (
