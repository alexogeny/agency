#!/usr/bin/env python3
from __future__ import annotations

import argparse
import ast
import io
import json
import re
import subprocess
import sys
import tokenize
from collections import Counter
from pathlib import Path


SUPPORTED = {
    ".py": "hash",
    ".pyi": "hash",
    ".sh": "hash",
    ".bash": "hash",
    ".zsh": "hash",
    ".fish": "hash",
    ".rb": "hash",
    ".yaml": "hash",
    ".yml": "hash",
    ".toml": "hash",
    ".js": "slash",
    ".jsx": "slash",
    ".ts": "slash",
    ".tsx": "slash",
    ".go": "slash",
    ".rs": "slash",
    ".java": "slash",
    ".c": "slash",
    ".h": "slash",
    ".cc": "slash",
    ".cpp": "slash",
    ".hpp": "slash",
}
HISTORY = re.compile(
    r"\b(?:used to|for a while|previously|formerly|was never|"
    r"now (?:uses|does|is)|this change|we changed|was changed)\b",
    re.IGNORECASE,
)
DECORATIVE = re.compile(
    r"^(?:[-=_*~.]{6,}|[-=_*~.]{2,}\s*\S.*?[-=_*~.]{2,})$"
)


def fail(message: str, status: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(status)


def finding(path: Path, line: int, category: str, text: str) -> dict[str, str | int]:
    return {
        "path": str(path),
        "line": line,
        "category": category,
        "text": text.strip(),
    }


def classify(path: Path, line: int, text: str) -> dict[str, str | int] | None:
    stripped = text.strip()
    if not stripped:
        return finding(path, line, "empty-comment", text)
    if DECORATIVE.fullmatch(stripped):
        return finding(path, line, "decorative-comment", text)
    if HISTORY.search(stripped):
        return finding(path, line, "history-narration", text)
    return None


def python_comments(path: Path, source: str) -> list[dict[str, str | int]]:
    found = []
    try:
        tokens = tokenize.generate_tokens(io.StringIO(source).readline)
        for token in tokens:
            if token.type != tokenize.COMMENT:
                continue
            item = classify(path, token.start[0], token.string[1:])
            if item:
                found.append(item)
    except (IndentationError, tokenize.TokenError):
        return found
    return found


def python_docstrings(path: Path, source: str) -> list[dict[str, str | int]]:
    try:
        tree = ast.parse(source)
    except SyntaxError:
        return []
    found = []
    for node in ast.walk(tree):
        if not isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        body = getattr(node, "body", ())
        if not body or not isinstance(body[0], ast.Expr):
            continue
        value = body[0].value
        if not isinstance(value, ast.Constant) or not isinstance(value.value, str):
            continue
        if HISTORY.search(value.value):
            found.append(finding(path, value.lineno, "history-narration", value.value))
    return found


def line_comments(path: Path, source: str, marker: str) -> list[dict[str, str | int]]:
    found = []
    pattern = re.compile(rf"^\s*{re.escape(marker)}(.*)$")
    for number, line in enumerate(source.splitlines(), 1):
        match = pattern.match(line)
        if match is None:
            continue
        item = classify(path, number, match.group(1))
        if item:
            found.append(item)
    return found


def git_visible(root: Path) -> list[Path] | None:
    result = subprocess.run(
        ["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
        check=False,
        capture_output=True,
    )
    if result.returncode:
        return None
    return [root / value.decode() for value in result.stdout.split(b"\0") if value]


def paths(targets: list[Path], visible_only: bool) -> list[Path]:
    found = set()
    for target in targets:
        resolved = target.resolve()
        if resolved.is_file():
            found.add(resolved)
            continue
        if not resolved.is_dir():
            fail(f"target does not exist: {resolved}", 2)
        candidates = git_visible(resolved) if visible_only else None
        if candidates is None:
            candidates = resolved.rglob("*")
        for candidate in candidates:
            if candidate.is_file() and candidate.suffix.casefold() in SUPPORTED:
                found.add(candidate.resolve())
    return sorted(found)


def scan(path: Path) -> list[dict[str, str | int]]:
    language = SUPPORTED.get(path.suffix.casefold())
    if language is None:
        return []
    try:
        source = path.read_text()
    except (OSError, UnicodeDecodeError):
        return []
    if path.suffix.casefold() in {".py", ".pyi"}:
        return python_comments(path, source) + python_docstrings(path, source)
    marker = "#" if language == "hash" else "//"
    return line_comments(path, source, marker)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Find empty, decorative, and historical comments or Python docstrings."
    )
    parser.add_argument("target", type=Path, nargs="+", default=[Path(".")])
    parser.add_argument("--git-visible", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--fail-on-findings", action="store_true")
    arguments = parser.parse_args()
    selected = paths(arguments.target, arguments.git_visible)
    findings = []
    for path in selected:
        findings.extend(scan(path))
    findings.sort(key=lambda item: (item["path"], item["line"], item["category"]))
    counts = Counter(item["category"] for item in findings)
    report = {
        "schema": "agency/comment-audit/1",
        "summary": {
            "files_scanned": len(selected),
            "findings": len(findings),
            "categories": dict(sorted(counts.items())),
        },
        "findings": findings,
    }
    if arguments.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        for item in findings:
            print(f"{item['path']}:{item['line']}:{item['category']}: {item['text']}")
        print(f"{len(selected)} file(s); {len(findings)} finding(s)")
    if arguments.fail_on_findings and findings:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
