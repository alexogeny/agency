#!/usr/bin/env python3

import argparse
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile


AUTH_SCRIPT = '''on run argv
    set commandText to item 1 of argv
    set promptText to item 2 of argv
    return do shell script commandText with administrator privileges with prompt promptText without altering line endings
end run
'''
DEFAULT_PROMPT = "Administrator authorization is required for the approved Agency task."


def sudo_arguments(arguments):
    if arguments[:1] == ["--"]:
        arguments = arguments[1:]
    if not arguments or arguments[0].startswith("-") or "=" in arguments[0]:
        raise ValueError(
            "On macOS, pass sudo COMMAND [ARG...]; sudo flags, identity changes, "
            "and timestamp-only authorization are unsupported"
        )
    return arguments


def shell_command(arguments):
    environment = [
        "/usr/bin/env", "-i", "HOME=/var/root", "USER=root", "LOGNAME=root",
        "PATH=" + os.environ.get("PATH", "/usr/bin:/bin:/usr/sbin:/sbin"),
    ]
    return "cd " + shlex.quote(os.getcwd()) + " && exec " + shlex.join([*environment, *arguments])


def authorize(arguments, prompt):
    result = subprocess.run(
        ["/usr/bin/osascript", "-", shell_command(arguments), prompt],
        input=AUTH_SCRIPT, text=True, capture_output=True,
    )
    if result.stdout:
        sys.stdout.write(result.stdout)
    if result.returncode == 0:
        return 0
    match = re.search(r"\((-?\d+)\)\s*$", result.stderr)
    number = int(match[1]) if match else result.returncode
    if number == -128:
        print("sudo-gui: administrator authorization was cancelled; no retry attempted.", file=sys.stderr)
        return 130
    if result.stderr:
        sys.stderr.write(result.stderr)
    print("sudo-gui: authorization or the approved command failed; no retry attempted.", file=sys.stderr)
    return number if 1 <= number <= 255 else 1


def proxy(arguments, prompt):
    failure_path = os.environ.get("SUDO_GUI_FAILURE_FILE")
    failure = Path(failure_path) if failure_path else None
    if failure and failure.exists():
        print("sudo-gui: the workflow already failed or was cancelled; refusing another authorization attempt.", file=sys.stderr)
        return int(failure.read_text())
    result = authorize(sudo_arguments(arguments), prompt)
    if result and failure:
        failure.write_text(str(result))
    return result


def workflow(arguments, prompt):
    with tempfile.TemporaryDirectory(prefix="agency-sudo-gui-") as temporary:
        root = Path(temporary)
        (root / "sudo").symlink_to(Path(__file__).resolve().with_name("sudo-gui"))
        failure = root / "failure"
        environment = {
            **os.environ,
            "PATH": str(root) + os.pathsep + os.environ.get("PATH", "/usr/bin:/bin"),
            "SUDO_GUI_PROXY_MODE": "1",
            "SUDO_GUI_PROMPT": prompt,
            "SUDO_GUI_FAILURE_FILE": str(failure),
        }
        result = subprocess.run(arguments, env=environment)
        return int(failure.read_text()) if failure.exists() else result.returncode


def main(argv=None):
    arguments = sys.argv[1:] if argv is None else argv
    try:
        if os.environ.get("SUDO_GUI_PROXY_MODE") == "1":
            return proxy(arguments, os.environ.get("SUDO_GUI_PROMPT", DEFAULT_PROMPT))
        parser = argparse.ArgumentParser(
            description="Authorize a macOS command with the native administrator dialog; macOS controls its wording."
        )
        parser.add_argument("--prompt", default=DEFAULT_PROMPT)
        parser.add_argument("--dry-run", action="store_true", help="Preview without requesting administrator authorization")
        parser.add_argument("command", nargs=argparse.REMAINDER)
        args = parser.parse_args(arguments)
        command = args.command[1:] if args.command[:1] == ["--"] else args.command
        if not command:
            parser.error(
                "Pass the approved command; native authorization does not create "
                "a sudo timestamp for later commands"
            )
        direct = Path(command[0]).name == "sudo"
        if direct:
            command = sudo_arguments(command[1:])
        if args.dry_run:
            print(json.dumps({
                "mode": "native-administrator" if direct else "user-workflow-with-sudo-proxy",
                "command": command, "prompt": args.prompt,
            }, indent=2))
            return 0
        if sys.platform != "darwin":
            raise ValueError("This authorization backend requires macOS")
        return authorize(command, args.prompt) if direct else workflow(command, args.prompt)
    except (OSError, ValueError) as error:
        print(f"sudo-gui: {error}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
