#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path


def fail(message: str, status: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(status)


def required_command(name: str) -> str:
    path = shutil.which(name)
    if path is None:
        fail(f"required command is unavailable: {name}", 2)
    return path


def digest(path: Path) -> str:
    value = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            value.update(chunk)
    return value.hexdigest()


def page_selection(value: str | None, total: int) -> tuple[int, int]:
    if value is None:
        return 1, total
    match = re.fullmatch(r"([1-9][0-9]*)(?:-([1-9][0-9]*))?", value)
    if match is None:
        fail("--pages must be FIRST or FIRST-LAST", 2)
    first = int(match.group(1))
    last = int(match.group(2) or first)
    if first > last or last > total:
        fail(f"--pages {value} is outside the document's 1-{total} page range", 2)
    return first, last


def pdf_metadata(path: Path) -> dict[str, str | int]:
    result = subprocess.run(
        [required_command("pdfinfo"), str(path)],
        check=False,
        text=True,
        capture_output=True,
    )
    if result.returncode:
        fail(result.stderr.strip() or "pdfinfo could not read the document")
    metadata: dict[str, str | int] = {}
    for line in result.stdout.splitlines():
        key, separator, value = line.partition(":")
        if separator:
            metadata[key.strip().lower().replace(" ", "_")] = value.strip()
    pages = metadata.get("pages")
    if not isinstance(pages, str) or not pages.isdigit() or int(pages) < 1:
        fail("pdfinfo returned no valid page count")
    metadata["pages"] = int(pages)
    return metadata


def prepare_output(path: Path) -> None:
    if path.exists():
        if not path.is_dir():
            fail(f"output is not a directory: {path}", 2)
        if any(path.iterdir()):
            fail(f"output directory is not empty: {path}", 2)
    path.mkdir(parents=True, exist_ok=True)


def render_pages(
    document: Path, output: Path, first: int, last: int, dpi: int
) -> list[tuple[int, Path]]:
    pages = output / "pages"
    pages.mkdir()
    prefix = pages / "page"
    result = subprocess.run(
        [
            required_command("pdftoppm"),
            "-png",
            "-r",
            str(dpi),
            "-f",
            str(first),
            "-l",
            str(last),
            str(document),
            str(prefix),
        ],
        check=False,
        text=True,
        capture_output=True,
    )
    if result.returncode:
        fail(result.stderr.strip() or "pdftoppm could not render the document")
    found = []
    for path in pages.glob("page-*.png"):
        match = re.fullmatch(r"page-([0-9]+)\.png", path.name)
        if match:
            found.append((int(match.group(1)), path))
    found.sort()
    expected = list(range(first, last + 1))
    if [number for number, _ in found] != expected:
        fail(f"pdftoppm rendered unexpected pages: {[number for number, _ in found]}")
    normalised = []
    for number, path in found:
        target = pages / f"page-{number:04d}.png"
        path.rename(target)
        normalised.append((number, target))
    return normalised


def extract_text(document: Path, destination: Path, first: int, last: int) -> None:
    result = subprocess.run(
        [
            required_command("pdftotext"),
            "-f",
            str(first),
            "-l",
            str(last),
            "-layout",
            str(document),
            str(destination),
        ],
        check=False,
        text=True,
        capture_output=True,
    )
    if result.returncode:
        fail(result.stderr.strip() or "pdftotext could not extract the document")


def make_contact_sheet(pages: list[tuple[int, Path]], destination: Path) -> None:
    result = subprocess.run(
        [
            required_command("montage"),
            *[str(path) for _, path in pages],
            "-thumbnail",
            "320x",
            "-tile",
            "4x",
            "-geometry",
            "+12+12",
            str(destination),
        ],
        check=False,
        text=True,
        capture_output=True,
    )
    if result.returncode:
        fail(result.stderr.strip() or "montage could not build the contact sheet")


def extract_ocr(
    pages: list[tuple[int, Path]], destination: Path, language: str
) -> None:
    command = required_command("tesseract")
    page_text = []
    for number, page in pages:
        result = subprocess.run(
            [command, str(page), "stdout", "-l", language],
            check=False,
            text=True,
            capture_output=True,
        )
        if result.returncode:
            fail(result.stderr.strip() or f"tesseract failed on page {number}")
        page_text.append(result.stdout.rstrip())
    destination.write_text("\n\f\n".join(page_text) + "\n")


def relative_artifact(path: Path, root: Path) -> dict[str, str | int]:
    return {
        "path": str(path.relative_to(root)),
        "bytes": path.stat().st_size,
        "sha256": digest(path),
    }


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Render, extract, and inventory a PDF for visual inspection."
    )
    parser.add_argument("document", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--pages")
    parser.add_argument("--dpi", type=int, default=144)
    parser.add_argument("--ocr", action="store_true")
    parser.add_argument("--language", default="eng")
    parser.add_argument("--json", action="store_true")
    arguments = parser.parse_args()
    document = arguments.document.resolve()
    output = arguments.output.resolve()
    if not document.is_file():
        fail(f"document does not exist: {document}", 2)
    if arguments.dpi < 36 or arguments.dpi > 600:
        fail("--dpi must be between 36 and 600", 2)
    prepare_output(output)
    metadata = pdf_metadata(document)
    first, last = page_selection(arguments.pages, int(metadata["pages"]))
    pages = render_pages(document, output, first, last, arguments.dpi)
    text_path = output / "document.txt"
    contact_path = output / "contact-sheet.png"
    extract_text(document, text_path, first, last)
    make_contact_sheet(pages, contact_path)
    artifacts = {
        "text": relative_artifact(text_path, output),
        "contact_sheet": relative_artifact(contact_path, output),
    }
    if arguments.ocr:
        ocr_path = output / "ocr.txt"
        extract_ocr(pages, ocr_path, arguments.language)
        artifacts["ocr"] = relative_artifact(ocr_path, output)
    manifest = {
        "schema": "agency/document-inspection/1",
        "document": {
            "path": str(document),
            "bytes": document.stat().st_size,
            "sha256": digest(document),
            **metadata,
        },
        "selection": {"first": first, "last": last, "dpi": arguments.dpi},
        "page_images": [
            {"number": number, **relative_artifact(path, output)}
            for number, path in pages
        ],
        "artifacts": artifacts,
    }
    encoded = json.dumps(manifest, indent=2, sort_keys=True) + "\n"
    (output / "manifest.json").write_text(encoded)
    if arguments.json:
        print(encoded, end="")
    else:
        print(f"Inspected {last - first + 1} page(s) into {output}")


if __name__ == "__main__":
    main()
