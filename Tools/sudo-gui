#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: sudo-gui [--prompt TEXT] [-- COMMAND [ARG...]]

Run COMMAND with a one-attempt KDE askpass helper available to sudo. Direct
sudo commands authenticate in that same sudo invocation. On cancellation,
failure, or active PAM lockout, stop without retrying.
EOF
}

config_value() {
  local key=$1
  local fallback=$2
  local config=$3
  local value
  value=$(awk -F= -v key="$key" '
    /^[[:space:]]*#/ { next }
    {
      name=$1
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
      if (name == key) {
        value=$2
        sub(/[[:space:]]*#.*/, "", value)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        print value
      }
    }
  ' "$config" 2>/dev/null | tail -n 1)
  printf '%s\n' "${value:-$fallback}"
}

active_lock_remaining() {
  local faillock=$1
  local config=$2
  local user=$3
  local deny unlock_time count=0 last_failure=0
  local day time rest epoch now
  deny=$(config_value deny 3 "$config")
  unlock_time=$(config_value unlock_time 600 "$config")
  now=$(date +%s)

  while read -r day time rest; do
    [[ $day =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || continue
    [[ $time =~ ^[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] || continue
    [[ $rest =~ [[:space:]]V$ ]] || continue
    epoch=$(date -d "$day $time" +%s 2>/dev/null || true)
    [[ -n $epoch ]] || continue
    (( count += 1 ))
    (( epoch <= last_failure )) || last_failure=$epoch
  done < <("$faillock" --user "$user" 2>/dev/null || true)

  (( count >= deny )) || return 1
  if (( unlock_time == 0 )); then
    printf 'indefinite\n'
    return
  fi
  (( now - last_failure < unlock_time )) || return 1
  printf '%d\n' "$(( unlock_time - (now - last_failure) ))"
}

write_state() {
  local state=$1
  printf '%s\n' "$state" > "$SUDO_GUI_STATE_DIR/status"
}

sudo_command=${SUDO_GUI_SUDO:-sudo}
kdialog_command=${SUDO_GUI_KDIALOG:-kdialog}
faillock_command=${SUDO_GUI_FAILLOCK:-faillock}
faillock_config=${SUDO_GUI_FAILLOCK_CONFIG:-/etc/security/faillock.conf}

if [[ ${SUDO_GUI_PROXY_MODE:-} == 1 && ${0##*/} == sudo ]]; then
  exec "$SUDO_GUI_SUDO_REAL" -A "$@"
fi

if [[ ${SUDO_GUI_ASKPASS_MODE:-} == 1 ]]; then
  command -v "$kdialog_command" >/dev/null || {
    write_state unavailable
    printf 'KDE kdialog is unavailable; use sudo in a visible terminal.\n' >&2
    exit 1
  }

  user=$(id -un)
  if command -v "$faillock_command" >/dev/null; then
    if remaining=$(active_lock_remaining \
      "$faillock_command" "$faillock_config" "$user"); then
      write_state locked
      if [[ $remaining == indefinite ]]; then
        message="sudo authentication is locked until an administrator resets faillock."
      else
        message="sudo authentication is locked for about $remaining more seconds."
      fi
      printf '%s Do not retry yet.\n' "$message" >&2
      exit 1
    fi
  fi

  if ! mkdir "$SUDO_GUI_STATE_DIR/prompt-attempted" 2>/dev/null; then
    printf 'sudo-gui permits only one password attempt; not retrying.\n' >&2
    exit 1
  fi

  password=""
  if ! password=$("$kdialog_command" \
    --title "Administrator authorization" \
    --password "$SUDO_GUI_PROMPT"); then
    password=""
    unset password
    write_state cancelled
    printf 'sudo authorization was cancelled.\n' >&2
    exit 1
  fi

  if [[ -z $password ]]; then
    unset password
    write_state cancelled
    printf 'sudo authorization was cancelled before a password was entered.\n' >&2
    exit 1
  fi

  write_state provided
  printf '%s\n' "$password"
  password=""
  unset password
  exit
fi

prompt="Administrator authorization is required for the approved task."
while (( $# )); do
  case $1 in
    --prompt)
      (( $# >= 2 )) || { usage >&2; exit 2; }
      prompt=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    --help|-h)
      usage
      exit
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

if (( EUID == 0 )); then
  if (( $# )); then
    exec "$@"
  fi
  printf 'sudo authorization is unnecessary for the root user.\n'
  exit
fi

if [[ $sudo_command == */* ]]; then
  sudo_executable=$sudo_command
else
  sudo_executable=$(command -v "$sudo_command" 2>/dev/null) || {
    printf 'sudo is unavailable.\n' >&2
    exit 69
  }
fi

runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
state_dir=$(mktemp -d "$runtime_dir/sudo-gui.XXXXXX") || {
  printf 'sudo-gui could not create its private runtime directory.\n' >&2
  exit 69
}
chmod 0700 "$state_dir"

cleanup() {
  rm -f "$state_dir/sudo"
  rm -f "$state_dir/status"
  rmdir "$state_dir/prompt-attempted" 2>/dev/null || true
  rmdir "$state_dir" 2>/dev/null || true
}
trap cleanup EXIT

self_path=$(readlink -f -- "${BASH_SOURCE[0]}")
export SUDO_ASKPASS="$self_path"
export SUDO_GUI_ASKPASS_MODE=1
export SUDO_GUI_PROMPT="$prompt"
export SUDO_GUI_STATE_DIR="$state_dir"
export SUDO_GUI_SUDO_REAL="$sudo_executable"

status=0
if (( $# == 0 )); then
  "$sudo_executable" -A -p '' -v || status=$?
elif [[ ${1##*/} == sudo ]]; then
  requested_sudo=$1
  shift
  "$requested_sudo" -A "$@" || status=$?
else
  ln -s "$self_path" "$state_dir/sudo"
  export SUDO_GUI_PROXY_MODE=1
  PATH="$state_dir:$PATH" "$@" || status=$?
fi

state=""
[[ ! -f $state_dir/status ]] || state=$(<"$state_dir/status")
case $state in
  unavailable) exit 69 ;;
  locked) exit 75 ;;
  cancelled) exit 130 ;;
  provided)
    if (( status != 0 )); then
      printf 'sudo authorization or the approved command failed; no retry was attempted.\n' >&2
    fi
    ;;
esac

if (( $# == 0 )) && (( status == 0 )); then
  printf 'sudo authorization is available in this process context.\n'
fi
exit "$status"
