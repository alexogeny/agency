function isObject(value: unknown): value is JsonObject {
  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
}

function responseBudget(value: unknown) {
  if (value === "long") return 30_000;
  if (value === "medium") return 12_000;
  return 4_500;
}

function searchLimit(value: unknown) {
  if (value === "long") return 20;
  if (value === "medium") return 10;
  return 5;
}

function compactText(value: string, maximum: number) {
  if (value.length <= maximum) return value;
  const marker = "\n\n[truncated to response_length; use open with lineno to continue]";
  return `${value.slice(0, Math.max(0, maximum - marker.length)).trimEnd()}${marker}`;
}

function checkedArray(value: unknown, name: string, maximum: number) {
  if (!Array.isArray(value) || !value.length || value.length > maximum) {
    throw new Error(`${name} must contain 1 to ${maximum} items`);
  }
  if (!value.every(isObject)) throw new Error(`${name} items must be objects`);
  return value as JsonObject[];
}

function checkedString(value: unknown, name: string, maximum: number) {
  if (typeof value !== "string" || !value.trim() || value.length > maximum) {
    throw new Error(`${name} must be a non-empty string of at most ${maximum} characters`);
  }
  return value.trim();
}

function checkedStrings(value: unknown, name: string) {
  if (value === undefined) return [];
  if (!Array.isArray(value) || value.length > 20) {
    throw new Error(`${name} must contain at most 20 hostnames`);
  }
  return value.map((item, index) => checkedString(item, `${name}[${index}]`, 253));
}

function checkedEvidence(value: unknown) {
  if (value === undefined) return "transient";
  if (!new Set(["transient", "index", "capture"]).has(String(value))) {
    throw new Error("evidence must be transient, index, or capture");
  }
  return String(value);
}

function checkedProfile(value: unknown) {
  if (value === undefined) return "";
  const profile = checkedString(value, "profile", 64);
  if (!/^[a-zA-Z0-9][a-zA-Z0-9._-]*$/.test(profile)) {
    throw new Error("profile contains unsupported characters");
  }
  return profile;
}

async function invoke(arguments_: string[], input = "") {
  const process_ = Bun.spawn([backend, ...arguments_], {
    stdin: input ? "pipe" : "ignore",
    stdout: "pipe",
    stderr: "pipe",
    env: process.env,
  });
  if (input) {
    process_.stdin.write(input);
    process_.stdin.end();
  }
  const [stdout, stderr, status] = await Promise.all([
    new Response(process_.stdout).text(),
    new Response(process_.stderr).text(),
    process_.exited,
  ]);
  if (status !== 0) {
    throw new Error(stderr.trim() || `web-research exited with status ${status}`);
  }
  try {
    return JSON.parse(stdout) as JsonObject;
  } catch {
    throw new Error("web-research returned invalid JSON");
  }
}

function addSearchReference(result: JsonObject) {
  const ref_id = `agency_search_${nextSearchReference++}`;
  const score = Number(result.score);
  const resultSources = Array.isArray(result.sources)
    ? result.sources.filter(isObject)
    : [];
  const index_snapshot: IndexSnapshot = {
    type: "index_snapshot",
    source_id: ref_id,
    title: String(result.title || ""),
    url: String(result.url || ""),
    snippet: String(result.snippet || ""),
    evidence_strength: "discovery",
    page_verified: false,
    ...(Number.isFinite(score) ? { score } : {}),
    ...(resultSources.length ? { sources: resultSources } : {}),
  };
  const reference: SearchReference = {
    kind: "search",
    ref_id,
    title: index_snapshot.title,
    url: index_snapshot.url,
    snippet: index_snapshot.snippet,
    index_snapshot,
  };
  references.set(ref_id, reference);
  return reference;
}

function addPageReference(page: JsonObject, evidence = "transient") {
  const url = String(page.canonicalUrl || page.url || "");
  const cached = pageReferences.get(url);
  if (cached) {
    cached.page = page;
    cached.title = String(page.title || url);
    cached.evidence.add(evidence);
    return cached;
  }
  const ref_id = `agency_page_${nextPageReference++}`;
  const reference: PageReference = {
    kind: "page",
    ref_id,
    title: String(page.title || url),
    url,
    page,
    evidence: new Set([evidence]),
  };
  references.set(ref_id, reference);
  pageReferences.set(url, reference);
  return reference;
}

function resolvedUrl(value: string) {
  const reference = references.get(value);
  if (reference) return reference.url;
  try {
    const url = new URL(value);
    if (!new Set(["http:", "https:"]).has(url.protocol)) throw new Error();
    return url.href;
  } catch {
    throw new Error(`unknown source reference: ${value}`);
  }
}

function hasEvidence(reference: PageReference, evidence: string) {
  return evidence === "transient" || reference.evidence.has(evidence);
}

function isFreshReference(reference: PageReference) {
  const freshness = reference.page.freshness;
  if (!isObject(freshness)) return true;
  if (freshness.change_likelihood === "immutable") return true;
  return (
    typeof freshness.refresh_after === "string" &&
    Date.parse(freshness.refresh_after) > Date.now()
  );
}

async function loadPage(value: string, evidence: string, profile: string) {
  const existing = references.get(value);
  if (
    existing?.kind === "page" &&
    hasEvidence(existing, evidence) &&
    isFreshReference(existing)
  ) return existing;
  const url = resolvedUrl(value);
  const cached = pageReferences.get(url);
  if (cached && hasEvidence(cached, evidence) && isFreshReference(cached)) {
    return cached;
  }
  const arguments_ = [
    "scrape",
    url,
    "--format",
    "json",
    "--preflight",
    "--max-content-chars",
    "500000",
    "--max-links",
    "500",
  ];
  if (evidence === "index") arguments_.push("--index");
  if (evidence === "capture") arguments_.push("--capture");
  if (profile) arguments_.push("--profile", profile);
  const reference = addPageReference(await invoke(arguments_), evidence);
  pageReferences.set(url, reference);
  return reference;
}

function pageLoadError(url: string, error: unknown): PageLoadError {
  const message = error instanceof Error ? error.message : String(error);
  let kind = "retrieval";
  let code = "page-load-failed";
  let retriable = true;
  if (/interactive challenge required/i.test(message)) {
    kind = "access";
    code = "interactive-challenge-required";
    retriable = false;
  } else if (/interactive login required/i.test(message)) {
    kind = "access";
    code = "interactive-login-required";
    retriable = false;
  } else if (/rate limit/i.test(message)) {
    kind = "network";
    code = "rate-limited";
  } else if (/invalid JSON|invalid scrape batch|invalid page result/i.test(message)) {
    kind = "backend";
    code = "invalid-backend-response";
  }
  return {
    kind: "error",
    url,
    error: { kind, code, message, retriable },
  };
}

async function loadPageResult(url: string, evidence: string, profile: string) {
  try {
    const reference = await loadPage(url, evidence, profile);
    pageReferences.set(url, reference);
    return reference as PageLoadResult;
  } catch (error) {
    return pageLoadError(url, error);
  }
}

async function loadPages(values: string[], evidence: string, profile: string) {
  const resolved = values.map((value) => {
    const existing = references.get(value);
    if (
      existing?.kind === "page" &&
      hasEvidence(existing, evidence) &&
      isFreshReference(existing)
    ) return { reference: existing, url: existing.url };
    const url = resolvedUrl(value);
    const cached = pageReferences.get(url);
    if (cached && hasEvidence(cached, evidence) && isFreshReference(cached)) {
      return { reference: cached, url };
    }
    return {
      url,
      ...(existing?.kind === "search"
        ? { index_snapshot: existing.index_snapshot }
        : {}),
    };
  });
  const missing = [...new Set(
    resolved.filter((item) => !item.reference).map((item) => item.url),
  )];
  const failures = new Map<string, PageLoadError>();
  if (missing.length === 1) {
    const result = await loadPageResult(missing[0], evidence, profile);
    if (result.kind === "error") failures.set(missing[0], result);
  } else if (missing.length > 1) {
    for (let offset = 0; offset < missing.length; offset += pageBatchSize) {
      const batch = missing.slice(offset, offset + pageBatchSize);
      const arguments_ = ["scrape-many"];
      if (evidence === "index") arguments_.push("--index");
      if (evidence === "capture") arguments_.push("--capture");
      if (profile) arguments_.push("--profile", profile);
      try {
        const outcome = await invoke(
          arguments_,
          JSON.stringify({ urls: batch }),
        );
        if (!Array.isArray(outcome.pages) || outcome.pages.length !== batch.length) {
          throw new Error("web-research returned an invalid scrape batch");
        }
        for (const [index, page] of outcome.pages.entries()) {
          if (!isObject(page)) {
            throw new Error("web-research returned an invalid page result");
          }
          const url = batch[index];
          if (isObject(page.error)) {
            failures.set(url, { kind: "error", url, error: page.error });
            continue;
          }
          const reference = addPageReference(page, evidence);
          pageReferences.set(url, reference);
        }
      } catch {
        for (const url of batch) {
          const result = await loadPageResult(url, evidence, profile);
          if (result.kind === "error") failures.set(url, result);
        }
      }
    }
  }
  return resolved.map((item) => {
    const reference = item.reference || pageReferences.get(item.url);
    if (!reference) {
      const failure = failures.get(item.url);
      if (failure) {
        return {
          ...failure,
          ...(item.index_snapshot
            ? { index_snapshot: item.index_snapshot }
            : {}),
        };
      }
      throw new Error(`page was not loaded: ${item.url}`);
    }
    return reference;
  }) as PageLoadResult[];
}

function requirePage(result: PageLoadResult) {
  if (result.kind === "page") return result;
  throw new Error(String(result.error.message || `page was not loaded: ${result.url}`));
}

function pageLines(reference: PageReference) {
  const markdown = String(reference.page.markdown || reference.page.text || "").trim();
  return markdown.split(/\r?\n/);
}

function pageRecord(reference: PageReference) {
  const links = Array.isArray(reference.page.links) ? reference.page.links : [];
  const jobs = Array.isArray(reference.page.jobs) ? reference.page.jobs : [];
  return {
    type: "page",
    ref_id: reference.ref_id,
    title: reference.title,
    url: reference.url,
    published: String(reference.page.published || ""),
    byline: String(reference.page.byline || ""),
    links: links.length,
    ...(jobs.length ? { jobs } : {}),
    sources: Array.isArray(reference.page.sources) ? reference.page.sources : [],
    ...(reference.page.capture_id ? { capture_id: reference.page.capture_id } : {}),
  };
}

function pageCitation(reference: PageReference) {
  const freshness = isObject(reference.page.freshness)
    ? reference.page.freshness
    : {};
  const content = String(reference.page.markdown || reference.page.text || "");
  return {
    source_id: reference.ref_id,
    title: reference.title,
    url: reference.url,
    published: String(reference.page.published || ""),
    retrieved_at: String(freshness.retrieved_at || freshness.indexed_at || ""),
    content_sha256: String(
      freshness.content_sha256 ||
        createHash("sha256").update(content).digest("hex"),
    ),
    change_likelihood: String(freshness.change_likelihood || "unknown"),
    refresh_after:
      freshness.refresh_after === null
        ? null
        : String(freshness.refresh_after || ""),
    retrieval: String(freshness.retrieval || "unknown"),
  };
}

function renderPage(reference: PageReference, lineno: number, budget: number) {
  const marker = "\n\n[truncated to response_length; use open with lineno to continue]";
  const maximum = Math.max(0, budget - marker.length);
  let rendered = "";
  let truncated = false;
  const append = (value: string) => {
    const remaining = maximum - rendered.length;
    if (value.length <= remaining) {
      rendered += value;
      return true;
    }
    rendered += value.slice(0, Math.max(0, remaining));
    truncated = true;
    return false;
  };
  append(`[${reference.ref_id}] ${reference.title}\n${reference.url}\n`);
  const links = Array.isArray(reference.page.links) ? reference.page.links : [];
  if (!truncated && links.length) {
    append("\nLinks\n");
    const linkBudget = Math.min(1_500, Math.floor(budget / 3));
    const linkStart = rendered.length;
    for (const [index, url] of links.slice(0, 100).entries()) {
      const value = `[${index + 1}] ${String(url)}\n`;
      if (rendered.length - linkStart + value.length > linkBudget) {
        append("[more links omitted]\n");
        break;
      }
      if (!append(value)) break;
    }
  }
  const jobs = Array.isArray(reference.page.jobs) ? reference.page.jobs : [];
  if (!truncated && jobs.length) {
    append("\nJobs\n");
    for (const [index, job] of jobs.slice(0, 50).entries()) {
      const details = [job.company, job.location, job.published || job.posting_age]
        .map(String)
        .filter(Boolean)
        .join(" · ");
      const value = `${index + 1}. ${String(job.title || "Untitled role")}\n   ${String(job.url || "")}${details ? `\n   ${details}` : ""}\n`;
      if (!append(value)) break;
    }
  }
  if (!truncated) append("\n");
  const content = String(reference.page.markdown || reference.page.text || "").trim();
  let cursor = 0;
  let currentLine = 1;
  let lastLine = 0;
  while (currentLine < lineno && cursor < content.length) {
    const separator = content.indexOf("\n", cursor);
    cursor = separator < 0 ? content.length : separator + 1;
    currentLine += 1;
  }
  while (!truncated && cursor <= content.length) {
    const separator = content.indexOf("\n", cursor);
    const end = separator < 0 ? content.length : separator;
    const complete = append(`${currentLine}: ${content.slice(cursor, end)}\n`);
    lastLine = currentLine;
    if (!complete) break;
    if (separator < 0) break;
    cursor = separator + 1;
    currentLine += 1;
  }
  return {
    text: truncated ? `${rendered.trimEnd()}${marker}` : rendered.trimEnd(),
    lineStart: lastLine ? lineno : 0,
    lineEnd: lastLine,
  };
}

async function performSearch(
  items: JsonObject[],
  responseLength: unknown,
  profile: string,
) {
  const searches = items.map((item, queryIndex) => {
    const query = checkedString(item.q, `search_query[${queryIndex}].q`, 1000);
    const domains = checkedStrings(item.domains, `search_query[${queryIndex}].domains`);
    const excluded = checkedStrings(
      item.exclude_domains,
      `search_query[${queryIndex}].exclude_domains`,
    );
    const strategy = item.strategy === undefined ? "federated" : String(item.strategy);
    if (!new Set(["first", "federated"]).has(strategy)) {
      throw new Error(`search_query[${queryIndex}].strategy must be first or federated`);
    }
    return {
      query,
      strategy,
      domains,
      excluded,
      limit: searchLimit(responseLength),
    };
  });
  const arguments_ = ["search-many"];
  if (profile) arguments_.push("--profile", profile);
  const batch = await invoke(arguments_, JSON.stringify({ searches }));
  if (!Array.isArray(batch.results) || batch.results.length !== searches.length) {
    throw new Error("web-research returned an invalid search batch");
  }
  const records: JsonObject[] = [];
  const rendered: string[] = [];
  for (const [queryIndex, outcome] of batch.results.entries()) {
    const { query, strategy } = searches[queryIndex];
    const results = (Array.isArray(outcome.results) ? outcome.results : []).map(
      (result: JsonObject) => {
        const reference = addSearchReference(result);
        return {
          ref_id: reference.ref_id,
          title: reference.title,
          url: reference.url,
          snippet: reference.snippet,
          ...(result.score === undefined ? {} : { score: result.score }),
          ...(Array.isArray(result.sources) ? { sources: result.sources } : {}),
        };
      },
    );
    const record = {
      type: "search",
      query,
      engine: outcome.engine,
      strategy: outcome.strategy || strategy,
      scope: outcome.scope,
      results,
      attempts: outcome.attempts,
    };
    records.push(record);
    rendered.push(
      [`Search: ${query}`, ...results.map((result: JsonObject, index: number) =>
        `${index + 1}. [${result.ref_id}] ${result.title}\n   ${result.url}${result.snippet ? `\n   ${result.snippet}` : ""}`,
      )].join("\n"),
    );
  }
  return { records, rendered };
}

async function performLocalSearch(items: JsonObject[], responseLength: unknown) {
  const records: JsonObject[] = [];
  const rendered: string[] = [];
  for (const [queryIndex, item] of items.entries()) {
    const query = checkedString(item.q, `local_query[${queryIndex}].q`, 1000);
    const outcome = await invoke([
      "local",
      query,
      "--limit",
      String(searchLimit(responseLength)),
      "--json",
    ]);
    const results = (Array.isArray(outcome.results) ? outcome.results : []).map(
      (result: JsonObject) => {
        const reference = addSearchReference(result);
        return {
          ref_id: reference.ref_id,
          title: reference.title,
          url: reference.url,
          snippet: reference.snippet,
          ...(result.score === undefined ? {} : { score: result.score }),
          ...(result.retrieved_at === undefined
            ? {}
            : { retrieved_at: result.retrieved_at }),
          ...(result.change_likelihood === undefined
            ? {}
            : { change_likelihood: result.change_likelihood }),
          ...(result.refresh_after === undefined
            ? {}
            : { refresh_after: result.refresh_after }),
          ...(result.content_sha256 === undefined
            ? {}
            : { content_sha256: result.content_sha256 }),
        };
      },
    );
    records.push({ type: "local", query, results });
    rendered.push(
      [`Local index: ${query}`, ...results.map((result: JsonObject, index: number) =>
        `${index + 1}. [${result.ref_id}] ${result.title}\n   ${result.url}${result.snippet ? `\n   ${result.snippet}` : ""}`,
      )].join("\n"),
    );
  }
  return { records, rendered };
}

async function performOpen(
  items: JsonObject[],
  evidence: string,
  profile: string,
  budget: number,
) {
  const requests = items.map((item, index) => {
    const refId = checkedString(item.ref_id, `open[${index}].ref_id`, 8192);
    const lineno = item.lineno === undefined ? 1 : Number(item.lineno);
    if (!Number.isInteger(lineno) || lineno < 1) {
      throw new Error(`open[${index}].lineno must be a positive integer`);
    }
    return { refId, lineno };
  });
  const pages = await loadPages(requests.map((item) => item.refId), evidence, profile);
  const records: JsonObject[] = [];
  const rendered: string[] = [];
  for (const [index, page] of pages.entries()) {
    const { lineno } = requests[index];
    if (page.kind === "error") {
      records.push({
        type: "page_error",
        url: page.url,
        error: page.error,
        ...(page.index_snapshot
          ? { index_snapshot: page.index_snapshot }
          : {}),
      });
      const lines = [
        `[page error] ${page.url}`,
        String(page.error.message || "page could not be loaded"),
      ];
      if (page.index_snapshot) {
        lines.push(
          `[index snapshot; not page-verified] ${page.index_snapshot.title}`,
          page.index_snapshot.url,
          page.index_snapshot.snippet,
        );
      }
      rendered.push(lines.filter(Boolean).join("\n"));
      continue;
    }
    const view = renderPage(page, lineno, budget);
    records.push({
      ...pageRecord(page),
      citation: {
        ...pageCitation(page),
        line_start: view.lineStart,
        line_end: view.lineEnd,
      },
    });
    rendered.push(view.text);
  }
  return { records, rendered };
}

async function performFind(
  items: JsonObject[],
  evidence: string,
  profile: string,
) {
  const requests = items.map((item, index) => ({
    refId: checkedString(item.ref_id, `find[${index}].ref_id`, 8192),
    pattern: checkedString(item.pattern, `find[${index}].pattern`, 500),
  }));
  const pages = await loadPages(requests.map((item) => item.refId), evidence, profile);
  const records: JsonObject[] = [];
  const rendered: string[] = [];
  for (const [index, result] of pages.entries()) {
    const page = requirePage(result);
    const { pattern } = requests[index];
    const needle = pattern.toLocaleLowerCase();
    const matches = pageLines(page)
      .map((line, lineIndex) => ({ line, lineno: lineIndex + 1 }))
      .filter(({ line }) => line.toLocaleLowerCase().includes(needle));
    records.push({
      type: "find",
      ref_id: page.ref_id,
      pattern,
      matches: matches.length,
      lines: matches.slice(0, 50).map(({ lineno }) => lineno),
      citation: {
        ...pageCitation(page),
        evidence_lines: matches.slice(0, 50).map(({ lineno }) => lineno),
      },
    });
    rendered.push(
      `[${page.ref_id}] ${pattern}: ${matches.length} match${matches.length === 1 ? "" : "es"}\n${matches.slice(0, 50).map(({ line, lineno }) => `${lineno}: ${line}`).join("\n")}`.trim(),
    );
  }
  return { records, rendered };
}

async function performClick(
  items: JsonObject[],
  evidence: string,
  profile: string,
  budget: number,
) {
  const requests = items.map((item, index) => {
    const refId = checkedString(item.ref_id, `click[${index}].ref_id`, 8192);
    const id = Number(item.id);
    if (!Number.isInteger(id) || id < 1) {
      throw new Error(`click[${index}].id must be a positive integer`);
    }
    return { refId, id };
  });
  const sources = await loadPages(requests.map((item) => item.refId), evidence, profile);
  const targets = sources.map((result, index) => {
    const source = requirePage(result);
    const { id } = requests[index];
    const links = Array.isArray(source.page.links) ? source.page.links : [];
    if (id > links.length) throw new Error(`[${source.ref_id}] has no link ${id}`);
    return checkedString(links[id - 1], "link URL", 8192);
  });
  const pages = (await loadPages(targets, evidence, profile)).map(requirePage);
  const records: JsonObject[] = [];
  const rendered: string[] = [];
  for (const page of pages) {
    const view = renderPage(page, 1, budget);
    records.push({
      ...pageRecord(page),
      citation: {
        ...pageCitation(page),
        line_start: view.lineStart,
        line_end: view.lineEnd,
      },
    });
    rendered.push(view.text);
  }
  return { records, rendered };
}

async function performReplay(items: JsonObject[], budget: number) {
  const records: JsonObject[] = [];
  const rendered: string[] = [];
  for (const [index, item] of items.entries()) {
    const captureId = checkedString(item.capture_id, `replay[${index}].capture_id`, 200);
    const page = addPageReference(
      await invoke(["replay", captureId, "--json"]),
      "capture",
    );
    const view = renderPage(page, 1, budget);
    records.push({
      ...pageRecord(page),
      citation: {
        ...pageCitation(page),
        line_start: view.lineStart,
        line_end: view.lineEnd,
      },
    });
    rendered.push(view.text);
  }
  return { records, rendered };
}

function sourceLedger(records: JsonObject[]) {
  const sources = new Map<string, JsonObject>();
  for (const record of records) {
    if (isObject(record.index_snapshot)) {
      const id = String(record.index_snapshot.source_id || "");
      if (id) sources.set(id, record.index_snapshot);
    }
    if (!isObject(record.citation)) continue;
    const {
      line_start: _lineStart,
      line_end: _lineEnd,
      evidence_lines: _evidenceLines,
      ...source
    } = record.citation;
    const id = String(source.source_id || "");
    if (id) sources.set(id, source);
  }
  return [...sources.values()];
}

async function callRun(arguments_: unknown) {
  if (!isObject(arguments_)) throw new Error("run arguments must be an object");
  const known = new Set([
    "search_query",
    "local_query",
    "open",
    "find",
    "click",
    "replay",
    "response_length",
    "evidence",
    "profile",
  ]);
  const unknown = Object.keys(arguments_).find((key) => !known.has(key));
  if (unknown) throw new Error(`unknown run argument: ${unknown}`);
  const responseLength = arguments_.response_length || "short";
  if (!new Set(["short", "medium", "long"]).has(String(responseLength))) {
    throw new Error("response_length must be short, medium, or long");
  }
  const evidence = checkedEvidence(arguments_.evidence);
  const profile = checkedProfile(arguments_.profile);
  const budget = responseBudget(responseLength);
  const records: JsonObject[] = [];
  const rendered: string[] = [];
  if (arguments_.search_query !== undefined) {
    const result = await performSearch(
      checkedArray(arguments_.search_query, "search_query", 4),
      responseLength,
      profile,
    );
    records.push(...result.records);
    rendered.push(...result.rendered);
  }
  if (arguments_.local_query !== undefined) {
    const result = await performLocalSearch(
      checkedArray(arguments_.local_query, "local_query", 4),
      responseLength,
    );
    records.push(...result.records);
    rendered.push(...result.rendered);
  }
  if (arguments_.open !== undefined) {
    const result = await performOpen(
      checkedArray(arguments_.open, "open", 10),
      evidence,
      profile,
      budget,
    );
    records.push(...result.records);
    rendered.push(...result.rendered);
  }
  if (arguments_.find !== undefined) {
    const result = await performFind(
      checkedArray(arguments_.find, "find", 10),
      evidence,
      profile,
    );
    records.push(...result.records);
    rendered.push(...result.rendered);
  }
  if (arguments_.click !== undefined) {
    const result = await performClick(
      checkedArray(arguments_.click, "click", 10),
      evidence,
      profile,
      budget,
    );
    records.push(...result.records);
    rendered.push(...result.rendered);
  }
  if (arguments_.replay !== undefined) {
    const result = await performReplay(
      checkedArray(arguments_.replay, "replay", 10),
      budget,
    );
    records.push(...result.records);
    rendered.push(...result.rendered);
  }
  if (!records.length) {
    throw new Error("run requires search_query, local_query, open, find, click, or replay");
  }
  return {
    content: [{ type: "text", text: compactText(rendered.join("\n\n"), budget) }],
    structuredContent: {
      schema: "agency/web-tool-result/1",
      results: records,
      sources: sourceLedger(records),
    },
  };
}

function write(message: JsonObject) {
  process.stdout.write(`${JSON.stringify(message)}\n`);
}

function protocolError(id: unknown, code: number, message: string) {
  write({ jsonrpc: "2.0", id: id ?? null, error: { code, message } });
}

async function handle(message: unknown) {
  if (!isObject(message) || message.jsonrpc !== "2.0" || typeof message.method !== "string") {
    protocolError(isObject(message) ? message.id : null, -32600, "Invalid Request");
    return;
  }
  if (message.id === undefined) return;
  if (message.method === "initialize") {
    const requested = isObject(message.params) ? message.params.protocolVersion : undefined;
    write({
      jsonrpc: "2.0",
      id: message.id,
      result: {
        protocolVersion: typeof requested === "string" ? requested : "2025-06-18",
        capabilities: { tools: { listChanged: false } },
        serverInfo: { name: "agency-web", version: "1.0.0" },
        instructions:
          "Prefer agency-web for substantive web research. Search snippets and index_snapshot records are discovery only: open candidate sources before relying on them. Cite page-verified direct URLs from structuredContent.sources and verify claims against each result's displayed or matching citation lines. URL opens automatically reuse fresh indexed text and refresh stale pages. Use local_query for indexed discovery and replay for a capture ID.",
      },
    });
    return;
  }
  if (message.method === "ping") {
    write({ jsonrpc: "2.0", id: message.id, result: {} });
    return;
  }
  if (message.method === "tools/list") {
    write({ jsonrpc: "2.0", id: message.id, result: { tools: [runTool] } });
    return;
  }
  if (message.method === "tools/call") {
    if (!isObject(message.params) || message.params.name !== "run") {
      protocolError(message.id, -32602, "Unknown tool");
      return;
    }
    try {
      const result = await callRun(message.params.arguments);
      write({ jsonrpc: "2.0", id: message.id, result });
    } catch (error) {
      write({
        jsonrpc: "2.0",
        id: message.id,
        result: {
          content: [{ type: "text", text: error instanceof Error ? error.message : String(error) }],
          isError: true,
        },
      });
    }
    return;
  }
  protocolError(message.id, -32601, "Method not found");
}

let inputBuffer = "";
let processing = Promise.resolve();
process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk: string) => {
  inputBuffer += chunk;
  while (inputBuffer.includes("\n")) {
    const separator = inputBuffer.indexOf("\n");
    const line = inputBuffer.slice(0, separator).trim();
    inputBuffer = inputBuffer.slice(separator + 1);
    if (!line) continue;
    processing = processing.then(async () => {
      try {
        await handle(JSON.parse(line));
      } catch {
        protocolError(null, -32700, "Parse error");
      }
    });
  }
});
process.stdin.resume();
