type JsonObject = Record<string, any>;
type SearchReference = {
  kind: "search";
  ref_id: string;
  title: string;
  url: string;
  snippet: string;
  index_snapshot: IndexSnapshot;
};
type IndexSnapshot = {
  type: "index_snapshot";
  source_id: string;
  title: string;
  url: string;
  snippet: string;
  evidence_strength: "discovery";
  page_verified: false;
  score?: number;
  sources?: JsonObject[];
};
type PageReference = {
  kind: "page";
  ref_id: string;
  title: string;
  url: string;
  page: JsonObject;
  evidence: Set<string>;
};
type PageLoadError = {
  kind: "error";
  url: string;
  error: JsonObject;
  index_snapshot?: IndexSnapshot;
};
type PageLoadResult = PageReference | PageLoadError;
type Reference = SearchReference | PageReference;

const pageBatchSize = 4;
const backend = process.env.WEB_RESEARCH_COMMAND || join(import.meta.dir, "web-research");
const referenceByteBudget = 8 * 1024 * 1024;
let referenceDirectory = "";
function referencePath(key: string) {
  if (!referenceDirectory) referenceDirectory = mkdtempSync(join(tmpdir(), "agency-web-references-"));
  return join(referenceDirectory, createHash("sha256").update(key).digest("hex"));
}
process.on("exit", () => { if (referenceDirectory) rmSync(referenceDirectory, { recursive: true, force: true }); });

// Evicted handles remain reloadable for this MCP session, including transient evidence.
class ReferenceStore<T> {
  private entries = new Map<string, { value: T; bytes: number }>();
  retainedBytes = 0;
  constructor(private budget: number, private encode: (value: T) => unknown,
    private decode: (value: any) => T, private prefix: string) {}
  get size() { return this.entries.size; }
  get(key: string): T | undefined {
    const cached = this.entries.get(key);
    if (cached) {
      this.entries.delete(key);
      this.entries.set(key, cached);
      return cached.value;
    }
    if (!referenceDirectory) return undefined;
    const path = referencePath(this.prefix + key);
    if (!existsSync(path)) return undefined;
    const serialized = readFileSync(path, "utf8");
    const value = this.decode(JSON.parse(serialized));
    this.retain(key, value, Buffer.byteLength(serialized) * 2 + Buffer.byteLength(key) * 2 + 512);
    return value;
  }
  private retain(key: string, value: T, bytes: number) {
    const previous = this.entries.get(key);
    if (previous) { this.retainedBytes -= previous.bytes; this.entries.delete(key); }
    if (bytes > this.budget) { this.spill(key, value); return; }
    this.entries.set(key, { value, bytes });
    this.retainedBytes += bytes;
    while (this.retainedBytes > this.budget || this.entries.size > 4096) {
      const oldest = this.entries.entries().next().value!;
      this.spill(oldest[0], oldest[1].value);
      this.retainedBytes -= oldest[1].bytes;
      this.entries.delete(oldest[0]);
    }
  }
  private spill(key: string, value: T) {
    writeFileSync(referencePath(this.prefix + key), JSON.stringify(this.encode(value)), { mode: 0o600 });
  }
  set(key: string, value: T) {
    const serialized = JSON.stringify(this.encode(value));
    this.retain(key, value, Buffer.byteLength(serialized) * 2 + Buffer.byteLength(key) * 2 + 512);
    return this;
  }
}
const references = new ReferenceStore<Reference>(referenceByteBudget,
  value => value.kind === "page" ? { ...value, evidence: [...value.evidence] } : value,
  value => value.kind === "page" ? { ...value, evidence: new Set(value.evidence) } : value, "reference:");
// Aliases store handles only, so pages are retained in just one cache.
const pageAliases = new ReferenceStore<string>(64 * 1024, value => value, value => value, "url:");
const pageReferences = {
  get size() { return pageAliases.size; },
  get(url: string) { const id = pageAliases.get(url); return id ? references.get(id) as PageReference : undefined; },
  set(url: string, reference: PageReference) { pageAliases.set(url, reference.ref_id); },
};
