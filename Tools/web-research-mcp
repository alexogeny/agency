#!/usr/bin/env bun

import { createHash } from "node:crypto";
import { join } from "node:path";

type JsonObject = Record<string, any>;
type SearchReference = {
  kind: "search";
  ref_id: string;
  title: string;
  url: string;
  snippet: string;
  index_snapshot: IndexSnapshot;
};
type IndexSnapshot = {
  type: "index_snapshot";
  source_id: string;
  title: string;
  url: string;
  snippet: string;
  evidence_strength: "discovery";
  page_verified: false;
  score?: number;
  sources?: JsonObject[];
};
type PageReference = {
  kind: "page";
  ref_id: string;
  title: string;
  url: string;
  page: JsonObject;
  evidence: Set<string>;
};
type PageLoadError = {
  kind: "error";
  url: string;
  error: JsonObject;
  index_snapshot?: IndexSnapshot;
};
type PageLoadResult = PageReference | PageLoadError;
type Reference = SearchReference | PageReference;

const pageBatchSize = 4;
const backend = process.env.WEB_RESEARCH_COMMAND || join(import.meta.dir, "web-research");
const references = new Map<string, Reference>();
const pageReferences = new Map<string, PageReference>();
let nextSearchReference = 1;
let nextPageReference = 1;

const runTool = {
  name: "run",
  title: "Agency web research",
  description:
