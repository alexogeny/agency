class RetrievalFailure extends Error {
  kind: string;
  code: string;
  retriable: boolean;
  safety?: JsonObject;

  constructor(
    kind: string,
    code: string,
    message: string,
    retriable: boolean,
    safety?: JsonObject,
  ) {
    super(message);
    this.kind = kind;
    this.code = code;
    this.retriable = retriable;
    this.safety = safety;
  }
}

