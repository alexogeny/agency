function commandCaptureGc(args: string[]) {
  if (!args.includes("--max-manifests")) {
    fail("capture-gc requires --max-manifests N");
  }
  const maxManifests = takeNumber(
    args,
    "--max-manifests",
    0,
    0,
    1_000_000,
  );
  const apply = takeFlag(args, "--apply");
  const json = takeFlag(args, "--json");
  if (args.length) fail("capture-gc accepts no positional arguments");
  const directories = captureDirectories();
  const manifests = readdirSync(directories.manifests)
    .filter((name) => /^[a-f0-9]{64}\.json$/.test(name))
    .map((name) => {
      const path = join(directories.manifests, name);
      const status = lstatSync(path);
      if (!status.isFile() || status.isSymbolicLink()) {
        fail(`capture manifest is not a regular file: ${name}`);
      }
      let manifest: any;
      try {
        manifest = JSON.parse(readFileSync(path, "utf8"));
      } catch {
        fail(`capture manifest is invalid JSON: ${name}`);
      }
      if (
        manifest.schema !== "agency/web-capture-manifest/1" ||
        typeof manifest.captured_at !== "string" ||
        !Number.isFinite(Date.parse(manifest.captured_at)) ||
        typeof manifest.object_sha256 !== "string" ||
        !/^[a-f0-9]{64}$/.test(manifest.object_sha256)
      ) {
        fail(`capture manifest is invalid: ${name}`);
      }
      return { name, path, manifest };
    })
    .sort(
      (left, right) =>
        Date.parse(right.manifest.captured_at) -
          Date.parse(left.manifest.captured_at) ||
        right.name.localeCompare(left.name),
    );
  const retained = manifests.slice(0, maxManifests);
  const removedManifests = manifests.slice(maxManifests);
  const referenced = new Set(
    retained.map((item) => item.manifest.object_sha256 as string),
  );
  const removedObjects = readdirSync(directories.objects)
    .filter((name) => /^[a-f0-9]{64}\.json$/.test(name))
    .filter((name) => !referenced.has(name.slice(0, -5)))
    .map((name) => join(directories.objects, name));
  if (apply) {
    for (const item of removedManifests) unlinkSync(item.path);
    for (const path of removedObjects) {
      const status = lstatSync(path);
      if (!status.isFile() || status.isSymbolicLink()) {
        fail(`capture object is not a regular file: ${basename(path)}`);
      }
      unlinkSync(path);
    }
  }
  const report = {
    schema: "agency/web-capture-gc/1",
    applied: apply,
    retained_manifests: retained.length,
    removed_manifests: removedManifests.map((item) => item.name.slice(0, -5)),
    removed_objects: removedObjects.map((path) => basename(path, ".json")),
  };
  console.log(
    json
      ? JSON.stringify(report, null, 2)
      : `${apply ? "removed" : "would remove"} ${removedManifests.length} manifests and ${removedObjects.length} objects`,
  );
}

async function commandMap(args: string[]) {
  const options = browserOptions(args);
  const limit = takeNumber(args, "--limit", 200, 1, 5000);
  const json = takeFlag(args, "--json");
  if (args.length !== 1) fail("map requires one URL");
  const url = checkedUrl(args[0]);
  const links = await withBrowser(options, async (browser) => {
    const page = await navigateAndExtract(browser, url.href, options);
    return [
      ...new Set(
