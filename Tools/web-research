  else links.forEach((link) => console.log(terminalText(link)));
}

async function commandSnapshot(args: string[]) {
  const options = browserOptions(args);
  const format = takeOption(args, "--format", "png");
  const output = takeOption(args, "--output");
  if (!new Set(["png", "pdf"]).has(format)) fail("--format must be png or pdf");
  if (!output) fail("snapshot requires --output PATH");
  if (args.length !== 1) fail("snapshot requires one URL");
  const url = checkedUrl(args[0]);
  const data = await withBrowser(options, async (browser) => {
    await browser.bidi.navigate(
      browser.context,
      url.href,
      options.navigationTimeoutMs,
    );
    await preparePage(browser, options);
    const result = await browser.bidi.command(
      format === "pdf"
        ? "browsingContext.print"
        : "browsingContext.captureScreenshot",
      format === "pdf"
        ? { context: browser.context, background: true }
        : {
            context: browser.context,
            format: { type: "png" },
            origin: "document",
          },
      120_000,
    );
    return String(result.data);
  });
  const path = resolve(output);
  await Bun.write(path, Buffer.from(data, "base64"));
  info(`wrote ${path}`);
}

async function commandCrawl(args: string[]) {
  const options = browserOptions(args);
  const limit = takeNumber(args, "--limit", 50, 1, 1000);
  const depthLimit = takeNumber(args, "--depth", 2, 0, 10);
  const delay = takeNumber(args, "--delay-ms", 750, 0, 60_000);
  const maxQueue = takeNumber(
    args,
    "--max-queue",
    Math.min(100_000, Math.max(limit, limit * 20)),
    1,
    100_000,
  );
  const linksPerPage = takeNumber(
    args,
    "--links-per-page",
    200,
    1,
    5_000,
  );
  const maxQueryParameters = takeNumber(
    args,
    "--max-query-params",
    8,
    0,
    100,
  );
  const ignoreRobots = takeFlag(args, "--ignore-robots");
  const json = takeFlag(args, "--json");
  if (args.length !== 1) fail("crawl requires one URL");
  const root = checkedUrl(args[0]);
  const indexer = pageIndexer();
  let report: {
    pages: Array<{ url: string; title?: string; error?: string }>;
    summary: {
      visited: number;
      indexed: number;
      failed: number;
      disallowed: number;
      frontier_truncated: boolean;
    };
  };
  try {
    report = await withBrowser(options, async (browser) => {
      const rootNetworkCapture = await startNetworkCapture(
        browser,
        root.href,
        options.captureNetworkJson,
      );
      let rootCaptureOpen = true;
      await browser.bidi.navigate(
        browser.context,
        root.href,
        options.navigationTimeoutMs,
      );
      let rules: string[] = [];
      if (!ignoreRobots) {
        const expression = `fetch(${JSON.stringify(`${root.origin}/robots.txt`)}, { credentials: "include" }).then(response => response.ok ? response.text() : "").catch(() => "")`;
        rules = parseRobots(
          String(await browser.bidi.evaluate(browser.context, expression)),
        );
      }
      const queue: Array<{ url: string; depth: number }> = [
        { url: root.href, depth: 0 },
      ];
      const queued = new Set([root.href]);
      const pages: Array<{ url: string; title?: string; error?: string }> = [];
      let cursor = 0;
      let indexed = 0;
      let failed = 0;
      let disallowed = 0;
      let frontierTruncated = false;
      while (cursor < queue.length && pages.length < limit) {
        const current = queue[cursor++];
        const currentUrl = new URL(current.url);
        if (!ignoreRobots && !robotsAllows(currentUrl, rules)) {
          if (current.url === root.href && rootCaptureOpen) {
            await rootNetworkCapture.close();
            rootCaptureOpen = false;
          }
          pages.push({ url: current.url, error: "disallowed by robots.txt" });
          disallowed += 1;
          continue;
        }
        try {
          let page: Page;
          if (current.url === root.href) {
            page = await extractPage(browser, options);
            const evidence = await rootNetworkCapture.finish();
            rootCaptureOpen = false;
            attachNetworkEvidence(page, evidence, options);
          } else {
            page = await navigateAndExtract(browser, current.url, options);
          }
          indexer.write(page);
          indexed += 1;
          pages.push({ url: page.canonicalUrl || page.url, title: page.title });
          if (current.depth < depthLimit) {
            let addedFromPage = 0;
            for (const link of page.links) {
              const safe = crawlLink(
                link,
                root.origin,
                maxQueryParameters,
              );
              if (!safe || queued.has(safe)) continue;
              if (addedFromPage >= linksPerPage || queue.length >= maxQueue) {
                frontierTruncated = true;
                break;
              }
              queued.add(safe);
              queue.push({ url: safe, depth: current.depth + 1 });
              addedFromPage += 1;
            }
          }
        } catch (error) {
          if (current.url === root.href && rootCaptureOpen) {
            await rootNetworkCapture.close();
            rootCaptureOpen = false;
          }
          failed += 1;
          pages.push({
            url: current.url,
            error: error instanceof Error ? error.message : String(error),
          });
        }
        if (delay && cursor < queue.length && pages.length < limit) {
          await sleep(delay);
        }
      }
      if (rootCaptureOpen) await rootNetworkCapture.close();
      return {
        pages,
        summary: {
          visited: pages.length,
          indexed,
          failed,
          disallowed,
          frontier_truncated: frontierTruncated,
        },
      };
    });
  } finally {
    indexer.close();
  }
  if (json) {
    console.log(JSON.stringify({ root: root.href, ...report }, null, 2));
  } else {
    for (const page of report.pages) {
      console.log(
        page.error
          ? `${yellow}skip${reset} ${terminalText(page.url)} — ${terminalText(page.error)}`
          : `${pink}saved${reset} ${terminalText(page.url)}`,
      );
    }
  }
}

function commandLocal(args: string[]) {
  const limit = takeNumber(args, "--limit", 10, 1, 100);
  const json = takeFlag(args, "--json");
  const query = args.join(" ").trim();
  if (!query) fail("local requires a query");
  const terms = query.match(/[\p{L}\p{N}_-]+/gu) || [];
  if (!terms.length) fail("local query has no searchable terms");
  const match = terms
    .map((term) => `"${term.replaceAll('"', '""')}"`)
    .join(" ");
  const db = database();
  const results = db
    .query(
      "SELECT pages_fts.url AS url, pages_fts.title AS title, snippet(pages_fts, 2, '', '', ' … ', 18) AS snippet, bm25(pages_fts) AS score, pages.fetched_at AS retrieved_at, pages.change_likelihood, pages.refresh_after, pages.content_sha256 FROM pages_fts JOIN pages ON pages.url = pages_fts.url WHERE pages_fts MATCH ? ORDER BY score LIMIT ?",
    )
    .all(match, limit);
  db.close();
  if (json) console.log(JSON.stringify({ query, results }, null, 2));
  else {
    console.log(`${purple}◇ local index: ${query}${reset}`);
    for (const [position, result] of (results as any[]).entries()) {
      console.log(
        `${pink}${position + 1}. ${terminalText(result.title)}${reset}\n   ${terminalText(result.url)}\n   ${terminalText(result.snippet)}`,
      );
    }
  }
}

function commandStats(args: string[]) {
  if (args.length) fail("stats takes no arguments");
  const db = database();
  const row = db
    .query("SELECT COUNT(*) AS pages, MAX(fetched_at) AS newest FROM pages")
    .get() as any;
  const byChangeLikelihood = Object.fromEntries(
    (db
      .query(
        "SELECT change_likelihood, COUNT(*) AS pages FROM pages GROUP BY change_likelihood ORDER BY change_likelihood",
      )
      .all() as any[]).map((item) => [item.change_likelihood, item.pages]),
  );
  db.close();
  console.log(
    JSON.stringify(
      {
        pages: row.pages,
        newest: row.newest,
        by_change_likelihood: byChangeLikelihood,
        dataRoot,
      },
      null,
      2,
    ),
  );
}

async function commandBrowser(args: string[]) {
  const profile = checkedProfile(takeOption(args, "--profile", "default"));
  const detach = takeFlag(args, "--detach");
  if (args.length > 1) fail("browser accepts at most one URL");
  const url = args.length ? checkedUrl(args[0]).href : "about:blank";
  const claimed = claimProfile(profile, [], false);
  const child = Bun.spawn(
    ["firefox", "--no-remote", "--profile", claimed.root, url],
    {
      stdin: detach ? "ignore" : "inherit",
      stdout: "ignore",
      stderr: "ignore",
    },
  );
  if (detach) {
    writeFileSync(claimed.lock, String(child.pid), { mode: 0o600 });
    child.unref();
    info(`opened detached persistent profile '${profile}' in Firefox`);
    return;
  }
  info(`opened persistent profile '${profile}'; close Firefox to continue`);
  try {
    const exitCode = await child.exited;
    if (exitCode !== 0) throw new Error(`Firefox exited with status ${exitCode}`);
  } finally {
    releaseProfile(claimed);
  }
}

