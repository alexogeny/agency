function firefoxConfigurationRoot() {
  return (
    process.env.WEB_RESEARCH_FIREFOX_ROOT ||
    join(homedir(), ".mozilla/firefox")
  );
}

function parseIniSections(text: string) {
  const sections = new Map<string, Record<string, string>>();
  let current: Record<string, string> | null = null;
  for (const raw of text.split("\n")) {
    const line = raw.trim();
    const section = line.match(/^\[([^\]]+)\]$/);
    if (section) {
      current = {};
      sections.set(section[1], current);
      continue;
    }
    if (!current || !line || line.startsWith("#") || line.startsWith(";"))
      continue;
    const separator = line.indexOf("=");
    if (separator < 1) continue;
    current[line.slice(0, separator).trim()] = line
      .slice(separator + 1)
      .trim();
  }
  return sections;
}

function currentFirefoxProfile() {
  const root = firefoxConfigurationRoot();
  let sections: Map<string, Record<string, string>>;
  try {
    sections = parseIniSections(readFileSync(join(root, "profiles.ini"), "utf8"));
  } catch (error) {
    throw new RetrievalFailure(
      "policy",
      "profile-template-unavailable",
      error instanceof Error ? error.message : String(error),
      false,
    );
  }
  const candidates: string[] = [];
  for (const [name, values] of sections) {
    if (name.startsWith("Install") && values.Default) {
      candidates.push(values.Default);
    }
  }
  for (const [name, values] of sections) {
    if (!name.startsWith("Profile") || values.Default !== "1" || !values.Path)
      continue;
    candidates.push(
      values.IsRelative === "0" ? values.Path : join(root, values.Path),
    );
  }
  for (const candidate of candidates) {
    const path = isAbsolute(candidate) ? candidate : join(root, candidate);
    if (existsSync(join(path, "prefs.js"))) return realpathSync(path);
  }
  throw new RetrievalFailure(
    "policy",
    "profile-template-unavailable",
    "Firefox has no current profile with a readable prefs.js",
    false,
  );
}

function checkedTemplateProfile(value: string) {
  if (value === "current") return currentFirefoxProfile();
  if (!isAbsolute(value)) {
    throw new RetrievalFailure(
      "policy",
      "profile-template-invalid",
      "--profile-template must be current or an absolute profile directory",
      false,
    );
  }
  let profile: string;
  try {
    profile = realpathSync(value);
  } catch (error) {
    throw new RetrievalFailure(
      "policy",
      "profile-template-unavailable",
      error instanceof Error ? error.message : String(error),
      false,
    );
  }
  if (!statSync(profile).isDirectory() || !existsSync(join(profile, "prefs.js"))) {
    throw new RetrievalFailure(
      "policy",
      "profile-template-unavailable",
      "profile template must be a directory containing prefs.js",
      false,
    );
  }
  return profile;
}

function allowedTemplatePreference(name: string, value: unknown) {
  if (booleanTemplatePreferences.has(name)) return typeof value === "boolean";
  if (name === "intl.accept_languages") {
    return (
      typeof value === "string" &&
      value.length > 0 &&
      value.length <= 256 &&
      !/[\u0000-\u001f\u007f]/.test(value)
    );
  }
  const range = numericTemplatePreferences.get(name);
  if (!range || typeof value !== "number" || !Number.isInteger(value)) {
    return false;
  }
  return value >= range[0] && value <= range[1];
}

function templatePreferences(value: string): FirefoxPreference[] {
  const profile = checkedTemplateProfile(value);
  const selected = new Map<string, string | number | boolean>();
  const text = readFileSync(join(profile, "prefs.js"), "utf8");
  for (const line of text.split("\n")) {
    const match = line.match(/^user_pref\("([^"]+)",\s*(.+)\);$/);
    if (!match) continue;
    const name = match[1];
    if (
      !booleanTemplatePreferences.has(name) &&
      name !== "intl.accept_languages" &&
      !numericTemplatePreferences.has(name)
    ) {
      continue;
    }
    let parsed: unknown;
    try {
      parsed = JSON.parse(match[2]);
    } catch {
      continue;
    }
    if (allowedTemplatePreference(name, parsed)) {
      selected.set(name, parsed as string | number | boolean);
    }
  }
  return [...selected.entries()];
}

function profileRoot(profile: string, ephemeral: boolean) {
  if (!ephemeral) return join(dataRoot, "profiles", profile);
  const ephemeralRoot = join(dataRoot, "ephemeral");
  mkdirSync(ephemeralRoot, { recursive: true });
  return mkdtempSync(join(ephemeralRoot, `${profile}-`));
}

function claimProfile(
  profile: string,
  transientPreferences: FirefoxPreference[] = [],
  managePreferences = true,
  ephemeral = false,
) {
  const root = profileRoot(profile, ephemeral);
  const lock = ephemeral ? join(root, ".agency.lock") : `${root}.lock`;
  mkdirSync(root, { recursive: true });
  try {
    const descriptor = openSync(lock, "wx", 0o600);
    writeFileSync(descriptor, String(process.pid));
    closeSync(descriptor);
  } catch {
    let owner = 0;
    try {
      owner = Number(readFileSync(lock, "utf8"));
      process.kill(owner, 0);
    } catch {
      if (ephemeral) {
        rmSync(root, { recursive: true, force: true });
        throw new Error("could not claim a new ephemeral Firefox profile");
      }
      try {
        unlinkSync(lock);
      } catch {}
      return claimProfile(
        profile,
        transientPreferences,
        managePreferences,
        ephemeral,
      );
    }
    throw new Error(
      `browser profile '${profile}' is already in use by process ${owner}`,
    );
  }
  const userJs = join(root, "user.js");
  const previousUserJs = existsSync(userJs) ? readFileSync(userJs, "utf8") : null;
  if (managePreferences) {
    const preferences: FirefoxPreference[] = [
      ["browser.shell.checkDefaultBrowser", false],
      ["browser.startup.homepage_override.mstone", "ignore"],
      ["browser.aboutwelcome.enabled", false],
      ["datareporting.policy.dataSubmissionEnabled", false],
      ["toolkit.telemetry.reportingpolicy.firstRun", false],
      ...transientPreferences,
    ];
    const managed = preferences
      .map(([name, value]) => `user_pref(${JSON.stringify(name)}, ${JSON.stringify(value)});`)
      .join("\n");
    const prefix = previousUserJs
      ? `${previousUserJs}${previousUserJs.endsWith("\n") ? "" : "\n"}`
      : "";
    try {
      writeFileSync(userJs, `${prefix}${managed}\n`, { mode: 0o600 });
    } catch (error) {
      try {
        unlinkSync(lock);
      } catch {}
      if (ephemeral) rmSync(root, { recursive: true, force: true });
      throw error;
    }
  }
  return {
    root,
    lock,
    userJs,
    previousUserJs,
    managePreferences,
    ephemeral,
  };
}

function releaseProfile(claimed: ReturnType<typeof claimProfile>) {
  let restoreError: unknown;
  try {
    if (claimed.managePreferences) {
      if (claimed.previousUserJs === null) {
        try {
          unlinkSync(claimed.userJs);
        } catch {}
      } else {
        writeFileSync(claimed.userJs, claimed.previousUserJs, { mode: 0o600 });
      }
    }
  } catch (error) {
    restoreError = error;
  }
  try {
    unlinkSync(claimed.lock);
  } catch {}
  if (claimed.ephemeral) {
    rmSync(claimed.root, { recursive: true, force: true });
  }
  if (restoreError) throw restoreError;
}

class Bidi {
  socket: WebSocket;
  capabilities: JsonObject = {};
  nextId = 0;
  pending = new Map<
    number,
    {
      resolve: (value: any) => void;
      reject: (error: Error) => void;
      timer: Timer;
    }
  >();
  listeners = new Map<string, Set<(params: any) => void>>();
  subscriptions = new Set<string>();

  constructor(url: string) {
    this.socket = new WebSocket(url);
    this.socket.addEventListener("message", (event) => {
      const message = JSON.parse(String(event.data));
      if (typeof message.id !== "number") {
        if (typeof message.method !== "string") return;
        for (const listener of this.listeners.get(message.method) || []) {
          listener(message.params);
        }
        return;
      }
      const request = this.pending.get(message.id);
      if (!request) return;
      clearTimeout(request.timer);
      this.pending.delete(message.id);
      if (message.type === "error") {
        request.reject(new Error(`${message.error}: ${message.message}`));
      } else {
        request.resolve(message.result);
      }
    });
  }

  async open() {
    await new Promise<void>((resolveOpen, rejectOpen) => {
      this.socket.addEventListener("open", () => resolveOpen(), { once: true });
      this.socket.addEventListener(
        "error",
        () => rejectOpen(new Error("Firefox WebDriver BiDi connection failed")),
        { once: true },
      );
    });
    const session = await this.command("session.new", { capabilities: {} });
    this.capabilities = session?.capabilities || {};
  }

  command(method: string, params: JsonObject, timeout = 90_000) {
    return new Promise<any>((resolveCommand, rejectCommand) => {
      const id = ++this.nextId;
      const timer = setTimeout(() => {
        this.pending.delete(id);
        rejectCommand(new Error(`${method} timed out`));
      }, timeout);
      this.pending.set(id, {
        resolve: resolveCommand,
        reject: rejectCommand,
        timer,
      });
      this.socket.send(JSON.stringify({ id, method, params }));
    });
  }

  async tree() {
    return this.command("browsingContext.getTree", {});
  }

  async context() {
    const tree = await this.tree();
    const context = tree.contexts?.[0]?.context;
    if (!context) throw new Error("Firefox has no browsing context");
    return String(context);
  }

  on(method: string, listener: (params: any) => void) {
    const listeners = this.listeners.get(method) || new Set();
    listeners.add(listener);
    this.listeners.set(method, listeners);
    return () => {
      listeners.delete(listener);
      if (!listeners.size) this.listeners.delete(method);
    };
  }

  async subscribe(method: string, context: string) {
    const key = `${method}\n${context}`;
    if (this.subscriptions.has(key)) return;
    await this.command("session.subscribe", {
      events: [method],
      contexts: [context],
    });
    this.subscriptions.add(key);
  }

  async navigate(
    context: string,
    url: string,
    timeoutMs = 45_000,
    wait: "none" | "interactive" | "complete" = "interactive",
  ) {
    return this.command(
      "browsingContext.navigate",
      { context, url, wait },
      timeoutMs,
    );
  }

  async evaluate(context: string, expression: string) {
    const response = await this.command(
      "script.evaluate",
      {
        expression,
        target: { context },
        awaitPromise: true,
        serializationOptions: { maxDomDepth: 0, maxObjectDepth: 0 },
      },
      90_000,
    );
    if (response.type !== "success") {
      throw new Error(response.exceptionDetails?.text || "page script failed");
    }
    return response.result?.value;
  }

  close() {
    this.socket.close();
  }
}

type BrowserOptions = {
  profile: string;
  ephemeral: boolean;
  templatePreferences: FirefoxPreference[];
  headless: boolean;
  humanTimeout: number;
  waitMs: number;
  settleMs: number;
  navigationTimeoutMs: number;
  navigationRetries: number;
  maxContentChars: number;
  maxLinks: number;
  scrollSteps: number;
  interactionSteps: number;
  captureNetworkJson: boolean;
  capture: boolean;
  allowPrivate: boolean;
};

const ordinaryBrowserPreload = String.raw`() => {
  const descriptor = Object.getOwnPropertyDescriptor(Navigator.prototype, "webdriver")
  if (descriptor && !descriptor.configurable) return
  Object.defineProperty(Navigator.prototype, "webdriver", {
    configurable: true,
    enumerable: descriptor?.enumerable ?? true,
    get: () => false,
  })
}`;

async function terminateBrowserProcess(
  processHandle: ReturnType<typeof Bun.spawn>,
) {
  if (processHandle.exitCode !== null) return;
  processHandle.kill();
  await Promise.race([processHandle.exited, sleep(3_000)]);
  if (processHandle.exitCode === null) {
    processHandle.kill(9);
    await processHandle.exited;
  }
}

async function startBrowser(
  options: BrowserOptions,
  transientPreferences: FirefoxPreference[] = [],
) {
  if (
    !options.headless &&
    !process.env.DISPLAY &&
    !process.env.WAYLAND_DISPLAY
  ) {
    throw new Error("no graphical display is available; use --headless");
  }
  const proxy = await safeProxy(options.allowPrivate);
  let claimed: ReturnType<typeof claimProfile>;
  try {
    claimed = claimProfile(
      options.profile,
      [
        ...options.templatePreferences,
        ...transientPreferences,
        ["network.proxy.type", 1],
        ["network.proxy.http", "127.0.0.1"],
        ["network.proxy.http_port", proxy.port],
        ["network.proxy.ssl", "127.0.0.1"],
        ["network.proxy.ssl_port", proxy.port],
        ["network.proxy.no_proxies_on", ""],
        ["network.proxy.allow_hijacking_localhost", true],
      ],
      true,
      options.ephemeral,
    );
  } catch (error) {
    await proxy.close();
    throw error;
  }
  const port = choosePort();
  const command = [
    "firefox",
    "--no-remote",
    "--profile",
    claimed.root,
    "--remote-debugging-port",
    String(port),
  ];
  if (options.headless) command.push("--headless");
  command.push("about:blank");
  const processHandle = Bun.spawn(command, {
    stdout: "ignore",
    stderr: "ignore",
    stdin: "ignore",
  });
  const deadline = Date.now() + 20_000;
  let ready = false;
  while (Date.now() < deadline) {
    if (processHandle.exitCode !== null) break;
    try {
      const response = await fetch(`http://127.0.0.1:${port}/`);
      if (response.ok) {
        ready = true;
        break;
      }
    } catch {}
    await sleep(150);
  }
  if (!ready) {
    await terminateBrowserProcess(processHandle);
    releaseProfile(claimed);
    await proxy.close();
    throw new Error(
      processHandle.exitCode !== null
        ? "Firefox exited before its local control socket became ready"
        : "Firefox control socket did not become ready within 20 seconds",
    );
  }
  const bidi = new Bidi(`ws://127.0.0.1:${port}/session`);
  let context: string;
  try {
    await bidi.open();
    context = await bidi.context();
    await bidi.command("script.addPreloadScript", {
      functionDeclaration: ordinaryBrowserPreload,
      contexts: [context],
    });
  } catch (error) {
    bidi.close();
    await terminateBrowserProcess(processHandle);
    releaseProfile(claimed);
    await proxy.close();
    throw error;
  }
  return { bidi, context, processHandle, proxy, ...claimed };
}

async function stopBrowser(browser: Awaited<ReturnType<typeof startBrowser>>) {
  browser.bidi.close();
  await terminateBrowserProcess(browser.processHandle);
  releaseProfile(browser);
  await browser.proxy.close();
}

async function withBrowser<T>(
  options: BrowserOptions,
  operation: (browser: Awaited<ReturnType<typeof startBrowser>>) => Promise<T>,
  transientPreferences: FirefoxPreference[] = [],
) {
  const browser = await startBrowser(options, transientPreferences);
  try {
    return await operation(browser);
  } finally {
    await stopBrowser(browser);
  }
}

function sanitizedNetworkJson(value: unknown) {
  let nodes = 0;
  const visit = (item: unknown, depth: number): unknown => {
    nodes += 1;
    if (nodes > 2_000 || depth > 8 || item === null) return null;
    if (typeof item === "string") {
      const cleaned = terminalText(item).slice(0, 4_000);
      return /^https?:\/\//i.test(cleaned)
        ? redactedOutputUrl(cleaned)
        : cleaned;
    }
    if (typeof item === "number" || typeof item === "boolean") return item;
    if (Array.isArray(item)) {
      return item
        .slice(0, 100)
        .map((value) => visit(value, depth + 1))
        .filter((value) => value !== null);
    }
    if (typeof item !== "object") return null;
    const result: JsonObject = {};
    for (const [key, value] of Object.entries(item).slice(0, 100)) {
      if (
        sensitiveQueryParameter(key) ||
        /^(?:cookie|set-cookie|password|passwd|authorization)$/i.test(key)
      ) {
        continue;
      }
      const sanitized = visit(value, depth + 1);
      if (sanitized !== null) result[key] = sanitized;
    }
    return result;
  };
  return visit(value, 0);
}

function boundedRetryAfter(value: unknown, now = Date.now()) {
  const text = String(value || "").trim();
  if (!text) return null;
  const seconds = /^\d+$/.test(text)
    ? Number(text)
    : (Date.parse(text) - now) / 1000;
  if (!Number.isFinite(seconds) || seconds <= 0) return null;
  return Math.max(1, Math.min(24 * 60 * 60, Math.ceil(seconds)));
}

async function startNavigationHealth(
  browser: Awaited<ReturnType<typeof startBrowser>>,
  targetUrl: string,
) {
  let targetOrigin = "";
  try {
    targetOrigin = new URL(targetUrl).origin;
  } catch {}
  let retryAfterSeconds: number | null = null;
  try {
    await browser.bidi.subscribe("network.responseCompleted", browser.context);
  } catch {
    return { snapshot: () => ({ retryAfterSeconds: null }), close: () => {} };
  }
  const stopListening = browser.bidi.on("network.responseCompleted", (params) => {
    if (retryAfterSeconds !== null || params?.context !== browser.context) return;
    const status = Number(params?.response?.status || 0);
    const url = String(params?.request?.url || "");
    if (status !== 429) return;
    try {
      if (new URL(url).origin !== targetOrigin) return;
    } catch {
      return;
    }
    for (const header of params?.response?.headers || []) {
      if (String(header?.name || "").toLowerCase() !== "retry-after") continue;
      retryAfterSeconds = boundedRetryAfter(
        header?.value?.value ?? header?.value,
      );
      break;
    }
  });
  return {
    snapshot: () => ({ retryAfterSeconds }),
    close: stopListening,
  };
}

async function startNetworkCapture(
  browser: Awaited<ReturnType<typeof startBrowser>>,
  targetUrl: string,
  enabled: boolean,
) {
  const empty = {
    finish: async () => [] as NetworkEvidence[],
    close: async () => {},
  };
  if (!enabled) return empty;
  let targetOrigin = "";
  try {
    targetOrigin = new URL(targetUrl).origin;
  } catch {
    return empty;
  }
  let collector = "";
  try {
    const result = await browser.bidi.command("network.addDataCollector", {
      dataTypes: ["response"],
      maxEncodedDataSize: 131_072,
      contexts: [browser.context],
    });
    collector = String(result.collector || "");
    if (!collector) return empty;
    await browser.bidi.subscribe("network.responseCompleted", browser.context);
  } catch {
    if (collector) {
      try {
        await browser.bidi.command("network.removeDataCollector", { collector });
      } catch {}
    }
    return empty;
  }
  const candidates: Array<{
    request: string;
    url: string;
    status: number;
    mimeType: string;
  }> = [];
  const seen = new Set<string>();
  const stopListening = browser.bidi.on("network.responseCompleted", (params) => {
    if (candidates.length >= 24 || params?.context !== browser.context) return;
    const request = String(params?.request?.request || "");
    const url = String(params?.request?.url || "");
    const status = Number(params?.response?.status || 0);
    const mimeType = String(params?.response?.mimeType || "").toLowerCase();
    if (!request || seen.has(request) || status < 200 || status >= 300) return;
    try {
      if (new URL(url).origin !== targetOrigin) return;
    } catch {
      return;
    }
    if (!mimeType.includes("json") && !/\/(?:graphql|api)(?:\/|\?|$)/i.test(url)) {
      return;
    }
    seen.add(request);
    candidates.push({ request, url, status, mimeType });
  });
  let closed = false;
  const close = async () => {
    if (closed) return;
    closed = true;
    stopListening();
    try {
      await browser.bidi.command("network.removeDataCollector", { collector });
    } catch {}
  };
  const finish = async () => {
    const evidence: NetworkEvidence[] = [];
    let retainedChars = 0;
    try {
      for (const candidate of candidates.slice(0, 12)) {
        if (retainedChars >= 524_288) break;
        try {
          const result = await browser.bidi.command("network.getData", {
            request: candidate.request,
            dataType: "response",
            collector,
            disown: true,
          });
          const bytes = result?.bytes;
          const raw =
            bytes?.type === "base64"
              ? Buffer.from(String(bytes.value || ""), "base64").toString("utf8")
              : String(bytes?.value || "");
          if (!raw || retainedChars + raw.length > 524_288) continue;
          const body = sanitizedNetworkJson(JSON.parse(raw));
          if (body === null) continue;
          retainedChars += raw.length;
          evidence.push({
            url: redactedOutputUrl(candidate.url),
            status: candidate.status,
            mimeType: candidate.mimeType,
            body,
          });
        } catch {}
      }
      return evidence;
    } finally {
      await close();
    }
  };
  return { finish, close };
}

const downloadMimeTypes = [
  "application/octet-stream",
  "application/pdf",
  "application/zip",
  "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
  "application/vnd.openxmlformats-officedocument.presentationml.presentation",
  "image/gif",
  "image/jpeg",
  "image/png",
].join(",");

const downloadTypes = new Set([
  "pdf",
  "zip",
  "docx",
  "xlsx",
  "pptx",
  "png",
  "jpeg",
  "gif",
]);

function checkedDownloadOutput(
  outputValue: string,
  rootValue: string,
  replace: boolean,
) {
  if (!isAbsolute(outputValue) || !isAbsolute(rootValue)) {
    throw new RetrievalFailure(
      "policy",
      "absolute-path-required",
      "--output and --output-root must be absolute paths",
      false,
    );
  }
  let root: string;
  let parent: string;
  try {
    root = realpathSync(rootValue);
    parent = realpathSync(dirname(outputValue));
  } catch (error) {
    throw new RetrievalFailure(
      "policy",
      "output-directory-missing",
      error instanceof Error ? error.message : String(error),
      false,
    );
  }
  if (!statSync(root).isDirectory() || !statSync(parent).isDirectory()) {
    throw new RetrievalFailure(
      "policy",
      "output-directory-invalid",
      "--output-root and the output parent must be directories",
      false,
    );
  }
  const parentRelative = relative(root, parent);
  if (
    parentRelative === ".." ||
    parentRelative.startsWith(`..${sep}`) ||
    isAbsolute(parentRelative)
  ) {
    throw new RetrievalFailure(
      "policy",
      "output-outside-root",
      "--output must stay inside --output-root",
      false,
    );
  }
  const output = join(parent, basename(outputValue));
  if (output === root || basename(output) === "." || basename(output) === "..") {
    throw new RetrievalFailure(
      "policy",
      "output-invalid",
      "--output must name a file inside --output-root",
      false,
    );
  }
  if (existsSync(output)) {
    const existing = lstatSync(output);
    if (!existing.isFile() || existing.isSymbolicLink()) {
      throw new RetrievalFailure(
        "policy",
        "output-not-regular",
        "an existing output must be a regular file",
        false,
      );
    }
    if (!replace) {
      throw new RetrievalFailure(
        "policy",
        "output-exists",
        "output exists; use --replace to replace it after validation",
        false,
      );
    }
  }
  return { output, root };
}

function inferredDownloadType(output: string, requested: string) {
  const extensionTypes: Record<string, string> = {
    ".pdf": "pdf",
    ".zip": "zip",
    ".docx": "docx",
    ".xlsx": "xlsx",
    ".pptx": "pptx",
    ".png": "png",
    ".jpg": "jpeg",
    ".jpeg": "jpeg",
    ".gif": "gif",
  };
  const expected = requested || extensionTypes[extname(output).toLowerCase()];
  if (!expected || !downloadTypes.has(expected)) {
    throw new RetrievalFailure(
      "policy",
      "expected-type-required",
      "use --expected-type pdf|zip|docx|xlsx|pptx|png|jpeg|gif",
      false,
    );
  }
  return expected;
}

function startsWithBytes(bytes: Buffer, signature: number[] | Buffer) {
  const expected = Buffer.from(signature);
  return (
    bytes.length >= expected.length &&
    bytes.subarray(0, expected.length).equals(expected)
  );
}

function zipEntryNames(bytes: Buffer) {
  const minimum = Math.max(0, bytes.length - 65_557);
  let end = -1;
  for (let offset = bytes.length - 22; offset >= minimum; offset -= 1) {
    if (bytes.readUInt32LE(offset) === 0x06054b50) {
      end = offset;
      break;
    }
  }
  if (end < 0) return [];
  const entryCount = bytes.readUInt16LE(end + 10);
  let offset = bytes.readUInt32LE(end + 16);
  const names: string[] = [];
  for (let index = 0; index < entryCount; index += 1) {
    if (offset + 46 > bytes.length || bytes.readUInt32LE(offset) !== 0x02014b50)
      return [];
    const nameLength = bytes.readUInt16LE(offset + 28);
    const extraLength = bytes.readUInt16LE(offset + 30);
    const commentLength = bytes.readUInt16LE(offset + 32);
    const nameStart = offset + 46;
    const nameEnd = nameStart + nameLength;
    if (nameEnd > bytes.length) return [];
    names.push(bytes.subarray(nameStart, nameEnd).toString("utf8"));
    offset = nameEnd + extraLength + commentLength;
  }
  return names;
}

function verifyDownload(bytes: Buffer, expectedType: string) {
  const simpleSignatures: Record<string, Array<number[] | Buffer>> = {
    pdf: [Buffer.from("%PDF-")],
    png: [[0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]],
    jpeg: [[0xff, 0xd8, 0xff]],
    gif: [Buffer.from("GIF87a"), Buffer.from("GIF89a")],
    zip: [
      [0x50, 0x4b, 0x03, 0x04],
      [0x50, 0x4b, 0x05, 0x06],
    ],
  };
  const zipBased = new Set(["zip", "docx", "xlsx", "pptx"]);
  const signatureType = zipBased.has(expectedType) ? "zip" : expectedType;
  const signatures = simpleSignatures[signatureType] || [];
  if (!signatures.some((signature) => startsWithBytes(bytes, signature))) {
    throw new RetrievalFailure(
      "validation",
      "signature-mismatch",
      `download does not match expected ${expectedType} signature`,
      false,
    );
  }
  if (new Set(["docx", "xlsx", "pptx"]).has(expectedType)) {
    const entries = zipEntryNames(bytes);
    const requiredDirectory = { docx: "word/", xlsx: "xl/", pptx: "ppt/" }[
      expectedType
    ];
    if (
      !entries.includes("[Content_Types].xml") ||
      !entries.some((name) => name.startsWith(requiredDirectory))
    ) {
      throw new RetrievalFailure(
        "validation",
        "office-container-mismatch",
        `download is not a valid ${expectedType} container`,
        false,
      );
    }
  }
}

async function waitForDownload(
  directory: string,
  maxBytes: number,
  timeoutMs: number,
) {
  const deadline = Date.now() + timeoutMs;
  let stableName = "";
  let stableSize = -1;
  let stableChecks = 0;
  while (Date.now() < deadline) {
    const entries = readdirSync(directory).filter((name) => {
      try {
        return lstatSync(join(directory, name)).isFile();
      } catch {
        return false;
      }
    });
    for (const name of entries) {
      const size = statSync(join(directory, name)).size;
      if (size > maxBytes) {
        throw new RetrievalFailure(
          "limit",
          "download-too-large",
          `download exceeded the ${maxBytes}-byte limit`,
          false,
        );
      }
    }
    const partials = entries.filter((name) => /\.(?:part|tmp)$/i.test(name));
    const complete = entries.filter((name) => !/\.(?:part|tmp)$/i.test(name));
    if (complete.length > 1) {
      throw new RetrievalFailure(
        "validation",
        "ambiguous-download",
        "browser created more than one completed file",
        false,
      );
    }
    if (complete.length === 1 && partials.length === 0) {
      const name = complete[0];
      const size = statSync(join(directory, name)).size;
      if (size > 0 && name === stableName && size === stableSize) {
        stableChecks += 1;
        if (stableChecks >= 2) return join(directory, name);
      } else {
        stableName = name;
        stableSize = size;
        stableChecks = 0;
      }
    } else {
      stableName = "";
      stableSize = -1;
      stableChecks = 0;
    }
    await sleep(250);
  }
  throw new RetrievalFailure(
    "network",
    "download-timeout",
    `download did not complete within ${timeoutMs} milliseconds`,
    true,
  );
}

