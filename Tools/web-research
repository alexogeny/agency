function terminalText(value: unknown) {
  return String(value).replace(
    /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g,
    "",
  );
}

function fail(message: string): never {
  process.stderr.write(`${red}error:${reset} ${terminalText(message)}\n`);
  process.exit(1);
}

function info(message: string) {
  process.stderr.write(`${purple}◇${reset} ${terminalText(message)}\n`);
}

function takeOption(args: string[], name: string, fallback = "") {
  const index = args.indexOf(name);
  if (index < 0) return fallback;
  if (index + 1 >= args.length) fail(`${name} requires a value`);
  const value = args[index + 1];
  args.splice(index, 2);
  return value;
}

function takeOptions(args: string[], name: string) {
  const values: string[] = [];
  while (args.includes(name)) values.push(takeOption(args, name));
  return values;
}

function takeFlag(args: string[], name: string) {
  const index = args.indexOf(name);
  if (index < 0) return false;
  args.splice(index, 1);
  return true;
}

function takeNumber(
  args: string[],
  name: string,
  fallback: number,
  minimum: number,
  maximum: number,
) {
  const raw = takeOption(args, name);
  if (!raw) return fallback;
  const value = Number(raw);
  if (!Number.isInteger(value) || value < minimum || value > maximum) {
    fail(`${name} must be an integer from ${minimum} to ${maximum}`);
  }
  return value;
}

function takeLiteralArguments(args: string[]) {
  const separator = args.indexOf("--");
  if (separator < 0) return [];
  return args.splice(separator).slice(1);
}

function rejectUnknownOptions(args: string[], command: string) {
  const unknown = args.find((value) => value.startsWith("-"));
  if (!unknown) return;
  fail(
    `unknown ${command} option: ${unknown}; use -- before intentional query text beginning with a hyphen`,
  );
}

function checkedUrl(value: string) {
  let url: URL;
  try {
    url = new URL(value);
  } catch {
    fail(`invalid URL: ${value}`);
  }
  if (!webProtocols.has(url.protocol)) {
    fail(`URL must use HTTP or HTTPS: ${value}`);
  }
  url.hash = "";
  return url;
}

function sensitiveQueryParameter(name: string) {
  const normalized = name.toLowerCase();
  return (
    /(^|[_-])(?:access|auth|id|refresh)?[_-]?token($|[_-])/.test(normalized) ||
    /(^|[_-])(?:api[_-]?key|captcha|challenge|credential|secret|signature|solution)(?:$|[_-])/.test(
      normalized,
    ) ||
    /^(?:authorization|bearer|cf_chl_|jsc_|session|trkinfo)/.test(normalized)
  );
}

function redactedOutputUrl(value: string) {
  try {
    const url = new URL(value);
    if (!webProtocols.has(url.protocol)) return "";
    url.username = "";
    url.password = "";
    url.hash = "";
    for (const name of [...url.searchParams.keys()]) {
      if (sensitiveQueryParameter(name)) url.searchParams.delete(name);
    }
    return url.href;
  } catch {
    return "";
  }
}

function cleanExtractedMarkdown(value: string) {
  return value
    .split("\n")
    .filter((line) => line.trim() !== "``")
    .join("\n")
    .replace(/\n{3,}/g, "\n\n")
    .trim();
}

function retrievalUrl(value: string) {
  if (value.length > 8192) {
    throw new RetrievalFailure(
      "policy",
      "url-too-long",
      "URL must be at most 8192 characters",
      false,
    );
  }
  let url: URL;
  try {
    url = new URL(value);
  } catch {
    throw new RetrievalFailure(
      "policy",
      "invalid-url",
      `invalid URL: ${value}`,
      false,
    );
  }
  if (!webProtocols.has(url.protocol)) {
    throw new RetrievalFailure(
      "policy",
      "unsupported-scheme",
      `URL must use HTTP or HTTPS: ${value}`,
      false,
      { decision: "blocked", reason: "unsupported-scheme", url: value },
    );
  }
  if (url.username || url.password) {
    throw new RetrievalFailure(
      "policy",
      "embedded-credentials",
      "URLs with embedded credentials are not allowed",
      false,
      {
        decision: "blocked",
        reason: "embedded-credentials",
        url: value,
      },
    );
  }
  url.hash = "";
  return url;
}

function normalizedHostname(hostname: string) {
  return hostname.startsWith("[") && hostname.endsWith("]")
    ? hostname.slice(1, -1)
    : hostname;
}

function isNonPublicAddress(address: string, family: number) {
  if (family === 4) return nonPublicAddresses.check(address, "ipv4");
  const mapped = address.toLowerCase().match(/^::ffff:(\d+\.\d+\.\d+\.\d+)$/);
  if (mapped) return nonPublicAddresses.check(mapped[1], "ipv4");
  return nonPublicAddresses.check(address, "ipv6");
}

async function checkRetrievalSafety(url: URL, allowPrivate: boolean) {
  const hostname = normalizedHostname(url.hostname).toLowerCase();
  let addresses: Array<{ address: string; family: number }>;
  const family = isIP(hostname);
  if (family) {
    addresses = [{ address: hostname, family }];
  } else {
    if (hostname === "localhost" || hostname.endsWith(".localhost")) {
      addresses = [{ address: "127.0.0.1", family: 4 }];
    } else {
      try {
        addresses = await lookup(hostname, { all: true, verbatim: true });
      } catch (error) {
        throw new RetrievalFailure(
          "network",
          "dns-failed",
          error instanceof Error ? error.message : String(error),
          true,
        );
      }
    }
  }
  if (!addresses.length) {
    throw new RetrievalFailure(
      "network",
      "dns-empty",
      `DNS returned no addresses for ${hostname}`,
      true,
    );
  }
  const resolved = [...new Set(addresses.map((record) => record.address))];
  const privateAddresses = addresses
    .filter((record) => isNonPublicAddress(record.address, record.family))
    .map((record) => record.address);
  if (privateAddresses.length && !allowPrivate) {
    const safety = {
      decision: "blocked",
      reason: "private-network",
      url: url.href,
      resolved_addresses: resolved,
    };
    throw new RetrievalFailure(
      "policy",
      "private-network",
      `private or non-public address requires --allow-private: ${url.href}`,
      false,
      safety,
    );
  }
  return {
    decision: "allowed",
    reason: privateAddresses.length
      ? "explicit-private-network-access"
      : "public-network",
    url: url.href,
    resolved_addresses: resolved,
  };
}

function explicitNetworkTarget(url: URL, allowPrivate: boolean) {
  if (allowPrivate) return;
  const hostname = normalizedHostname(url.hostname).toLowerCase();
  const family = isIP(hostname);
  if (
    hostname === "localhost" ||
    hostname.endsWith(".localhost") ||
    (family && isNonPublicAddress(hostname, family))
  ) {
    throw new RetrievalFailure(
      "policy",
      "private-network",
      `private or non-public address requires --allow-private: ${url.href}`,
      false,
    );
  }
}

async function safeProxy(allowPrivate: boolean) {
  const sockets = new Set<any>();
  const server = createHttpServer((request, response) => {
    void (async () => {
      const target = retrievalUrl(
        request.url?.startsWith("http://") || request.url?.startsWith("https://")
          ? request.url
          : `http://${String(request.headers.host || "")}${request.url || "/"}`,
      );
      if (target.protocol !== "http:") {
        throw new RetrievalFailure(
          "policy",
          "proxy-protocol",
          "non-tunneled proxy requests must use HTTP",
          false,
        );
      }
      const safety = await checkRetrievalSafety(target, allowPrivate);
      const address = String((safety.resolved_addresses as string[])[0]);
      const headers = { ...request.headers, host: target.host };
      delete headers["proxy-authorization"];
      delete headers["proxy-connection"];
      const upstream = httpRequest(
        {
          hostname: address,
          family: isIP(address),
          port: Number(target.port || 80),
          path: `${target.pathname}${target.search}`,
          method: request.method,
          headers,
        },
        (upstreamResponse) => {
          const responseHeaders = { ...upstreamResponse.headers };
          delete responseHeaders["x-agency-proxy-error"];
          response.writeHead(
            upstreamResponse.statusCode || 502,
            upstreamResponse.statusMessage,
            responseHeaders,
          );
          upstreamResponse.pipe(response);
        },
      );
      sockets.add(upstream);
      upstream.once("close", () => sockets.delete(upstream));
      upstream.once("error", (error) => response.destroy(error));
      request.pipe(upstream);
    })().catch((error) => {
      response.writeHead(error instanceof RetrievalFailure ? 403 : 502, {
        "content-type": "text/plain; charset=utf-8",
        connection: "close",
        "x-agency-proxy-error": error instanceof RetrievalFailure ? error.code : "proxy-failed",
      });
      response.end(error instanceof Error ? error.message : String(error));
    });
  });
  server.on("connection", (socket) => {
    sockets.add(socket);
    socket.once("close", () => sockets.delete(socket));
  });
  server.on("connect", (request, client, head) => {
    void (async () => {
      const authority = new URL(`http://${request.url || ""}`);
      const port = Number(authority.port || 443);
      if (!Number.isInteger(port) || port < 1 || port > 65535) {
        throw new RetrievalFailure("policy", "invalid-port", "invalid proxy target port", false);
      }
      const target = new URL(`https://${authority.hostname}:${port}/`);
      const safety = await checkRetrievalSafety(target, allowPrivate);
      const address = String((safety.resolved_addresses as string[])[0]);
      const upstream = connectTcp({ host: address, port, family: isIP(address) });
      sockets.add(upstream);
      upstream.once("close", () => sockets.delete(upstream));
      upstream.once("connect", () => {
        client.write("HTTP/1.1 200 Connection Established\r\n\r\n");
        if (head.length) upstream.write(head);
        client.pipe(upstream);
        upstream.pipe(client);
      });
      upstream.once("error", (error) => client.destroy(error));
    })().catch((error) => {
      client.end(
        `HTTP/1.1 403 Forbidden\r\nConnection: close\r\nContent-Length: 0\r\n\r\n`,
      );
      if (!(error instanceof RetrievalFailure)) console.error(error);
    });
  });
  await new Promise<void>((resolveReady, rejectReady) => {
    server.once("error", rejectReady);
    server.listen(0, "127.0.0.1", () => {
      server.off("error", rejectReady);
      resolveReady();
    });
  });
  const address = server.address();
  if (!address || typeof address === "string") throw new Error("safe proxy has no TCP address");
  return {
    url: `http://127.0.0.1:${address.port}`,
    port: address.port,
    async close() {
      for (const socket of sockets) socket.destroy();
      await new Promise<void>((resolveClose) => server.close(() => resolveClose()));
    },
  };
}

async function boundedResponseDigest(response: Response, maxBytes: number) {
  const lengthHeader = response.headers.get("content-length");
  const declaredLength = lengthHeader === null ? null : Number(lengthHeader);
  if (
    declaredLength !== null &&
    Number.isFinite(declaredLength) &&
    declaredLength > maxBytes
  ) {
    await response.body?.cancel();
    throw new RetrievalFailure(
      "limit",
      "response-too-large",
      `response declares ${declaredLength} bytes; limit is ${maxBytes}`,
      false,
    );
  }
  const hash = createHash("sha256");
  const reader = response.body?.getReader();
  let bytesRead = 0;
  if (reader) {
    while (true) {
      const chunk = await reader.read();
      if (chunk.done) break;
      bytesRead += chunk.value.byteLength;
      if (bytesRead > maxBytes) {
        await reader.cancel();
        throw new RetrievalFailure(
          "limit",
          "response-too-large",
          `response exceeded the ${maxBytes}-byte limit`,
          false,
        );
      }
      hash.update(chunk.value);
    }
  }
  return { bytesRead, sha256: hash.digest("hex") };
}

function retrievalError(error: unknown) {
  if (error instanceof RetrievalFailure) return error;
  if (error instanceof Error && error.name === "AbortError") {
    return new RetrievalFailure(
      "network",
      "timeout",
      "retrieval timed out",
      true,
    );
  }
  return new RetrievalFailure(
    "network",
    "fetch-failed",
    error instanceof Error ? error.message : String(error),
    true,
  );
}

async function retrieveOne(requestedUrl: string, options: RetrievalOptions) {
  const startedAt = new Date().toISOString();
  const started = performance.now();
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), options.timeoutMs);
  const redirectChain: JsonObject[] = [];
  const checkedHops: JsonObject[] = [];
  try {
    let current = retrievalUrl(requestedUrl);
    const normalizedUrl = current.href;
    while (true) {
      const safety = await checkRetrievalSafety(current, options.allowPrivate);
      checkedHops.push(safety);
      const response = await fetch(current, {
        redirect: "manual",
        signal: controller.signal,
        proxy: options.proxyUrl,
        headers: {
          accept: "*/*",
          "user-agent": "agency-web-research/1 direct-http",
        },
      });
      const proxyError = response.headers.get("x-agency-proxy-error");
      if (proxyError) {
        await response.body?.cancel();
        throw new RetrievalFailure(
          proxyError === "proxy-failed" ? "network" : "policy",
          proxyError,
          `safe proxy rejected ${current.href}`,
          proxyError === "proxy-failed",
        );
      }
      if (redirectStatuses.has(response.status)) {
        const location = response.headers.get("location");
        if (location) {
          if (redirectChain.length >= options.maxRedirects) {
            await response.body?.cancel();
            throw new RetrievalFailure(
              "limit",
              "too-many-redirects",
              `retrieval exceeded ${options.maxRedirects} redirects`,
              false,
            );
          }
          const next = retrievalUrl(new URL(location, current).href);
          redirectChain.push({
            url: current.href,
            http_status: response.status,
            location,
            next_url: next.href,
          });
          await response.body?.cancel();
          current = next;
          continue;
        }
      }
      const digest = await boundedResponseDigest(response, options.maxBytes);
      const completedAt = new Date().toISOString();
      const lengthHeader = response.headers.get("content-length");
      const declaredLength = lengthHeader === null ? null : Number(lengthHeader);
      const privateAccess = checkedHops.some(
        (hop) => hop.reason === "explicit-private-network-access",
      );
      return {
        request: { url: requestedUrl, normalized_url: normalizedUrl },
        outcome: "retrieved",
        safety: {
          decision: "allowed",
          reason: privateAccess
            ? "explicit-private-network-access"
            : "public-network",
          checked_hops: checkedHops,
        },
        provenance: {
          provider: "direct-http",
          mode: "live",
          retrieved_at: completedAt,
          cache_age_seconds: 0,
          fallback: null,
        },
        retrieval: {
          final_url: current.href,
          redirect_chain: redirectChain,
          http_status: response.status,
          content_type: response.headers.get("content-type") || "",
          declared_content_length:
            declaredLength !== null && Number.isFinite(declaredLength)
            ? declaredLength
            : null,
          bytes_read: digest.bytesRead,
          sha256: digest.sha256,
          started_at: startedAt,
          completed_at: completedAt,
          duration_ms: Math.round((performance.now() - started) * 1000) / 1000,
        },
      };
    }
  } catch (unknownError) {
    const error = retrievalError(unknownError);
    const completedAt = new Date().toISOString();
    return {
      request: { url: requestedUrl },
      outcome: "failed",
      safety:
        error.safety ||
        (error.kind === "policy"
          ? { decision: "blocked", reason: error.code }
          : { decision: "not-completed", reason: error.code }),
      provenance: {
        provider: "direct-http",
        mode: "live",
        attempted_at: completedAt,
        cache_age_seconds: 0,
        fallback: null,
      },
      error: {
        kind: error.kind,
        code: error.code,
        message: error.message,
        retriable: error.retriable,
      },
    };
  } finally {
    clearTimeout(timeout);
  }
}

function checkedProfile(value: string) {
  if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(value) || value === "..") {
    fail(
      "profile names use 1–64 letters, numbers, dots, underscores, or hyphens",
    );
  }
  return value;
}

function sleep(milliseconds: number) {
  return new Promise((resolve) => setTimeout(resolve, milliseconds));
}

async function boundedMap<T, U>(
  values: T[],
  concurrency: number,
  operation: (value: T, index: number) => Promise<U>,
) {
  const results = new Array<U>(values.length);
  let next = 0;
  const workers = Array.from(
    { length: Math.min(concurrency, values.length) },
    async () => {
      while (true) {
        const index = next;
        next += 1;
        if (index >= values.length) return;
        results[index] = await operation(values[index], index);
      }
    },
  );
  await Promise.all(workers);
  return results;
}

function choosePort() {
  const server = Bun.serve({ port: 0, fetch: () => new Response("reserved") });
  const port = server.port;
  server.stop(true);
  return port;
}

