const args = Bun.argv.slice(2);
const command = args.shift();

try {
  if (
    !command ||
    command === "help" ||
    command === "--help" ||
    command === "-h"
  )
    help();
  else if (args.includes("--help") || args.includes("-h")) help();
  else if (command === "search") await commandSearch(args);
  else if (command === "search-many") await commandSearchMany(args);
  else if (command === "search-batch") await commandSearchBatch(args);
  else if (command === "scrape-batch") await commandScrapeBatch(args);
  else if (command === "retrieve") await commandRetrieve(args);
  else if (command === "download") await commandDownload(args);
  else if (command === "scrape" || command === "fetch")
    await commandScrape(args);
  else if (command === "scrape-many") await commandScrapeMany(args);
  else if (command === "replay") commandReplay(args);
  else if (command === "capture-gc") commandCaptureGc(args);
  else if (command === "map") await commandMap(args);
  else if (command === "snapshot") await commandSnapshot(args);
  else if (command === "crawl") await commandCrawl(args);
  else if (command === "local") commandLocal(args);
  else if (command === "stats") commandStats(args);
  else if (command === "browser") await commandBrowser(args);
  else fail(`unknown command: ${command}`);
} catch (error) {
  fail(error instanceof Error ? error.message : String(error));
}
