type PageAccessSignals = {
  title: string;
  url: string;
  text: string;
  challengeControl: boolean;
  loginControl: boolean;
  mainTextLength?: number;
  articleCount?: number;
  contentLinks?: number;
  structuredDataChars?: number;
};

type PageAccessKind =
  | "challenge"
  | "login"
  | "rate-limit"
  | "soft-challenge"
  | "soft-login"
  | "none";

function classifyPageAccess(signals: PageAccessSignals): PageAccessKind {
  const title = String(signals.title || "").trim().toLowerCase();
  const text = String(signals.text || "").toLowerCase();
  const compact = `${title}\n${text}`;
  if (
    /^(?:429|too many requests|rate limit(?:ed| exceeded)?)(?:\b|[.!…-])/.test(
      title,
    ) ||
    ["rate limit exceeded", "too many requests", "try again later"].filter(
      (phrase) => compact.includes(phrase),
    ).length >= 2
  ) {
    return "rate-limit";
  }
  const challengePhrases = [
    "verify you are human",
    "checking your browser",
    "complete the security check",
    "security verification",
    "unusual traffic",
    "enable javascript and cookies to continue",
  ];
  const challengeEvidence = challengePhrases.filter((phrase) =>
    compact.includes(phrase),
  ).length;
  const challengeTitle = /^(?:attention required|checking your browser|just a moment|security check|verify you are human)(?:\b|[.!…-])/.test(
    title,
  );
  const hasPublicEvidence =
    Number(signals.mainTextLength || 0) >= 600 ||
    Number(signals.structuredDataChars || 0) >= 200 ||
    (Number(signals.articleCount || 0) >= 2 &&
      Number(signals.contentLinks || 0) >= 3) ||
    (Number(signals.mainTextLength || 0) >= 250 &&
      Number(signals.contentLinks || 0) >= 8);
  if (
    signals.challengeControl ||
    challengeEvidence >= 2 ||
    (challengeTitle && (challengeEvidence >= 1 || !hasPublicEvidence))
  ) {
    if (
      hasPublicEvidence &&
      signals.challengeControl &&
      !challengeTitle &&
      challengeEvidence < 2
    ) {
      return "soft-challenge";
    }
    return "challenge";
  }
  let path = "";
  try {
    path = new URL(signals.url).pathname.toLowerCase();
  } catch {}
  const loginPath = /\/(?:authwall|checkpoint|login|signin|sign-in)(?:\/|$)/.test(
    path,
  );
  const loginPhrase = [
    "sign in",
    "log in",
    "authentication required",
    "session expired",
  ].some((phrase) => compact.includes(phrase));
  if (signals.loginControl || (loginPath && loginPhrase)) {
    if (signals.loginControl && hasPublicEvidence && !loginPath) {
      return "soft-login";
    }
    return "login";
  }
  return "none";
}

async function pageAccessState(
  browser: Awaited<ReturnType<typeof startBrowser>>,
) {
  const signals = JSON.parse(
    String(await browser.bidi.evaluate(browser.context, pageAccessExpression)),
  ) as PageAccessSignals;
  return { kind: classifyPageAccess(signals), signals };
}

async function waitForPageAccess(
  browser: Awaited<ReturnType<typeof startBrowser>>,
  options: BrowserOptions,
) {
  let state = await pageAccessState(browser);
  if (state.kind === "rate-limit") {
    throw new Error("origin rate limited; retry later");
  }
  if (
    state.kind === "none" ||
    state.kind === "soft-login" ||
    state.kind === "soft-challenge"
  ) {
    return state;
  }
  const label = state.kind === "login" ? "login" : "challenge";
  if (options.headless) {
    throw new Error(
      `interactive ${label} required; use browser for interactive setup or rerun with --visible`,
    );
  }
  if (options.humanTimeout === 0) {
    throw new Error(`interactive ${label} required`);
  }
  info(
    `interactive ${label} open in Firefox: ${state.signals.title || redactedOutputUrl(state.signals.url)}`,
  );
  process.stderr.write(
    `${yellow}  Complete it in the browser; no browser state or response token is exposed to the agent.${reset}\n`,
  );
  const deadline = Date.now() + options.humanTimeout * 1000;
  let nextUpdate = Date.now() + 30_000;
  while (Date.now() < deadline) {
    await sleep(1_500);
    state = await pageAccessState(browser);
    if (state.kind === "rate-limit") {
      throw new Error("origin rate limited; retry later");
    }
    if (
      state.kind === "none" ||
      state.kind === "soft-login" ||
      state.kind === "soft-challenge"
    ) {
      info(`${label} cleared; continuing local extraction`);
      return state;
    }
    if (Date.now() >= nextUpdate) {
      info(`still waiting for the browser ${label}`);
      nextUpdate = Date.now() + 30_000;
    }
  }
  throw new Error(
    `interactive ${label} was not cleared within ${options.humanTimeout} seconds`,
  );
}

