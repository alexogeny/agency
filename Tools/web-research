    const company = clean(container.querySelector('[itemprop="hiringOrganization"], [class*="company" i], [class*="employer" i]')?.textContent || '').slice(0, 500)
    const location = clean(container.querySelector('[itemprop="jobLocation"], [class*="location" i], [class*="locality" i]')?.textContent || '').slice(0, 500)
    const time = container.querySelector('time, [itemprop="datePosted"], [class*="posted" i], [class*="listed" i]')
    const containerText = clean(container.textContent || '')
    const ageMatch = (clean(time?.textContent || '') + '\n' + containerText).match(/\b(?:posted|listed|published)?\s*(today|yesterday|\d+\s*(?:minutes?|mins?|m|hours?|hrs?|h|days?|d|weeks?|w|months?|mos?)\s+ago)\b/i)
    const postingAge = clean(ageMatch?.[0] || '').slice(0, 100)
    const published = clean(time?.getAttribute?.('datetime') || time?.getAttribute?.('content') || '').slice(0, 100)
    jobCards.push({
      title,
      url,
      company,
      location,
      posting_age: postingAge,
      published,
      summary: containerText.slice(0, 1200),
    })
    if (jobCards.length >= 100) break
  }
  const sources = []
  if (text || markdown) sources.push('rendered-dom')
  if (Object.keys(metadata).length) sources.push('page-metadata')
  if (jsonLd.length) sources.push('json-ld')
  return JSON.stringify({
    title: document.title || "",
    url: absolute(location.href),
    canonicalUrl: canonical,
    published: clean(published),
    byline: clean(byline),
    text: text.slice(0, maxContentChars),
    markdown: markdown.slice(0, maxContentChars),
    html: html.slice(0, maxContentChars),
    links: uniqueLinks.slice(0, maxLinks),
    jobs: jobCards,
    structured: Object.keys(metadata).length || jsonLd.length ? { metadata, jsonLd } : undefined,
    sources,
    truncated: {
      text: text.length > maxContentChars,
      markdown: markdown.length > maxContentChars,
      html: html.length > maxContentChars,
      links: uniqueLinks.length > maxLinks,
    },
  })
})()`;
}

const interactionExpression = String.raw`(() => {
  const roots = [document]
  let inspected = 0
  scan: for (let index = 0; index < roots.length && roots.length < 64; index += 1) {
    for (const element of roots[index].querySelectorAll('*')) {
      inspected += 1
      if (element.shadowRoot) roots.push(element.shadowRoot)
      if (inspected >= 50000 || roots.length >= 64) break scan
    }
  }
  const visible = element => {
    const style = getComputedStyle(element)
    const bounds = element.getBoundingClientRect()
    return style.display !== 'none' && style.visibility !== 'hidden' && bounds.width > 0 && bounds.height > 0
  }
  const candidates = roots.flatMap(root => [...root.querySelectorAll('button, [role="button"], summary')])
  const choices = []
  for (const element of candidates) {
    if (!visible(element) || element.disabled || element.dataset.agencyInteractionCandidate || element.closest('form, [contenteditable="true"]')) continue
    const label = (element.getAttribute('aria-label') || element.innerText || element.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 160)
    const normalized = label.toLowerCase()
    const dialog = element.closest('[role="dialog"], dialog, [aria-modal="true"]')
    const content = element.closest('article, main, [role="main"], [role="feed"], [role="list"]')
    const excluded = element.closest('nav, header, aside, [role="navigation"]') || /(?:user|account|profile|navigation|menu|filter|sort|share|settings|options)/.test(normalized)
    let kind = ''
    let priority = 0
    if (dialog && /^(?:close|dismiss|not now|maybe later|no thanks|continue without(?: accepting)?)(?:\b|[.!…])/.test(normalized)) {
      kind = 'dismiss'
      priority = 3
    } else if (content && !excluded && /^(?:load|show|view|see) more(?:\b|[.!…])|more (?:comments|replies|posts|results)/.test(normalized)) {
      kind = 'load-more'
      priority = 2
    } else if (content && !excluded && (/^(?:read|show|view|see|continue reading) more(?:\b|[.!…])|^(?:more details|expand (?:content|details|section|text|post|comment))(?:\b|[.!…])/.test(normalized))) {
      kind = 'expand'
      priority = 1
    }
    if (kind) choices.push({ element, kind, label, priority })
  }
  choices.sort((left, right) => right.priority - left.priority)
  const choice = choices[0]
  if (!choice) return ''
  choice.element.dataset.agencyInteractionCandidate = 'handled'
  choice.element.click()
  return JSON.stringify({ kind: choice.kind, label: choice.label })
})()`;

const scrollExpression = String.raw`(() => {
  const agencyScrollTarget = true
  const roots = [document]
  let inspected = 0
  scan: for (let index = 0; index < roots.length && roots.length < 64; index += 1) {
    for (const element of roots[index].querySelectorAll('*')) {
      inspected += 1
      if (element.shadowRoot) roots.push(element.shadowRoot)
      if (inspected >= 50000 || roots.length >= 64) break scan
    }
  }
  const candidates = roots.flatMap(root => [...root.querySelectorAll('main, [role="main"], [role="feed"], [role="list"], section, div')]).filter(element => {
    const style = getComputedStyle(element)
    const bounds = element.getBoundingClientRect()
    return bounds.width > 0 && bounds.height >= 150 && ['auto', 'scroll'].includes(style.overflowY) && element.scrollHeight - element.clientHeight > 100
  })
  candidates.sort((left, right) => {
    const score = element => (element.innerText || '').length + element.querySelectorAll('article, [role="article"]').length * 500
    return score(right) - score(left)
  })
  const target = candidates[0]
  if (target) {
    const before = target.scrollTop
    target.scrollTop = target.scrollHeight
    return JSON.stringify({ target: 'container', moved: target.scrollTop !== before })
  }
  const before = window.scrollY
  window.scrollTo(0, document.documentElement?.scrollHeight || document.body?.scrollHeight || 0)
  return JSON.stringify({ target: 'document', moved: window.scrollY !== before })
})()`;

type PageCaptureInput = {
  schema: "agency/web-capture-input/1";
  requested_url: string;
  options: {
    max_content_chars: number;
    max_links: number;
  };
  captures: Page[];
  access_states: PageAccessKind[];
  actions: PageAction[];
  scroll_targets: string[];
  network: NetworkEvidence[];
  frames: JsonObject[];
  navigation?: {
    outcome: "timeout";
    failed_stage: "navigation";
    attempts: number;
  };
};

const pageCaptures = new WeakMap<Page, PageCaptureInput>();

function addEvidenceReference(
  provenance: Record<string, EvidenceReference[]>,
  field: string,
  reference: EvidenceReference,
) {
  const references = provenance[field] || [];
  if (
    !references.some(
      (candidate) =>
        candidate.source === reference.source &&
        candidate.capture === reference.capture,
    )
  ) {
    references.push(reference);
  }
  provenance[field] = references;
}

const topicStopWords = new Set([
  "about",
  "after",
  "before",
  "from",
  "into",
  "page",
  "requested",
  "that",
  "their",
  "this",
  "with",
]);

function topicTerms(value: string, maximumCharacters: number) {
  const terms = value
    .slice(0, maximumCharacters)
    .toLocaleLowerCase()
    .match(/[\p{L}\p{N}]{4,}/gu) || [];
  return new Set(terms.filter((term) => !topicStopWords.has(term)));
}

function fusePageCapture(input: PageCaptureInput, identity = "live") {
  const maxContentChars = input.options.max_content_chars;
  const maxLinks = input.options.max_links;
  const mergeBlocks = (values: string[]) => {
    const seen = new Set<string>();
    const blocks: string[] = [];
    let length = 0;
    let wasTruncated = false;
    let duplicates = 0;
    for (const value of values) {
      for (const rawBlock of value.split(/\n{2,}/)) {
        const block = rawBlock.trim();
        if (!block) continue;
        const key = block.replace(/\s+/g, " ");
        if (seen.has(key)) {
          duplicates += 1;
          continue;
        }
        seen.add(key);
        const separator = blocks.length ? "\n\n" : "";
        const remaining = maxContentChars - length - separator.length;
        if (remaining <= 0) {
          wasTruncated = true;
          continue;
        }
        const kept = block.slice(0, remaining);
        blocks.push(kept);
        length += separator.length + kept.length;
        if (kept.length < block.length) wasTruncated = true;
      }
    }
    return { value: blocks.join("\n\n"), wasTruncated, duplicates };
  };
  const textResult = mergeBlocks(input.captures.map((capture) => capture.text));
  const markdownResult = mergeBlocks(
    input.captures.map((capture) => cleanExtractedMarkdown(capture.markdown)),
  );
  const metadata: Record<string, string> = {};
  const jsonLd: unknown[] = [];
  const seenJsonLd = new Set<string>();
  const jobs: JobCard[] = [];
  const seenJobs = new Set<string>();
  const sources = new Set<string>();
  const provenance: Record<string, EvidenceReference[]> = {};
  for (const [index, capture] of input.captures.entries()) {
    const renderedReference: EvidenceReference = {
      source: "rendered-dom",
      capture: `${identity}:page:${index}`,
    };
    if (capture.text) addEvidenceReference(provenance, "text", renderedReference);
    if (capture.markdown) {
      addEvidenceReference(provenance, "markdown", renderedReference);
    }
    if (capture.links.length) {
      addEvidenceReference(provenance, "links", renderedReference);
    }
    for (const source of capture.sources || []) sources.add(source);
    for (const [name, value] of Object.entries(
      capture.structured?.metadata || {},
    )) {
      if (!metadata[name] && value) metadata[name] = value;
      if (value) {
        addEvidenceReference(provenance, `structured.metadata.${name}`, {
          source: "page-metadata",
          capture: `${identity}:page:${index}`,
        });
      }
    }
    for (const value of capture.structured?.jsonLd || []) {
      const key = JSON.stringify(value);
      if (seenJsonLd.has(key)) continue;
      seenJsonLd.add(key);
      const retainedIndex = jsonLd.length;
      jsonLd.push(value);
      addEvidenceReference(provenance, `structured.jsonLd.${retainedIndex}`, {
        source: "json-ld",
        capture: `${identity}:page:${index}`,
      });
    }
    for (const job of capture.jobs || []) {
      const key = `${job.url}\n${job.title.toLocaleLowerCase()}`;
      if (seenJobs.has(key)) continue;
      seenJobs.add(key);
      const retainedIndex = jobs.length;
      jobs.push(job);
      addEvidenceReference(provenance, `jobs.${retainedIndex}`, renderedReference);
    }
  }
  const structured =
    Object.keys(metadata).length || jsonLd.length
      ? { metadata, jsonLd }
      : undefined;
  let text = textResult.value;
  let markdown = markdownResult.value;
  let textWasTruncated = textResult.wasTruncated;
  let markdownWasTruncated = markdownResult.wasTruncated;
  if (structured && text.length < 500) {
    const evidence = [
      ...Object.entries(structured.metadata).map(
        ([name, value]) => `${name}: ${value}`,
      ),
      ...structured.jsonLd.map((value) => JSON.stringify(value)),
    ].join("\n");
    if (evidence) {
      const fusedText = mergeBlocks([text, evidence]);
      const fusedMarkdown = mergeBlocks([
        markdown,
        `## Structured page evidence\n\n${evidence}`,
      ]);
      text = fusedText.value;
      markdown = fusedMarkdown.value;
      textWasTruncated ||= fusedText.wasTruncated;
      markdownWasTruncated ||= fusedMarkdown.wasTruncated;
      for (const [field, references] of Object.entries(provenance)) {
        if (!field.startsWith("structured.")) continue;
        for (const reference of references) {
          addEvidenceReference(provenance, "text", reference);
          addEvidenceReference(provenance, "markdown", reference);
        }
      }
    }
  }
  const finalIndex = input.captures.length - 1;
  const finalPage = input.captures[finalIndex];
  const finalReference: EvidenceReference = {
    source: "rendered-dom",
    capture: `${identity}:page:${finalIndex}`,
  };
  for (const field of [
    "title",
    "url",
    "canonicalUrl",
    "published",
    "byline",
    "html",
  ]) {
    if (String(finalPage[field as keyof Page] || "")) {
      addEvidenceReference(provenance, field, finalReference);
    }
  }
  const url = redactedOutputUrl(finalPage.url);
  const canonicalUrl = redactedOutputUrl(finalPage.canonicalUrl) || url;
  const html = finalPage.html.slice(0, maxContentChars);
  const uniqueLinkSet = new Set<string>();
  for (const capture of input.captures) {
    for (const link of capture.links) {
      const redacted = redactedOutputUrl(link);
      if (redacted) uniqueLinkSet.add(redacted);
    }
  }
  const uniqueLinks = [...uniqueLinkSet];
  const links = uniqueLinks.slice(0, maxLinks);
  const accessState: PageAccessState = input.access_states.includes(
    "soft-challenge",
  )
    ? "soft-challenge"
    : input.access_states.includes("soft-login")
      ? "soft-login"
      : "public";
  const state =
    accessState !== "public"
      ? "soft-gated-content"
      : text || markdown
        ? "public-content"
        : "structured-only";
  const truncated = {
    text:
      textWasTruncated ||
      input.captures.some((capture) => capture.truncated?.text),
    markdown:
      markdownWasTruncated ||
      input.captures.some((capture) => capture.truncated?.markdown),
    html:
      input.captures.some((capture) => capture.truncated?.html) ||
      finalPage.html.length > maxContentChars,
    links:
      input.captures.some((capture) => capture.truncated?.links) ||
      uniqueLinks.length > maxLinks,
  };
  const page: Page = {
    ...finalPage,
    url,
    canonicalUrl,
    text,
    markdown,
    html,
    links,
    ...(jobs.length ? { jobs } : {}),
    ...(structured ? { structured } : {}),
    sources: [...sources],
    access: { state: accessState },
    state,
    captures: input.captures.length,
    actions: input.actions,
    scroll_targets: input.scroll_targets,
    truncated,
    provenance,
    quality: [],
  };
  attachNetworkEvidence(page, input.network, {
    maxContentChars,
  });
  for (const [index] of input.network.entries()) {
    const reference: EvidenceReference = {
      source: "network-json",
      capture: `${identity}:network:${index}`,
    };
    addEvidenceReference(provenance, `network.${index}`, reference);
    if (page.text.includes(JSON.stringify(input.network[index].body))) {
      addEvidenceReference(provenance, "text", reference);
      addEvidenceReference(provenance, "markdown", reference);
    }
  }
  if (input.frames.length) {
    page.frames = input.frames.map((frame, index) => {
      if (frame.status !== "extracted") return frame;
      const reference: EvidenceReference = {
        source: "frame",
        capture: `${identity}:frame:${index}`,
      };
      return {
        ...frame,
        provenance: {
          ...(frame.title ? { title: [reference] } : {}),
          ...(frame.text ? { text: [reference] } : {}),
        },
      };
    });
  }
  const duplicateBlocks = Math.max(
    textResult.duplicates,
    markdownResult.duplicates,
  );
  if (duplicateBlocks) {
    page.quality!.push({
      code: "repeated-blocks",
      fields: ["text", "markdown"],
      observation: `${duplicateBlocks} repeated content block${duplicateBlocks === 1 ? " was" : "s were"} removed during fusion`,
    });
  }
  const titleCandidates = [metadata["og:title"], metadata["twitter:title"]]
    .filter(Boolean)
    .filter(
      (candidate) =>
        candidate.trim().toLocaleLowerCase() !==
        finalPage.title.trim().toLocaleLowerCase(),
    );
  if (finalPage.title && titleCandidates.length) {
    page.quality!.push({
      code: "title-disagreement",
      fields: ["title", "structured.metadata.og:title"],
      observation: "Rendered and structured title fields disagree",
    });
  }
  const renderedText = textResult.value.trim();
  if (renderedText.length < 400) {
    page.quality!.push({
      code: "thin-content",
      fields: ["text", "markdown"],
      observation: `Only ${renderedText.length} rendered main-text characters were retained`,
      recommendation:
        "Inspect linked content pages or retry with bounded --interaction-steps and --capture-network-json",
    });
  }
  const topicTitleField = metadata["og:title"]
    ? "structured.metadata.og:title"
    : metadata["twitter:title"]
      ? "structured.metadata.twitter:title"
      : "title";
  const topicTitle =
    metadata["og:title"] || metadata["twitter:title"] || finalPage.title;
  const titleTerms = topicTerms(topicTitle, 500);
  const bodyTerms = topicTerms(renderedText, 20_000);
  const sharedTitleTerms = [...titleTerms].filter((term) => bodyTerms.has(term));
  if (
    renderedText.length >= 80 &&
    titleTerms.size >= 2 &&
    sharedTitleTerms.length / titleTerms.size < 0.25
  ) {
    page.quality!.push({
      code: "title-body-mismatch",
      fields: [topicTitleField, "text", "markdown"],
      observation:
        "The retained main text has little topic overlap with the rendered page title",
      recommendation:
        "Inspect linked content pages or retry with bounded --interaction-steps and --capture-network-json",
    });
  }
  if (state === "structured-only") {
    page.quality!.push({
      code: "weak-structured-only",
      fields: ["text", "structured"],
      observation: "The page retained structured evidence without rendered main content",
    });
  }
  if (links.length >= 20 && text.length < links.length * 80) {
    page.quality!.push({
      code: "link-heavy-content",
      fields: ["text", "links"],
      observation: `${links.length} links were retained with ${text.length} text characters`,
    });
  }
  const truncatedFields = Object.entries(truncated)
    .filter(([, value]) => value)
    .map(([field]) => field);
  if (truncatedFields.length) {
    page.quality!.push({
      code: "truncated-fields",
      fields: truncatedFields,
      observation: `Configured bounds truncated: ${truncatedFields.join(", ")}`,
    });
  }
  if (input.navigation?.outcome === "timeout") {
    page.outcome = "partial";
    page.constraint = "navigation-timeout";
    page.failed_stage = input.navigation.failed_stage;
    page.navigation_attempts = input.navigation.attempts;
    page.quality!.push({
      code: "navigation-timeout",
      fields: ["text", "markdown", "network"],
      observation:
        "Navigation exceeded its deadline; retained evidence may represent an incompletely loaded page",
      recommendation:
        "Review the retained fields, increase --navigation-timeout-ms, or retry with --navigation-retries 1",
    });
  }
  return page;
}

async function extractPage(
  browser: Awaited<ReturnType<typeof startBrowser>>,
  options: BrowserOptions,
) {
  const expression = extractionExpression(options);
  const readPage = async () =>
    JSON.parse(
      String(await browser.bidi.evaluate(browser.context, expression)),
    ) as Page;
  const hasExtractableContent = (page: Page) =>
    Boolean(
      page.text.trim() ||
        page.markdown.trim() ||
        page.links.length ||
        Object.keys(page.structured?.metadata || {}).length ||
        page.structured?.jsonLd.length,
    );
  const captures: Page[] = [];
  const accessStates: PageAccessKind[] = [];
  let stability = await settlePage(browser, options);
  let access = await waitForPageAccess(browser, options);
  accessStates.push(access.kind);
  let page = await readPage();
  if (!hasExtractableContent(page)) {
    await sleep(500);
    access = await waitForPageAccess(browser, options);
    accessStates.push(access.kind);
    page = await readPage();
  }
  if (!hasExtractableContent(page)) {
    throw new Error("page did not expose extractable content after navigation");
  }
  captures.push(page);
  const actions: PageAction[] = [];
  const scrollTargets: string[] = [];
  for (let step = 0; step < options.interactionSteps; step += 1) {
    const rawAction = String(
      await browser.bidi.evaluate(browser.context, interactionExpression),
    );
    if (!rawAction) break;
    const action = JSON.parse(rawAction) as Omit<PageAction, "changed">;
    const previousPage = captures[captures.length - 1];
    try {
      stability = await settlePage(browser, options);
      access = await waitForPageAccess(browser, options);
      accessStates.push(access.kind);
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      if (!message.includes("interactive ")) throw error;
      actions.push({ ...action, changed: false, blocked: true });
      break;
    }
    const nextPage = await readPage();
    const changed =
      nextPage.text !== previousPage.text ||
      nextPage.markdown !== previousPage.markdown ||
      nextPage.links.join("\n") !== previousPage.links.join("\n");
    actions.push({ ...action, changed });
    if (hasExtractableContent(nextPage) && changed) captures.push(nextPage);
  }
  for (let step = 0; step < options.scrollSteps; step += 1) {
    const previousStability = stability;
    const previousPage = captures[captures.length - 1];
    const rawScroll = String(
      await browser.bidi.evaluate(browser.context, scrollExpression),
    );
    let scroll = { target: "document", moved: true };
    try {
      scroll = JSON.parse(rawScroll);
    } catch {}
    scrollTargets.push(scroll.target);
    stability = await settlePage(browser, options);
    access = await waitForPageAccess(browser, options);
    accessStates.push(access.kind);
    const nextPage = await readPage();
    if (hasExtractableContent(nextPage)) captures.push(nextPage);
    const contentChanged =
      nextPage.text !== previousPage.text ||
      nextPage.markdown !== previousPage.markdown ||
      nextPage.links.join("\n") !== previousPage.links.join("\n");
    if (stability.scrollHeight <= previousStability.scrollHeight && !contentChanged) {
      break;
    }
  }
  const input: PageCaptureInput = {
    schema: "agency/web-capture-input/1",
    requested_url: redactedOutputUrl(captures[0].url),
    options: {
      max_content_chars: options.maxContentChars,
      max_links: options.maxLinks,
    },
    captures,
    access_states: accessStates,
    actions,
    scroll_targets: scrollTargets,
    network: [],
    frames: [],
  };
  const fused = fusePageCapture(input);
  pageCaptures.set(fused, input);
  return fused;
}

function attachNetworkEvidence(
  page: Page,
  evidence: NetworkEvidence[],
  options: { maxContentChars: number },
) {
  if (!evidence.length) return page;
  page.network = evidence;
  page.sources = [...new Set([...(page.sources || []), "network-json"])];
  if (page.text.length < 500) {
    const serialized = evidence.map((item) => JSON.stringify(item.body)).join("\n");
    const textSeparator = page.text ? "\n\n" : "";
    const markdownSeparator = page.markdown ? "\n\n" : "";
    const textRemaining =
      options.maxContentChars - page.text.length - textSeparator.length;
    const markdownHeading = "## Network JSON evidence\n\n";
    const markdownRemaining =
      options.maxContentChars -
      page.markdown.length -
      markdownSeparator.length -
      markdownHeading.length;
    if (textRemaining > 0) {
      page.text += textSeparator + serialized.slice(0, textRemaining);
    }
    if (markdownRemaining > 0) {
      page.markdown +=
        markdownSeparator +
        markdownHeading +
        serialized.slice(0, markdownRemaining);
    }
    if (serialized.length > textRemaining) page.truncated!.text = true;
    if (serialized.length > markdownRemaining) page.truncated!.markdown = true;
  }
  return page;
}

async function navigateAndExtract(
  browser: Awaited<ReturnType<typeof startBrowser>>,
  url: string,
  options: BrowserOptions,
) {
  explicitNetworkTarget(retrievalUrl(url), options.allowPrivate);
  const navigationHealth = await startNavigationHealth(browser, url);
  const networkCapture = await startNetworkCapture(
    browser,
    url,
    options.captureNetworkJson,
  );
  let finished = false;
  let navigationTimedOut = false;
  let navigationAttempts = 0;
  try {
    for (let attempt = 0; attempt <= options.navigationRetries; attempt += 1) {
      navigationAttempts += 1;
      try {
        await browser.bidi.navigate(
          browser.context,
          url,
          options.navigationTimeoutMs,
        );
        navigationTimedOut = false;
        break;
      } catch (error) {
        const message = error instanceof Error ? error.message : String(error);
        if (!/(?:navigation|browsingContext\.navigate).*timed out/i.test(message)) {
          throw error;
        }
        navigationTimedOut = true;
        if (attempt < options.navigationRetries) {
          info(
            `navigation timed out; retrying (${attempt + 1}/${options.navigationRetries})`,
          );
        }
      }
    }
    let page: Page;
    try {
      page = await extractPage(browser, options);
    } catch (extractionError) {
      if (!navigationTimedOut) throw extractionError;
      const evidence = await networkCapture.finish();
      finished = true;
      if (!evidence.length) throw extractionError;
      const sanitizedUrl = redactedOutputUrl(url);
      const input: PageCaptureInput = {
        schema: "agency/web-capture-input/1",
        requested_url: sanitizedUrl,
        options: {
          max_content_chars: options.maxContentChars,
          max_links: options.maxLinks,
        },
        captures: [
          {
            title: "",
            url: sanitizedUrl,
            canonicalUrl: sanitizedUrl,
            published: "",
            byline: "",
            text: "",
            markdown: "",
            html: "",
            links: [],
            sources: [],
            truncated: {
              text: false,
              markdown: false,
              html: false,
              links: false,
            },
          },
        ],
        access_states: [],
        actions: [],
        scroll_targets: [],
        network: evidence,
        frames: [],
        navigation: {
          outcome: "timeout",
          failed_stage: "navigation",
          attempts: navigationAttempts,
        },
      };
      const fused = fusePageCapture(input);
      pageCaptures.set(fused, input);
      return fused;
    }
    const evidence = await networkCapture.finish();
    finished = true;
    const input = pageCaptures.get(page);
    if (!input) throw new Error("page capture state is unavailable");
    input.network = evidence;
    if (navigationTimedOut) {
      input.navigation = {
        outcome: "timeout",
        failed_stage: "navigation",
        attempts: navigationAttempts,
      };
    }
    if (!evidence.length && !navigationTimedOut) return page;
    const fused = fusePageCapture(input);
    pageCaptures.set(fused, input);
    return fused;
  } catch (error) {
    const { retryAfterSeconds } = navigationHealth.snapshot();
    if (retryAfterSeconds !== null && error && typeof error === "object") {
      (error as Error & { retryAfterSeconds?: number }).retryAfterSeconds =
        retryAfterSeconds;
    }
    throw error;
  } finally {
    navigationHealth.close();
    if (!finished) await networkCapture.close();
  }
}

const frameExtractExpression = String.raw`(() => {
  const candidates = [...document.querySelectorAll('article, main, [role="main"], .article-body, .article-content, .post-content, .entry-content, #content')]
  const score = element => (element.innerText || "").length - [...element.querySelectorAll("a")].reduce((total, link) => total + (link.innerText || "").length, 0) * 0.35
  const source = candidates.sort((a, b) => score(b) - score(a))[0] || document.body
  const clean = value => value.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g, "").replace(/[ \t\f\v]+/g, " ").replace(/ *\n */g, "\n").replace(/\n{3,}/g, "\n\n").trim()
  return JSON.stringify({ title: document.title || "", text: clean(source?.innerText || "") })
})()`;

type BrowsingContextNode = {
  context?: string;
  url?: string;
  children?: BrowsingContextNode[];
};

function childContexts(nodes: BrowsingContextNode[]) {
  const children: BrowsingContextNode[] = [];
  const visit = (node: BrowsingContextNode) => {
    for (const child of node.children || []) {
      children.push(child);
      visit(child);
    }
  };
  for (const node of nodes) visit(node);
  return children;
}

async function extractFrames(
  browser: Awaited<ReturnType<typeof startBrowser>>,
  topOrigin: string,
  extraOrigins: string[],
) {
  const allowedOrigins = new Set([topOrigin, ...extraOrigins]);
  const tree = await browser.bidi.tree();
  const frames: JsonObject[] = [];
  for (const node of childContexts(tree.contexts || [])) {
    let frameUrl: URL;
    try {
      frameUrl = new URL(String(node.url || ""));
    } catch {
      frames.push({
        status: "skipped",
        reason: "invalid-frame-url",
        origin: "",
        path: "",
      });
      continue;
    }
    const identity = { origin: frameUrl.origin, path: frameUrl.pathname };
    if (!allowedOrigins.has(frameUrl.origin)) {
      frames.push({
        status: "skipped",
        reason: "cross-origin",
        ...identity,
      });
      continue;
    }
    if (!node.context) {
      frames.push({
        status: "skipped",
        reason: "missing-context",
        ...identity,
      });
      continue;
    }
    try {
      const extracted = JSON.parse(
        String(
          await browser.bidi.evaluate(node.context, frameExtractExpression),
        ),
      );
      frames.push({
        status: "extracted",
        ...identity,
        title: String(extracted.title || ""),
        text: String(extracted.text || ""),
      });
    } catch {
      frames.push({
        status: "failed",
        reason: "extraction-failed",
        ...identity,
      });
    }
  }
  return frames;
}

type CaptureManifest = {
  schema: "agency/web-capture-manifest/1";
  id: string;
  captured_at: string;
  requested_url: string;
  final_url: string;
  firefox_version: string;
  extraction_options: PageCaptureInput["options"];
  object_sha256: string;
  evidence_sources: string[];
  truncation: Page["truncated"];
};

function captureDirectories() {
  const root = join(dataRoot, "captures");
  const objects = join(root, "objects");
  const manifests = join(root, "manifests");
  mkdirSync(objects, { recursive: true, mode: 0o700 });
  mkdirSync(manifests, { recursive: true, mode: 0o700 });
  return { root, objects, manifests };
}

function captureInputForStorage(input: PageCaptureInput): PageCaptureInput {
  const sanitizeHtml = (value: string) =>
    value.replace(/https?:\/\/[^\s"'<>]+/gi, (url) => redactedOutputUrl(url));
  return {
    ...input,
    requested_url: redactedOutputUrl(input.requested_url),
    captures: input.captures.map((capture) => ({
      title: terminalText(capture.title),
      url: redactedOutputUrl(capture.url),
      canonicalUrl: redactedOutputUrl(capture.canonicalUrl),
      published: terminalText(capture.published),
      byline: terminalText(capture.byline),
      text: terminalText(capture.text),
      markdown: cleanExtractedMarkdown(capture.markdown),
      html: sanitizeHtml(capture.html),
      links: capture.links.map(redactedOutputUrl).filter(Boolean),
      ...(capture.structured
        ? {
            structured: sanitizedNetworkJson(
              capture.structured,
            ) as StructuredEvidence,
          }
        : {}),
      ...(capture.sources ? { sources: capture.sources } : {}),
      ...(capture.truncated ? { truncated: capture.truncated } : {}),
    })),
    network: input.network.map((item) => ({
      url: redactedOutputUrl(item.url),
      status: item.status,
      mimeType: terminalText(item.mimeType),
      body: sanitizedNetworkJson(item.body),
    })),
    frames: input.frames.map((frame) => ({
      status: terminalText(frame.status),
      ...(frame.reason ? { reason: terminalText(frame.reason) } : {}),
      origin: terminalText(frame.origin),
      path: terminalText(frame.path),
      ...(frame.title ? { title: terminalText(frame.title) } : {}),
      ...(frame.text ? { text: terminalText(frame.text) } : {}),
    })),
  };
}

function storedCapture(
  page: Page,
  browser: Awaited<ReturnType<typeof startBrowser>>,
  frames: JsonObject[] = [],
) {
  const input = pageCaptures.get(page);
  if (!input) throw new Error("page capture state is unavailable");
  input.frames = frames;
  const storedInput = captureInputForStorage(input);
  const serialized = `${JSON.stringify(storedInput)}\n`;
  const objectSha256 = createHash("sha256").update(serialized).digest("hex");
  const directories = captureDirectories();
  const objectPath = join(directories.objects, `${objectSha256}.json`);
  if (existsSync(objectPath)) {
    const existing = readFileSync(objectPath);
    if (createHash("sha256").update(existing).digest("hex") !== objectSha256) {
      throw new Error(`capture object hash mismatch: ${objectSha256}`);
    }
  } else {
    writeFileSync(objectPath, serialized, { flag: "wx", mode: 0o600 });
  }
  const capturedAt = new Date().toISOString();
  const finalPage = storedInput.captures[storedInput.captures.length - 1];
  const core = {
    schema: "agency/web-capture-manifest/1" as const,
    captured_at: capturedAt,
    requested_url: storedInput.requested_url,
    final_url: redactedOutputUrl(finalPage.url),
    firefox_version: String(browser.bidi.capabilities.browserVersion || "unknown"),
    extraction_options: storedInput.options,
    object_sha256: objectSha256,
    evidence_sources: [...new Set(page.sources || [])],
    truncation: page.truncated,
  };
  let suffix = 0;
  let id = "";
  let manifestPath = "";
  do {
    id = createHash("sha256")
      .update(`${JSON.stringify(core)}\n${suffix}`)
      .digest("hex");
    manifestPath = join(directories.manifests, `${id}.json`);
    suffix += 1;
  } while (existsSync(manifestPath));
  const manifest: CaptureManifest = { ...core, id };
  writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`, {
    flag: "wx",
    mode: 0o600,
  });
  const fused = fusePageCapture(storedInput, objectSha256);
  fused.capture_id = id;
  pageCaptures.set(fused, storedInput);
  return fused;
}

function checkedCaptureId(value: string) {
  if (!/^[a-f0-9]{64}$/.test(value)) {
    fail("capture ID must be a 64-character lowercase SHA-256 digest");
  }
  return value;
}

function loadedCapture(idValue: string) {
  const id = checkedCaptureId(idValue);
  const directories = captureDirectories();
  const manifestPath = join(directories.manifests, `${id}.json`);
  if (!existsSync(manifestPath)) fail(`capture manifest not found: ${id}`);
  let manifest: any;
  try {
    manifest = JSON.parse(readFileSync(manifestPath, "utf8"));
  } catch {
    fail(`capture manifest is invalid JSON: ${id}`);
  }
  if (manifest.schema !== "agency/web-capture-manifest/1") {
    fail(`unsupported capture manifest schema: ${String(manifest.schema || "missing")}`);
  }
  if (
    manifest.id !== id ||
    typeof manifest.object_sha256 !== "string" ||
    !/^[a-f0-9]{64}$/.test(manifest.object_sha256)
  ) {
    fail(`capture manifest is invalid: ${id}`);
  }
  const objectPath = join(
    directories.objects,
    `${manifest.object_sha256}.json`,
  );
  if (!existsSync(objectPath)) {
    fail(`capture object is missing: ${manifest.object_sha256}`);
  }
  const serialized = readFileSync(objectPath);
  const actualSha256 = createHash("sha256").update(serialized).digest("hex");
  if (actualSha256 !== manifest.object_sha256) {
    fail(`capture object hash mismatch: ${manifest.object_sha256}`);
  }
  let input: any;
  try {
    input = JSON.parse(serialized.toString("utf8"));
  } catch {
    fail(`capture object is invalid JSON: ${manifest.object_sha256}`);
  }
  if (input.schema !== "agency/web-capture-input/1") {
    fail(`unsupported capture object schema: ${String(input.schema || "missing")}`);
  }
  if (
    typeof input.requested_url !== "string" ||
    !Array.isArray(input.captures) ||
    !input.captures.length ||
    !Array.isArray(input.access_states) ||
    !Array.isArray(input.actions) ||
    !Array.isArray(input.scroll_targets) ||
    !Array.isArray(input.network) ||
    !Array.isArray(input.frames) ||
    !Number.isInteger(input.options?.max_content_chars) ||
    !Number.isInteger(input.options?.max_links)
  ) {
    fail(`capture object is invalid: ${manifest.object_sha256}`);
  }
  const page = fusePageCapture(
    input as PageCaptureInput,
    manifest.object_sha256,
  );
  page.capture_id = id;
  return { manifest: manifest as CaptureManifest, page };
}

function browserOptions(args: string[]): BrowserOptions {
  const visible = takeFlag(args, "--visible");
  const legacyHeadless = takeFlag(args, "--headless");
  const ephemeral = takeFlag(args, "--ephemeral-profile");
  const template = takeOption(args, "--profile-template");
  if (visible && legacyHeadless) fail("use either --visible or --headless");
  return {
    profile: checkedProfile(takeOption(args, "--profile", "default")),
    ephemeral,
    templatePreferences: template ? templatePreferences(template) : [],
    headless: !visible,
    humanTimeout: takeNumber(args, "--human-timeout", 180, 0, 1800),
    waitMs: takeNumber(args, "--wait-ms", 350, 0, 30_000),
    settleMs: takeNumber(args, "--settle-ms", 1_200, 0, 30_000),
    navigationTimeoutMs: takeNumber(
      args,
      "--navigation-timeout-ms",
      45_000,
      1_000,
      180_000,
    ),
    navigationRetries: takeNumber(args, "--navigation-retries", 0, 0, 2),
    maxContentChars: takeNumber(
      args,
      "--max-content-chars",
      2_000_000,
      1,
      20_000_000,
    ),
    maxLinks: takeNumber(args, "--max-links", 2_000, 1, 20_000),
    scrollSteps: takeNumber(args, "--scroll-steps", 0, 0, 20),
    interactionSteps: takeNumber(args, "--interaction-steps", 0, 0, 10),
    captureNetworkJson: takeFlag(args, "--capture-network-json"),
    capture: takeFlag(args, "--capture"),
    allowPrivate: takeFlag(args, "--allow-private"),
  };
}

function checkedDomain(value: string) {
  const candidate = value.trim().toLowerCase().replace(/\.$/, "");
  if (
    !candidate ||
    candidate.includes("://") ||
    /[/?#@:*]/.test(candidate)
  ) {
    fail(`--domain requires a hostname without a scheme, port, path, or wildcard: ${value}`);
  }
  let hostname = "";
  try {
    hostname = new URL(`https://${candidate}`).hostname.toLowerCase();
  } catch {
    fail(`invalid --domain hostname: ${value}`);
  }
  if (hostname !== candidate) fail(`invalid --domain hostname: ${value}`);
  return hostname;
}

function resultMatchesDomains(
  result: SearchResult,
  domains: string[],
  excludedDomains: string[],
) {
  try {
    const hostname = new URL(result.url).hostname.toLowerCase().replace(/\.$/, "");
    const allowed = !domains.length || domains.some(
      (domain) => hostname === domain || hostname.endsWith(`.${domain}`),
    );
    const excluded = excludedDomains.some(
      (domain) => hostname === domain || hostname.endsWith(`.${domain}`),
    );
    return allowed && !excluded;
  } catch {
    return false;
  }
}

function searchScope(
  query: string,
  domains: string[],
  excludedDomains: string[],
) {
  return {
    domains,
    excluded_domains: excludedDomains,
    site_qualifier: /(?:^|\s)site:\S+/i.test(query)
      ? "best-effort"
      : "not-present",
  };
}

function searchUrl(engine: string, query: string) {
  if (engine === "duckduckgo") {
    return `https://html.duckduckgo.com/html/?q=${encodeURIComponent(query)}`;
  }
  if (engine === "brave") {
    return `https://search.brave.com/search?q=${encodeURIComponent(query)}&source=web`;
  }
  if (engine === "bing") {
    return `https://www.bing.com/search?q=${encodeURIComponent(query)}`;
  }
  throw new Error(`unsupported engine: ${engine}`);
}

function searchExpression(engine: string, limit: number) {
  return String.raw`(() => {
    const limit = ${limit}
    const engine = ${JSON.stringify(engine)}
    const absolute = value => { try { return new URL(value, location.href) } catch { return null } }
    const sensitive = name => /(^|[_-])(?:access|auth|id|refresh)?[_-]?token($|[_-])/.test(name) || /(^|[_-])(?:api[_-]?key|captcha|challenge|credential|secret|signature|solution)(?:$|[_-])/.test(name) || /^(?:authorization|bearer|cf_chl_|jsc_|session|trkinfo)/.test(name)
    const sanitized = url => {
      url.username = ""
      url.password = ""
      url.hash = ""
      for (const name of [...url.searchParams.keys()]) if (sensitive(name.toLowerCase())) url.searchParams.delete(name)
      return url.href
    }
    const cleanUrl = value => {
      const url = absolute(value)
      if (!url) return ""
      if (url.hostname === "duckduckgo.com" || url.hostname.endsWith(".duckduckgo.com")) {
        const redirect = url.searchParams.get("uddg")
        const target = redirect ? absolute(decodeURIComponent(redirect)) : null
        if (!target || !["http:", "https:"].includes(target.protocol)) return ""
        return sanitized(target)
      }
      if (!["http:", "https:"].includes(url.protocol)) return ""
      if (url.hostname === "search.brave.com") return ""
      if (engine === "bing" && (url.hostname === "bing.com" || url.hostname.endsWith(".bing.com"))) return ""
      return sanitized(url)
    }
    const results = []
    if (engine === "duckduckgo") {
      for (const item of document.querySelectorAll(".result")) {
        if (item.matches(".result--ad") || item.querySelector(".result__badge")) continue
        const link = item.querySelector("a.result__a")
        const url = cleanUrl(link?.getAttribute("href") || "")
        if (url) results.push({ title: (link?.textContent || "").trim(), url, snippet: (item.querySelector(".result__snippet")?.textContent || "").trim() })
      }
    } else if (engine === "brave") {
      for (const item of document.querySelectorAll("main article, main .snippet, #results article")) {
        const link = item.querySelector("a[href]")
        const url = cleanUrl(link?.getAttribute("href") || "")
        if (url) results.push({ title: (item.querySelector(".search-snippet-title, h2, h3")?.textContent || link?.textContent || "").trim(), url, snippet: (item.querySelector(".generic-snippet .content, .snippet-description, .description, p")?.textContent || "").trim() })
      }
    } else {
      for (const item of document.querySelectorAll("#b_results > li.b_algo, main li.b_algo")) {
        const link = item.querySelector("h2 a[href]")
        const url = cleanUrl(link?.getAttribute("href") || "")
        if (url) results.push({ title: (link?.textContent || "").trim(), url, snippet: (item.querySelector(".b_caption p, .b_snippet, p")?.textContent || "").trim() })
      }
    }
    if (!results.length) {
      for (const link of document.querySelectorAll("main a[href], #links a[href], #b_results a[href]")) {
        const url = cleanUrl(link.getAttribute("href") || "")
        const title = (link.textContent || "").trim()
        if (url && title.length > 3) results.push({ title, url, snippet: "" })
      }
    }
    return JSON.stringify([...new Map(results.map(result => [result.url, result])).values()].slice(0, limit))
  })()`;
}

type SearchAttempt = {
  engine: string;
  outcome: "challenged" | "empty" | "failed" | "rate-limited" | "searched";
  message?: string;
  duration_ms: number;
  retry_after_seconds?: number;
};

type SearchProviderHealth = {
  failures: number;
  cooldownUntil: number;
};

type SearchRunState = {
  health: Map<string, SearchProviderHealth>;
  preferred: string;
};

function newSearchRunState(checkpoint?: HealthCheckpoint): SearchRunState {
  const health = new Map<string, SearchProviderHealth>();
  if (checkpoint) {
    for (const engine of ["duckduckgo", "brave", "bing"]) {
      const event = checkpoint.latest("provider", engine);
      if (!event) continue;
      health.set(engine, {
        failures: event.consecutive_failures,
        cooldownUntil: event.cooldown_until
          ? Date.parse(event.cooldown_until)
          : 0,
      });
    }
  }
  return { health, preferred: "" };
}

function searchEngines(requested: string) {
  return requested === "auto"
    ? ["duckduckgo", "brave", "bing"]
    : [requested];
}

function orderedSearchEngines(
  requested: string,
  state: SearchRunState,
  now = Date.now(),
) {
  const engines = searchEngines(requested);
  if (state.preferred && engines.includes(state.preferred)) {
    engines.splice(engines.indexOf(state.preferred), 1);
    engines.unshift(state.preferred);
  }
  return engines.filter((engine) => {
    const health = state.health.get(engine);
    return !health || health.cooldownUntil <= now;
  });
}

function updateSearchHealth(
  state: SearchRunState,
  engine: string,
  message: string,
) {
  const previous = state.health.get(engine) || {
    failures: 0,
    cooldownUntil: 0,
  };
  const failures = previous.failures + 1;
  const challenged = message.includes("interactive challenge required");
  const rateLimited = message.includes("origin rate limited");
  state.health.set(engine, {
    failures,
    cooldownUntil: challenged
      ? Date.now() + 24 * 60 * 60 * 1000
      : rateLimited
        ? Date.now() + 15 * 60 * 1000
        : Date.now() + Math.min(60 * 60 * 1000, 60_000 * 2 ** Math.min(failures - 1, 6)),
  });
  return challenged ? "challenged" : rateLimited ? "rate-limited" : "failed";
}

async function searchOne(
  browser: Awaited<ReturnType<typeof startBrowser>>,
  options: BrowserOptions,
  query: string,
  requestedEngine: string,
  limit: number,
  domains: string[],
  excludedDomains: string[],
  state: SearchRunState,
  recordAttempt?: (attempt: SearchAttempt) => void,
) {
  const engines = orderedSearchEngines(requestedEngine, state);
  if (!engines.length) throw new Error("no healthy search provider remains");
  const attempts: SearchAttempt[] = [];
  let firstError = "";
  for (const [position, candidate] of engines.entries()) {
    const attemptStarted = performance.now();
    const navigationHealth = await startNavigationHealth(
      browser,
      searchUrl(candidate, query),
    );
    try {
      await browser.bidi.navigate(
        browser.context,
        searchUrl(candidate, query),
        options.navigationTimeoutMs,
      );
      const finalCandidate = position === engines.length - 1;
      await preparePage(
        browser,
        finalCandidate ? options : { ...options, headless: true },
      );
      const discoveredResults = JSON.parse(
        String(
          await browser.bidi.evaluate(
            browser.context,
            searchExpression(
              candidate,
              domains.length || excludedDomains.length ? 50 : limit,
            ),
          ),
        ),
      ) as SearchResult[];
      const results = discoveredResults
        .filter((result) =>
          resultMatchesDomains(result, domains, excludedDomains),
        )
        .slice(0, limit);
      if (!results.length) {
        const attempt = {
          engine: candidate,
          outcome: "empty",
          duration_ms: Math.round((performance.now() - attemptStarted) * 1000) / 1000,
        } satisfies SearchAttempt;
        attempts.push(attempt);
        recordAttempt?.(attempt);
        if (!finalCandidate) {
          navigationHealth.close();
          info(
            `${candidate} returned no results; trying ${engines[position + 1]}`,
          );
          continue;
        }
      } else {
        const attempt = {
          engine: candidate,
          outcome: "searched",
          duration_ms: Math.round((performance.now() - attemptStarted) * 1000) / 1000,
        } satisfies SearchAttempt;
        attempts.push(attempt);
        recordAttempt?.(attempt);
      }
      state.preferred = candidate;
      state.health.set(candidate, {
        failures: 0,
        cooldownUntil: 0,
      });
      navigationHealth.close();
      return { engine: candidate, results, attempts };
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      const healthOutcome = updateSearchHealth(
        state,
        candidate,
        message,
      );
      const { retryAfterSeconds } = navigationHealth.snapshot();
      navigationHealth.close();
      if (retryAfterSeconds !== null) {
        const current = state.health.get(candidate);
        state.health.set(candidate, {
          failures: current?.failures || 1,
          cooldownUntil: Date.now() + retryAfterSeconds * 1000,
        });
      }
      const attempt = {
        engine: candidate,
        outcome: healthOutcome,
        message,
        duration_ms: Math.round((performance.now() - attemptStarted) * 1000) / 1000,
        ...(retryAfterSeconds === null
          ? {}
          : { retry_after_seconds: retryAfterSeconds }),
      } satisfies SearchAttempt;
      attempts.push(attempt);
      recordAttempt?.(attempt);
      if (position === engines.length - 1) {
        const details = firstError
          ? `${firstError}; ${candidate}: ${message}`
          : `${candidate}: ${message}`;
        if (
          !orderedSearchEngines(requestedEngine, state).length
        ) {
          throw new Error(`no healthy search provider remains (${details})`);
        }
        throw new Error(`all search engines failed (${details})`);
      }
      firstError = firstError
        ? `${firstError}; ${candidate}: ${message}`
        : `${candidate}: ${message}`;
      info(`${candidate} unavailable; trying ${engines[position + 1]}`);
    }
  }
  throw new Error("no healthy search provider returned a result");
}

async function searchFederated(
  browser: Awaited<ReturnType<typeof startBrowser>>,
  options: BrowserOptions,
  query: string,
  limit: number,
  domains: string[],
  excludedDomains: string[],
  state: SearchRunState,
  recordAttempt?: (attempt: SearchAttempt) => void,
) {
  const attempts: SearchAttempt[] = [];
  const ranked = new Map<string, SearchResult>();
  const errors: string[] = [];
  for (const engine of ["duckduckgo", "brave", "bing"]) {
    try {
      const outcome = await searchOne(
        browser,
        options,
        query,
        engine,
        limit,
        domains,
        excludedDomains,
        state,
        (attempt) => {
          attempts.push(attempt);
          recordAttempt?.(attempt);
        },
      );
      for (const [index, result] of outcome.results.entries()) {
        const rank = index + 1;
        const source = {
          engine,
          rank,
          title: result.title,
          snippet: result.snippet,
        };
        const existing = ranked.get(result.url);
        if (existing) {
          existing.score = (existing.score || 0) + 1 / (60 + rank);
          existing.sources?.push(source);
        } else {
          ranked.set(result.url, {
            ...result,
            score: 1 / (60 + rank),
            sources: [source],
          });
        }
      }
    } catch (error) {
      errors.push(
        `${engine}: ${error instanceof Error ? error.message : String(error)}`,
      );
    }
  }
  const results = [...ranked.values()]
    .sort(
      (left, right) =>
        (right.score || 0) - (left.score || 0) ||
        left.url.localeCompare(right.url),
    )
    .slice(0, limit)
    .map((result) => ({
      ...result,
      score: Math.round((result.score || 0) * 1_000_000) / 1_000_000,
    }));
  if (!results.length) {
    throw new Error(
      errors.length
        ? `all search engines failed (${errors.join("; ")})`
        : "no search provider returned a result",
    );
  }
  return { engine: "federated", results, attempts };
}

function database() {
  mkdirSync(dataRoot, { recursive: true });
  const db = new Database(join(dataRoot, "index.sqlite"), { create: true });
  db.run("PRAGMA journal_mode = WAL");
  db.run("PRAGMA synchronous = NORMAL");
  db.run(
    "CREATE TABLE IF NOT EXISTS pages (url TEXT PRIMARY KEY, title TEXT NOT NULL, text TEXT NOT NULL, markdown TEXT NOT NULL, fetched_at TEXT NOT NULL)",
  );
  const columns = new Set(
    (db.query("PRAGMA table_info(pages)").all() as any[]).map(
      (column) => String(column.name),
    ),
  );
  const migrations = [
    ["published", "TEXT NOT NULL DEFAULT ''"],
    ["byline", "TEXT NOT NULL DEFAULT ''"],
    ["links_json", "TEXT NOT NULL DEFAULT '[]'"],
    ["jobs_json", "TEXT NOT NULL DEFAULT '[]'"],
    ["sources_json", "TEXT NOT NULL DEFAULT '[]'"],
    ["change_likelihood", "TEXT NOT NULL DEFAULT 'medium'"],
    ["freshness_basis", "TEXT NOT NULL DEFAULT '[\"legacy-index-entry\"]'"],
    ["refresh_after", "TEXT"],
    ["content_sha256", "TEXT NOT NULL DEFAULT ''"],
  ];
  for (const [name, definition] of migrations) {
    if (!columns.has(name)) {
      db.run(`ALTER TABLE pages ADD COLUMN ${name} ${definition}`);
    }
  }
  db.run(
    "CREATE TABLE IF NOT EXISTS page_aliases (request_url TEXT PRIMARY KEY, page_url TEXT NOT NULL)",
  );
  db.run(
    "CREATE VIRTUAL TABLE IF NOT EXISTS pages_fts USING fts5(url UNINDEXED, title, text, tokenize='unicode61')",
  );
  return db;
}

function normalizedPageUrl(value: string) {
  try {
    const url = new URL(redactedOutputUrl(value) || value);
    url.hash = "";
    return url.href;
  } catch {
    return value;
  }
}

function pageIndexUrl(page: Page) {
  return normalizedPageUrl(
    /^https?:\/\//.test(page.canonicalUrl) ? page.canonicalUrl : page.url,
  );
}

function structuredSignals(page: Page) {
  const types = new Set<string>();
  const modified: number[] = [];
  const jobs: JobCard[] = [];
  let visited = 0;
  const text = (value: unknown) =>
    typeof value === "string"
      ? terminalText(value).replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim()
      : "";
  const named = (value: unknown) => {
    if (typeof value === "string") return text(value);
    if (!value || typeof value !== "object") return "";
    return text((value as JsonObject).name);
  };
  const jobLocation = (value: unknown): string => {
    if (Array.isArray(value)) {
      return value.map(jobLocation).filter(Boolean).join("; ");
    }
    if (!value || typeof value !== "object") return text(value);
    const record = value as JsonObject;
    const address = record.address;
    if (typeof address === "string") return text(address);
    if (!address || typeof address !== "object") return named(record);
    const fields = ["addressLocality", "addressRegion", "addressCountry"]
      .map((key) => text((address as JsonObject)[key]))
      .filter(Boolean);
    return [...new Set(fields)].join(", ");
  };
  const walk = (value: unknown, depth = 0) => {
    if (visited >= 2_000 || depth > 8 || value === null) return;
    visited += 1;
    if (Array.isArray(value)) {
      for (const item of value) walk(item, depth + 1);
      return;
    }
    if (typeof value !== "object") return;
    const record = value as JsonObject;
    const recordTypes = (Array.isArray(record["@type"])
      ? record["@type"]
      : [record["@type"]]
    ).map((item) => String(item || "").toLocaleLowerCase());
    if (recordTypes.includes("jobposting")) {
      jobs.push({
        title: text(record.title || record.name).slice(0, 500),
        url: redactedOutputUrl(text(record.url || record["@id"])),
        company: named(record.hiringOrganization).slice(0, 500),
        location: jobLocation(record.jobLocation).slice(0, 500),
        posting_age: "",
        published: text(record.datePosted).slice(0, 100),
        summary: text(record.description).slice(0, 1_200),
      });
    }
    for (const [key, item] of Object.entries(record)) {
      if (key === "@type") {
        const values = Array.isArray(item) ? item : [item];
        for (const type of values) types.add(String(type).toLocaleLowerCase());
      } else if (key.toLocaleLowerCase() === "datemodified") {
        const timestamp = Date.parse(String(item));
        if (Number.isFinite(timestamp)) modified.push(timestamp);
      }
      walk(item, depth + 1);
    }
  };
  walk(page.structured?.jsonLd || []);
  const metadata = page.structured?.metadata || {};
  for (const key of ["article:modified_time", "last-modified"]) {
    const timestamp = Date.parse(metadata[key] || "");
    if (Number.isFinite(timestamp)) modified.push(timestamp);
  }
  return { types, modified, jobs };
}

function relativePublicationDate(value: string, retrievedAt: string) {
  const match = value.match(
    /\b(today|yesterday|\d+\s*(?:minutes?|mins?|m|hours?|hrs?|h|days?|d|weeks?|w|months?|mos?)\s+ago)\b/i,
  );
  if (!match) return "";
  const retrieved = Date.parse(retrievedAt);
  if (!Number.isFinite(retrieved)) return "";
  const normalized = match[1].toLocaleLowerCase();
  let elapsed = 0;
  if (normalized === "yesterday") elapsed = 24 * 60 * 60 * 1_000;
  else if (normalized !== "today") {
    const parts = normalized.match(
      /^(\d+)\s*(minutes?|mins?|hours?|hrs?|days?|weeks?|months?|mos?|[mhdw])\s+ago$/,
    );
    if (!parts) return "";
    const quantity = Number(parts[1]);
    const unit = parts[2];
    const unitMilliseconds = /^(?:minutes?|mins?|m)$/.test(unit)
      ? 60 * 1_000
      : /^(?:hours?|hrs?|h)$/.test(unit)
        ? 60 * 60 * 1_000
        : /^(?:days?|d)$/.test(unit)
          ? 24 * 60 * 60 * 1_000
          : /^(?:weeks?|w)$/.test(unit)
            ? 7 * 24 * 60 * 60 * 1_000
            : 30 * 24 * 60 * 60 * 1_000;
    elapsed = quantity * unitMilliseconds;
  }
  return new Date(retrieved - elapsed).toISOString().slice(0, 10);
}

function enrichJobEvidence(
  page: Page,
  retrievedAt: string,
  signals: ReturnType<typeof structuredSignals>,
) {
  const candidates = [...(page.jobs || []), ...signals.jobs];
  const jobs: JobCard[] = [];
  const seen = new Set<string>();
  for (const candidate of candidates) {
    const title = terminalText(String(candidate.title || "")).trim().slice(0, 500);
    const url = redactedOutputUrl(String(candidate.url || ""));
    if (!title || !url) continue;
    const key = `${url}\n${title.toLocaleLowerCase()}`;
    if (seen.has(key)) continue;
    seen.add(key);
    const explicit = Date.parse(candidate.published);
    const published = Number.isFinite(explicit)
      ? new Date(explicit).toISOString().slice(0, 10)
      : relativePublicationDate(candidate.posting_age, retrievedAt);
    jobs.push({
      title,
      url,
      company: terminalText(String(candidate.company || "")).trim().slice(0, 500),
      location: terminalText(String(candidate.location || "")).trim().slice(0, 500),
      posting_age: terminalText(String(candidate.posting_age || "")).trim().slice(0, 100),
      published,
      summary: terminalText(String(candidate.summary || "")).trim().slice(0, 1_200),
    });
    if (jobs.length >= 100) break;
  }
  if (jobs.length) page.jobs = jobs;
  const identity = `${page.title} ${page.canonicalUrl} ${page.url}`.toLocaleLowerCase();
  const jobPage =
    jobs.length > 0 ||
    signals.types.has("jobposting") ||
    /(?:^|[\s/_-])(jobs?|careers?|vacanc(?:y|ies)|open[\s_-]?roles?|positions?)(?:$|[\s/?#_-])/.test(
      identity,
    );
  if (!page.published && jobs.length === 1 && jobs[0].published) {
    page.published = jobs[0].published;
  } else if (!page.published && jobPage && signals.types.has("jobposting")) {
    page.published = relativePublicationDate(page.text, retrievedAt);
  }
  return jobPage;
}

function freshnessPolicy(page: Page, retrievedAt: string) {
  const signals = structuredSignals(page);
  const jobPage = enrichJobEvidence(page, retrievedAt, signals);
  const published = Date.parse(page.published);
  const now = Date.parse(retrievedAt);
  const newestDocumentDate = Math.max(
    Number.isFinite(published) ? published : 0,
    ...signals.modified,
  );
  const identity =
    `${page.title} ${page.canonicalUrl} ${page.url}`.toLocaleLowerCase();
  const article =
    /\b(article|paper|post|news|story|research)\b/.test(identity) ||
    page.structured?.metadata?.["og:type"]?.toLocaleLowerCase() === "article" ||
    [...signals.types].some((type) => /article|posting|report/.test(type));
  const historical =
    article &&
    newestDocumentDate > 0 &&
    newestDocumentDate <= now - 10 * 365.2425 * 24 * 60 * 60 * 1_000;
  let changeLikelihood: ChangeLikelihood;
  let basis: string[];
  let ttl: number | null;
  if (jobPage) {
    changeLikelihood = "high";
    basis = ["job-listing-or-board"];
    ttl = 24 * 60 * 60 * 1_000;
  } else if (historical) {
    changeLikelihood = "immutable";
    basis = ["historical-published-article"];
    ttl = null;
  } else if (
    /\b(status|incident|availability|outage|pricing|prices|schedule|scores?|weather|markets?|stocks?|live|latest)\b/.test(
      identity,
    )
  ) {
    changeLikelihood = "high";
    basis = ["frequently-changing-subject"];
    ttl = 24 * 60 * 60 * 1_000;
  } else if (
    /\b(terms|conditions|privacy|policy|policies|legal|security|documentation|docs|reference|changelog|releases?)\b/.test(
      identity,
    )
  ) {
    changeLikelihood = "medium";
    basis = ["maintained-document"];
    ttl = 14 * 24 * 60 * 60 * 1_000;
  } else if (
    newestDocumentDate > 0 &&
    newestDocumentDate <= now - 2 * 365.2425 * 24 * 60 * 60 * 1_000
  ) {
    changeLikelihood = "low";
    basis = ["older-published-document"];
    ttl = 180 * 24 * 60 * 60 * 1_000;
  } else {
    changeLikelihood = "medium";
    basis = [
      Number.isFinite(published)
        ? "recent-published-document"
        : "undated-document",
    ];
    ttl = 14 * 24 * 60 * 60 * 1_000;
  }
  return {
    changeLikelihood,
    basis,
    refreshAfter: ttl === null ? null : new Date(now + ttl).toISOString(),
  };
}

function contentHash(page: Pick<Page, "markdown" | "text">) {
  return createHash("sha256")
    .update(page.markdown || page.text)
    .digest("hex");
}

function parsedArray(value: unknown) {
  try {
    const parsed = JSON.parse(String(value || "[]"));
    return Array.isArray(parsed) ? parsed.map(String) : [];
  } catch {
    return [];
  }
}

function parsedJobCards(value: unknown) {
  try {
    const parsed = JSON.parse(String(value || "[]"));
    return Array.isArray(parsed)
      ? parsed.filter((item) => item && typeof item === "object") as JobCard[]
      : [];
  } catch {
    return [];
  }
}

function cachedPage(url: string) {
  const db = database();
  try {
    const normalized = normalizedPageUrl(url);
    const row = db
      .query(
        "SELECT pages.* FROM pages WHERE pages.url = COALESCE((SELECT page_url FROM page_aliases WHERE request_url = ?), ?) LIMIT 1",
      )
      .get(normalized, normalized) as any;
    if (!row) return { cache: "miss" as const };
    const likelihood = new Set(["immutable", "low", "medium", "high"]).has(
      row.change_likelihood,
    )
      ? (row.change_likelihood as ChangeLikelihood)
      : "medium";
    const immutable = likelihood === "immutable";
    const fresh =
      immutable ||
      (typeof row.refresh_after === "string" &&
        Date.parse(row.refresh_after) > Date.now());
    if (!fresh) return { cache: "stale" as const };
    const page: Page = {
      title: String(row.title),
      url: String(row.url),
      canonicalUrl: String(row.url),
      published: String(row.published || ""),
      byline: String(row.byline || ""),
      text: String(row.text),
      markdown: String(row.markdown),
      html: "",
      links: parsedArray(row.links_json),
      jobs: parsedJobCards(row.jobs_json),
      sources: [...new Set([...parsedArray(row.sources_json), "local-index"])],
      freshness: {
        retrieval: "local-index",
        cache: immutable ? "immutable" : "fresh",
        change_likelihood: likelihood,
        basis: parsedArray(row.freshness_basis),
        retrieved_at: String(row.fetched_at),
        indexed_at: String(row.fetched_at),
        refresh_after:
          row.refresh_after === null ? null : String(row.refresh_after),
        content_sha256: String(row.content_sha256 || contentHash(row)),
      },
    };
    return { cache: page.freshness!.cache, page };
  } finally {
    db.close();
  }
}

function pageIndexer() {
  const db = database();
  const upsert = db.query(
    "INSERT INTO pages (url, title, text, markdown, fetched_at, published, byline, links_json, jobs_json, sources_json, change_likelihood, freshness_basis, refresh_after, content_sha256) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT(url) DO UPDATE SET title=excluded.title, text=excluded.text, markdown=excluded.markdown, fetched_at=excluded.fetched_at, published=excluded.published, byline=excluded.byline, links_json=excluded.links_json, jobs_json=excluded.jobs_json, sources_json=excluded.sources_json, change_likelihood=excluded.change_likelihood, freshness_basis=excluded.freshness_basis, refresh_after=excluded.refresh_after, content_sha256=excluded.content_sha256",
  );
  const prior = db.query("SELECT content_sha256 FROM pages WHERE url = ?");
  const addAlias = db.query(
    "INSERT INTO page_aliases (request_url, page_url) VALUES (?, ?) ON CONFLICT(request_url) DO UPDATE SET page_url=excluded.page_url",
  );
  const removeSearch = db.query("DELETE FROM pages_fts WHERE url = ?");
  const addSearch = db.query(
    "INSERT INTO pages_fts (url, title, text) VALUES (?, ?, ?)",
  );
  const write = db.transaction(
    (page: Page, requestedUrl = "", cache = "bypass") => {
      const url = pageIndexUrl(page);
      const indexedAt = new Date().toISOString();
      const policy = freshnessPolicy(page, indexedAt);
      const hash = contentHash(page);
      const previous = prior.get(url) as any;
      upsert.run(
        url,
        page.title,
        page.text,
        page.markdown,
        indexedAt,
        page.published,
        page.byline,
        JSON.stringify(page.links),
        JSON.stringify(page.jobs || []),
        JSON.stringify(page.sources || []),
        policy.changeLikelihood,
        JSON.stringify(policy.basis),
        policy.refreshAfter,
        hash,
      );
      for (const alias of new Set(
        [url, page.url, page.canonicalUrl, requestedUrl]
          .filter(Boolean)
          .map(normalizedPageUrl),
      )) addAlias.run(alias, url);
      removeSearch.run(url);
      addSearch.run(url, page.title, page.text);
      return {
        retrieval: "live",
        cache,
        change_likelihood: policy.changeLikelihood,
        basis: policy.basis,
        retrieved_at: indexedAt,
        indexed_at: indexedAt,
        refresh_after: policy.refreshAfter,
        content_sha256: hash,
        ...(previous?.content_sha256
          ? { changed: previous.content_sha256 !== hash }
          : {}),
      } as PageFreshness;
    },
  );
  return {
    write,
    close: () => db.close(),
  };
}

function indexPage(page: Page, requestedUrl = "", cache = "bypass") {
  const indexer = pageIndexer();
  try {
    return indexer.write(page, requestedUrl, cache);
  } finally {
    indexer.close();
  }
}

function safeLink(value: string, origin: string) {
  try {
    const redacted = redactedOutputUrl(value);
    if (!redacted) return "";
    const url = new URL(redacted);
    if (
      url.origin !== origin ||
      !new Set(["http:", "https:"]).has(url.protocol)
    ) {
      return "";
    }
    url.hash = "";
    const lower = `${url.pathname}${url.search}`.toLowerCase();
    if (
      /\.(?:7z|avi|bin|bz2|dmg|docx?|exe|gif|gz|iso|jpe?g|mkv|mov|mp3|mp4|msi|odt|png|pptx?|rar|tar|tgz|webm|webp|xlsx?|xz|zip)(?:$|[?#])/.test(
        lower,
      )
    ) {
      return "";
    }
    if (
      /\/(?:logout|log-out|signout|sign-out|delete|remove)(?:\/|$|\?)/.test(
        lower,
      )
    ) {
      return "";
    }
    if (/[?&](?:action|method)=(?:delete|remove|logout|signout)/.test(lower))
      return "";
    return url.href;
  } catch {
    return "";
  }
}

const trackingQueryParameters = new Set([
  "dclid",
  "fbclid",
  "gclid",
  "igshid",
  "mc_cid",
  "mc_eid",
  "msclkid",
]);

function crawlLink(value: string, origin: string, maxQueryParameters: number) {
  const safe = safeLink(value, origin);
  if (!safe) return "";
  const url = new URL(safe);
  for (const name of [...url.searchParams.keys()]) {
    const normalized = name.toLowerCase();
    if (
      normalized.startsWith("utm_") ||
      trackingQueryParameters.has(normalized)
    ) {
      url.searchParams.delete(name);
    }
  }
  if ([...url.searchParams.keys()].length > maxQueryParameters) return "";
  url.searchParams.sort();
  return url.href;
}

function robotsAllows(url: URL, rules: string[]) {
  const target = `${url.pathname}${url.search}`;
  let winner = "";
  let allowed = true;
  for (const rule of rules) {
    const [kind, ...rest] = rule.split(":");
    const path = rest.join(":").trim();
    if (!path || !target.startsWith(path) || path.length < winner.length)
      continue;
    winner = path;
    allowed = kind === "allow";
  }
  return allowed;
}

function parseRobots(text: string) {
  const rules: string[] = [];
  let applies = false;
  for (const raw of text.split("\n")) {
    const line = raw.split("#", 1)[0].trim();
    const separator = line.indexOf(":");
    if (separator < 0) continue;
    const key = line.slice(0, separator).trim().toLowerCase();
    const value = line.slice(separator + 1).trim();
    if (key === "user-agent") {
      applies = value === "*";
    } else if (applies && (key === "allow" || key === "disallow")) {
      rules.push(`${key}:${value}`);
    }
  }
  return rules;
}

async function commandSearch(args: string[]) {
  const literalQuery = takeLiteralArguments(args);
  const explicitProfile = args.includes("--profile") || args.includes("--ephemeral-profile");
  const options = browserOptions(args);
  const requestedEngine = takeOption(args, "--engine", "auto");
  const strategy = takeOption(args, "--strategy", "first");
  const limit = takeNumber(args, "--limit", 10, 1, 50);
  const json = takeFlag(args, "--json");
  const domains = takeOptions(args, "--domain").map(checkedDomain);
  const excludedDomains = takeOptions(args, "--exclude-domain").map(
    checkedDomain,
  );
  rejectUnknownOptions(args, "search");
  const query = [...args, ...literalQuery].join(" ").trim();
  if (!query) fail("search requires a query");
  if (query.length > 1000) fail("search query must be at most 1000 characters");
  if (!new Set(["auto", "duckduckgo", "brave", "bing"]).has(requestedEngine)) {
    fail("--engine must be auto, duckduckgo, brave, or bing");
  }
  if (!new Set(["first", "federated"]).has(strategy)) {
    fail("--strategy must be first or federated");
  }
  if (strategy === "federated" && requestedEngine !== "auto") {
    fail("--strategy federated cannot be combined with an explicit --engine");
  }
  if (!explicitProfile) {
    options.profile = "search";
    options.ephemeral = true;
  }
  const outcome = await withBrowser(options, async (browser) => {
    const state = newSearchRunState();
    return strategy === "federated"
      ? searchFederated(
          browser,
          options,
          query,
          limit,
          domains,
          excludedDomains,
          state,
        )
      : searchOne(
          browser,
          options,
          query,
          requestedEngine,
          limit,
          domains,
          excludedDomains,
          state,
        );
  });
  const { engine, results, attempts } = outcome;
  const scope = searchScope(query, domains, excludedDomains);
  if (json) {
    console.log(
      JSON.stringify(
        { query, engine, strategy, scope, results, attempts },
        null,
        2,
      ),
    );
    return;
  }
  if (scope.site_qualifier === "best-effort" && !domains.length) {
    info("site: query text is provider best-effort; use --domain HOSTNAME for strict filtering");
  }
  console.log(`${purple}◇ ${query}${reset}`);
  for (const [position, result] of results.entries()) {
    console.log(
      `${pink}${position + 1}. ${terminalText(result.title)}${reset}\n   ${terminalText(result.url)}`,
    );
    if (result.snippet) console.log(`   ${terminalText(result.snippet)}`);
  }
}

async function commandSearchMany(args: string[]) {
  const explicitProfile = args.includes("--profile") || args.includes("--ephemeral-profile");
  const options = browserOptions(args);
  rejectUnknownOptions(args, "search-many");
  if (args.length) fail("search-many accepts its request on stdin");
  if (!explicitProfile) {
    options.profile = "search";
    options.ephemeral = true;
  }
  let payload: any;
  try {
    payload = JSON.parse(await Bun.stdin.text());
  } catch {
    fail("search-many requires a JSON request on stdin");
  }
  if (!Array.isArray(payload.searches) || !payload.searches.length || payload.searches.length > 4) {
    fail("search-many searches must contain 1–4 requests");
  }
  const searches = payload.searches.map((item: any) => {
    if (!item || typeof item.query !== "string" || !item.query.trim() || item.query.length > 1000) {
      fail("search-many query must be non-empty text of at most 1000 characters");
    }
    const strategy = item.strategy === undefined ? "federated" : String(item.strategy);
    if (!new Set(["first", "federated"]).has(strategy)) {
      fail("search-many strategy must be first or federated");
    }
    const domains = Array.isArray(item.domains) ? item.domains.map(checkedDomain) : [];
    const excluded = Array.isArray(item.excluded) ? item.excluded.map(checkedDomain) : [];
    const limit = Number(item.limit);
    if (!Number.isInteger(limit) || limit < 1 || limit > 50) {
      fail("search-many limit must be an integer from 1 to 50");
    }
    return { query: item.query.trim(), strategy, domains, excluded, limit };
  });
  const results = await withBrowser(options, async (browser) => {
    const state = newSearchRunState();
    const outcomes = [];
    for (const item of searches) {
      const outcome = item.strategy === "federated"
        ? await searchFederated(
            browser,
            options,
            item.query,
            item.limit,
            item.domains,
            item.excluded,
            state,
          )
        : await searchOne(
            browser,
            options,
            item.query,
            "auto",
            item.limit,
            item.domains,
            item.excluded,
            state,
          );
      outcomes.push({
        query: item.query,
        strategy: item.strategy,
        scope: searchScope(item.query, item.domains, item.excluded),
        ...outcome,
      });
    }
    return outcomes;
  });
  console.log(JSON.stringify({ results }));
}

function checkedBatchOutput(value: string, resume: boolean, command: string) {
  const output = resolve(value);
  const parent = dirname(output);
  if (!existsSync(parent) || !statSync(parent).isDirectory()) {
    fail(`${command} output parent must be an existing directory`);
  }
  if (existsSync(output)) {
    const status = lstatSync(output);
    if (!status.isFile() || status.isSymbolicLink()) {
      fail(`${command} output must be a regular non-symlink file`);
    }
    if (!resume) fail(`${command} output exists; use --resume`);
  } else {
    writeFileSync(output, "", { flag: "wx", mode: 0o600 });
  }
  return output;
}

type HealthScope = "provider" | "origin";
type HealthOutcome =
  | "success"
  | "empty"
  | "partial"
  | "failed"
  | "challenged"
  | "login-required"
  | "rate-limited";
type HealthEvent = {
  schema: "agency/web-health-event/1";
  scope: HealthScope;
  key: string;
  outcome: HealthOutcome;
  last_attempt_at: string;
  consecutive_failures: number;
  observed_latency_ms: number;
  cooldown_until: string | null;
  retry_after_seconds: number | null;
  failed_stage?: "navigation";
};

class HealthCheckpoint {
  path: string;
  events = new Map<string, HealthEvent>();

  constructor(path: string) {
    this.path = path;
  }

  eventKey(scope: HealthScope, key: string) {
    return `${scope}\n${key}`;
  }

  latest(scope: HealthScope, key: string) {
    return this.events.get(this.eventKey(scope, key));
  }

  cooling(scope: HealthScope, key: string, now = Date.now()) {
    const deadline = this.latest(scope, key)?.cooldown_until;
    return Boolean(deadline && Date.parse(deadline) > now);
  }

  record(
    scope: HealthScope,
    key: string,
    outcome: HealthOutcome,
    observedLatencyMs: number,
    retryAfterSeconds: number | null = null,
    failedStage?: "navigation",
  ) {
    const previous = this.latest(scope, key);
    const successful = outcome === "success" || outcome === "empty";
    const consecutiveFailures = successful
      ? 0
      : (previous?.consecutive_failures || 0) + 1;
    const boundedRetryAfter =
      retryAfterSeconds === null
        ? null
        : Math.max(1, Math.min(24 * 60 * 60, Math.round(retryAfterSeconds)));
    let cooldownMs = 0;
    if (outcome === "rate-limited") {
      cooldownMs = (boundedRetryAfter || 15 * 60) * 1000;
    } else if (outcome === "challenged" || outcome === "login-required") {
      cooldownMs = 24 * 60 * 60 * 1000;
    } else if (!successful) {
      cooldownMs = Math.min(
        60 * 60 * 1000,
        60_000 * 2 ** Math.min(consecutiveFailures - 1, 6),
      );
    }
    const attemptedAt = new Date();
    const event: HealthEvent = {
      schema: "agency/web-health-event/1",
      scope,
      key,
      outcome,
      last_attempt_at: attemptedAt.toISOString(),
      consecutive_failures: consecutiveFailures,
      observed_latency_ms:
        Math.round(Math.max(0, observedLatencyMs) * 1000) / 1000,
      cooldown_until: cooldownMs
        ? new Date(attemptedAt.getTime() + cooldownMs).toISOString()
        : null,
      retry_after_seconds: boundedRetryAfter,
      ...(failedStage ? { failed_stage: failedStage } : {}),
    };
    writeFileSync(this.path, `${JSON.stringify(event)}\n`, { flag: "a" });
    this.events.set(this.eventKey(scope, key), event);
    return event;
  }
}

function healthCheckpoint(
  output: string,
  resume: boolean,
  command: "search-batch" | "scrape-batch",
  profile: string,
  ephemeral: boolean,
  input: string,
  appendInput = false,
) {
  const path = `${output}.health.ndjson`;
  const currentInput = readFileSync(input);
  const inputSha256 = createHash("sha256").update(currentInput).digest("hex");
  const inputBytes = currentInput.byteLength;
  const checkpoint = new HealthCheckpoint(path);
  if (!existsSync(path)) {
    if (appendInput && statSync(output).size > 0) {
      fail(
        `${command} cannot verify --append-input without its existing health checkpoint; restore the original input or create a new output`,
      );
    }
    const run = {
      schema: "agency/web-health-run/1",
      command,
      profile,
      profile_mode: ephemeral ? "ephemeral" : "persistent",
      input_sha256: inputSha256,
      input_bytes: inputBytes,
      created_at: new Date().toISOString(),
    };
    writeFileSync(path, `${JSON.stringify(run)}\n`, {
      flag: "wx",
      mode: 0o600,
    });
    return checkpoint;
  }
  if (!resume) fail(`${command} health checkpoint exists; use --resume`);
  const lines = readFileSync(path, "utf8").split(/\r?\n/).filter(Boolean);
  let acceptedInputSha256 = "";
  let acceptedInputBytes: number | null = null;
  const outcomes = new Set<HealthOutcome>([
    "success",
    "empty",
    "partial",
    "failed",
    "challenged",
    "login-required",
    "rate-limited",
  ]);
  for (const [index, line] of lines.entries()) {
    let record: any;
    try {
      record = JSON.parse(line);
    } catch {
      fail(`${command} health checkpoint has invalid JSON on line ${index + 1}`);
    }
    if (index === 0) {
      if (record.schema !== "agency/web-health-run/1") {
        fail(`unsupported health checkpoint schema on line 1: ${String(record.schema || "missing")}`);
      }
      if (
        record.command !== command ||
        record.profile !== profile ||
        record.profile_mode !== (ephemeral ? "ephemeral" : "persistent")
      ) {
        fail(
          `${command} health checkpoint profile fingerprint changed; use the original profile or create a new output`,
        );
      }
      if (resume && ephemeral) {
        fail(`${command} cannot resume health state with an ephemeral profile`);
      }
      if (
        typeof record.input_sha256 !== "string" ||
        !/^[a-f0-9]{64}$/.test(record.input_sha256) ||
        !(
          record.input_bytes === undefined ||
          (Number.isInteger(record.input_bytes) && record.input_bytes >= 0)
        )
      ) {
        fail(`${command} health checkpoint has an invalid run record`);
      }
      acceptedInputSha256 = record.input_sha256;
      acceptedInputBytes = record.input_bytes ?? null;
      continue;
    }
    if (record.schema === "agency/web-health-input/1") {
      if (
        record.previous_sha256 !== acceptedInputSha256 ||
        record.previous_bytes !== acceptedInputBytes ||
        typeof record.input_sha256 !== "string" ||
        !/^[a-f0-9]{64}$/.test(record.input_sha256) ||
        !Number.isInteger(record.input_bytes) ||
        record.input_bytes <= (acceptedInputBytes ?? -1) ||
        typeof record.accepted_at !== "string" ||
        !Number.isFinite(Date.parse(record.accepted_at))
      ) {
        fail(`${command} health checkpoint has an invalid input record on line ${index + 1}`);
      }
      acceptedInputSha256 = record.input_sha256;
      acceptedInputBytes = record.input_bytes;
      continue;
    }
    if (record.schema !== "agency/web-health-event/1") {
      fail(`unsupported health checkpoint schema on line ${index + 1}: ${String(record.schema || "missing")}`);
    }
    if (
      !new Set(["provider", "origin"]).has(record.scope) ||
      typeof record.key !== "string" ||
      !record.key ||
      !outcomes.has(record.outcome) ||
      typeof record.last_attempt_at !== "string" ||
      !Number.isInteger(record.consecutive_failures) ||
      record.consecutive_failures < 0 ||
      typeof record.observed_latency_ms !== "number" ||
      !Number.isFinite(record.observed_latency_ms) ||
      !(
        record.cooldown_until === null ||
        (typeof record.cooldown_until === "string" &&
          Number.isFinite(Date.parse(record.cooldown_until)))
      ) ||
      !(
        record.retry_after_seconds === null ||
        (Number.isInteger(record.retry_after_seconds) &&
          record.retry_after_seconds >= 1 &&
          record.retry_after_seconds <= 24 * 60 * 60)
      ) ||
      !(
        record.failed_stage === undefined ||
        record.failed_stage === "navigation"
      )
    ) {
      fail(`${command} health checkpoint has an invalid event on line ${index + 1}`);
    }
    const event = record as HealthEvent;
    checkpoint.events.set(checkpoint.eventKey(event.scope, event.key), event);
  }
  if (
    acceptedInputSha256 === inputSha256 &&
    (acceptedInputBytes === null || acceptedInputBytes === inputBytes)
  ) {
    return checkpoint;
  }
  if (!appendInput) {
    fail(
      `${command} input fingerprint changed (expected ${acceptedInputSha256.slice(0, 12)}, got ${inputSha256.slice(0, 12)}); restore the original input, create a new output, or use --append-input with --resume for an unchanged prefix`,
    );
  }
  if (acceptedInputBytes === null) {
    fail(
      `${command} cannot verify an append against this older checkpoint; restore the original input or create a new output`,
    );
  }
  const prefixSha256 = createHash("sha256")
    .update(currentInput.subarray(0, acceptedInputBytes))
    .digest("hex");
  if (
    inputBytes <= acceptedInputBytes ||
    prefixSha256 !== acceptedInputSha256
  ) {
    fail(
      `${command} --append-input requires the previously accepted input to remain an unchanged byte prefix; restore it or create a new output`,
    );
  }
  writeFileSync(
    path,
    `${JSON.stringify({
      schema: "agency/web-health-input/1",
      previous_sha256: acceptedInputSha256,
      previous_bytes: acceptedInputBytes,
      input_sha256: inputSha256,
      input_bytes: inputBytes,
      accepted_at: new Date().toISOString(),
    })}\n`,
    { flag: "a" },
  );
  return checkpoint;
}

function batchQueries(value: string) {
  const input = realpathSync(resolve(value));
  const status = statSync(input);
  if (!status.isFile()) fail("search-batch input must be a regular file");
  if (status.size > 64 * 1024 * 1024) {
    fail("search-batch input must be at most 64 MiB");
  }
  const queries: string[] = [];
  const seen = new Set<string>();
  for (const raw of readFileSync(input, "utf8").split(/\r?\n/)) {
    const query = raw.trim();
    if (!query || seen.has(query)) continue;
    if (query.length > 1000) fail("search-batch queries must be at most 1000 characters");
    seen.add(query);
    queries.push(query);
  }
  return { input, queries };
}

function completedBatchQueries(output: string, retryFailures: boolean) {
  const completed = new Set<string>();
  const text = readFileSync(output, "utf8");
  for (const [index, line] of text.split(/\r?\n/).entries()) {
    if (!line.trim()) continue;
    let record: any;
    try {
      record = JSON.parse(line);
    } catch {
      fail(`search-batch output has invalid JSON on line ${index + 1}`);
    }
    if (
      record.schema !== "agency/web-search-result/1" ||
      typeof record.query !== "string" ||
      !new Set(["searched", "failed"]).has(record.outcome)
    ) {
      fail(`search-batch output has an invalid record on line ${index + 1}`);
    }
    if (!retryFailures || record.outcome === "searched") {
      completed.add(record.query);
    }
  }
  return completed;
}

function deterministicJitter(query: string, maximum: number) {
  if (!maximum) return 0;
  const digest = createHash("sha256").update(query).digest();
  return digest.readUInt32BE(0) % (maximum + 1);
}

async function commandSearchBatch(args: string[]) {
  const options = browserOptions(args);
  const outputValue = takeOption(args, "--output");
  const requestedEngine = takeOption(args, "--engine", "auto");
  const strategy = takeOption(args, "--strategy", "first");
  const limit = takeNumber(args, "--limit", 10, 1, 50);
  const delayMs = takeNumber(args, "--delay-ms", 1_500, 0, 60_000);
  const jitterMs = takeNumber(args, "--jitter-ms", 500, 0, 60_000);
  const maxQueries = takeNumber(args, "--max-queries", 1_000, 1, 100_000);
  const resume = takeFlag(args, "--resume");
  const retryFailures = takeFlag(args, "--retry-failures");
  const appendInput = takeFlag(args, "--append-input");
  const domains = takeOptions(args, "--domain").map(checkedDomain);
  const excludedDomains = takeOptions(args, "--exclude-domain").map(
    checkedDomain,
  );
  if (appendInput && !resume) fail("--append-input requires --resume");
  if (!outputValue) fail("search-batch requires --output PATH");
  if (args.length !== 1) fail("search-batch requires one query file");
  if (!new Set(["auto", "duckduckgo", "brave", "bing"]).has(requestedEngine)) {
    fail("--engine must be auto, duckduckgo, brave, or bing");
  }
  if (!new Set(["first", "federated"]).has(strategy)) {
    fail("--strategy must be first or federated");
  }
  if (strategy === "federated" && requestedEngine !== "auto") {
    fail("--strategy federated cannot be combined with an explicit --engine");
  }
  const { input, queries } = batchQueries(args[0]);
  const output = checkedBatchOutput(outputValue, resume, "search-batch");
  if (input === realpathSync(output)) {
    fail("search-batch input and output must be different files");
  }
  const previouslyCompleted = completedBatchQueries(output, retryFailures);
  const health = healthCheckpoint(
    output,
    resume,
    "search-batch",
    options.profile,
    options.ephemeral,
    input,
    appendInput,
  );
  const pending = queries
    .filter((query) => !previouslyCompleted.has(query))
    .slice(0, maxQueries);
  const summary = {
    schema: "agency/web-search-batch/1",
    input,
    output,
    total: queries.length,
    resumed: queries.filter((query) => previouslyCompleted.has(query)).length,
    attempted: 0,
    completed: 0,
    failed: 0,
    deferred: 0,
    pending: pending.length,
    stopped: false,
  };
  if (!pending.length) {
    console.log(JSON.stringify(summary, null, 2));
    return;
  }
  const state = newSearchRunState(health);
  if (!orderedSearchEngines(requestedEngine, state).length) {
    summary.deferred = pending.length;
    summary.stopped = true;
    console.log(JSON.stringify(summary, null, 2));
    return;
  }
  await withBrowser(options, async (browser) => {
    for (const [index, query] of pending.entries()) {
      summary.attempted += 1;
      try {
        const recordAttempt = (attempt: SearchAttempt) => {
          health.record(
            "provider",
            attempt.engine,
            attempt.outcome === "searched"
              ? "success"
              : attempt.outcome === "challenged"
                ? "challenged"
                : attempt.outcome,
            attempt.duration_ms,
            attempt.retry_after_seconds ?? null,
          );
        };
        const result = strategy === "federated"
          ? await searchFederated(
              browser,
              options,
              query,
              limit,
              domains,
              excludedDomains,
              state,
              recordAttempt,
            )
          : await searchOne(
              browser,
              options,
              query,
              requestedEngine,
              limit,
              domains,
              excludedDomains,
              state,
              recordAttempt,
            );
        writeFileSync(
          output,
          `${JSON.stringify({
            schema: "agency/web-search-result/1",
            query,
            outcome: "searched",
            engine: result.engine,
            strategy,
            scope: searchScope(query, domains, excludedDomains),
            results: result.results,
            attempts: result.attempts,
            completed_at: new Date().toISOString(),
          })}\n`,
          { flag: "a" },
        );
        summary.completed += 1;
      } catch (error) {
        const message = error instanceof Error ? error.message : String(error);
        writeFileSync(
          output,
          `${JSON.stringify({
            schema: "agency/web-search-result/1",
            query,
            outcome: "failed",
            error: message,
            completed_at: new Date().toISOString(),
          })}\n`,
          { flag: "a" },
        );
        summary.failed += 1;
        if (message.includes("no healthy search provider remains")) {
          summary.stopped = true;
          break;
        }
      }
      if (index < pending.length - 1) {
        await sleep(delayMs + deterministicJitter(query, jitterMs));
      }
    }
  });
  summary.pending = pending.length - summary.attempted;
  console.log(JSON.stringify(summary, null, 2));
  if (summary.failed) process.exitCode = 1;
}

function batchUrls(value: string) {
  const input = realpathSync(resolve(value));
  const status = statSync(input);
  if (!status.isFile()) fail("scrape-batch input must be a regular file");
  if (status.size > 256 * 1024 * 1024) {
    fail("scrape-batch input must be at most 256 MiB");
  }
  const lines = readFileSync(input, "utf8")
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);
  const candidates: Array<{
    url: string;
    evidence?: Omit<DiscoveryEvidence, "url">;
  }> = [];
  if (lines[0]?.startsWith("{")) {
    for (const [index, line] of lines.entries()) {
      let record: any;
      try {
        record = JSON.parse(line);
      } catch {
        fail(`scrape-batch input has invalid JSON on line ${index + 1}`);
      }
      if (
        record.schema !== "agency/web-search-result/1" ||
        record.outcome !== "searched" ||
        !Array.isArray(record.results)
      ) {
        continue;
      }
      for (const result of record.results) {
        if (typeof result?.url !== "string") continue;
        candidates.push({
          url: result.url,
          evidence: {
            source: "search-result",
            query:
              typeof record.query === "string" ? record.query.slice(0, 1000) : "",
            engine:
              typeof record.engine === "string" ? record.engine.slice(0, 100) : "",
            title:
              typeof result.title === "string" ? result.title.slice(0, 1000) : "",
            snippet:
              typeof result.snippet === "string"
                ? result.snippet.slice(0, 4000)
                : "",
          },
        });
      }
    }
  } else {
    candidates.push(...lines.map((url) => ({ url })));
  }
  const urls: string[] = [];
  const seen = new Set<string>();
  const discoveryEvidence = new Map<string, DiscoveryEvidence[]>();
  for (const candidate of candidates) {
    const url = checkedUrl(candidate.url);
    if (url.username || url.password) {
      fail("scrape-batch URLs must not contain embedded credentials");
    }
    const normalized = redactedOutputUrl(url.href);
    if (!normalized) continue;
    if (candidate.evidence) {
      const evidence = {
        ...candidate.evidence,
        url: normalized,
      } satisfies DiscoveryEvidence;
      const existing = discoveryEvidence.get(normalized) || [];
      const key = JSON.stringify(evidence);
      if (
        existing.length < 8 &&
        !existing.some((item) => JSON.stringify(item) === key)
      ) {
        existing.push(evidence);
        discoveryEvidence.set(normalized, existing);
      }
    }
    if (seen.has(normalized)) continue;
    seen.add(normalized);
    urls.push(normalized);
  }
  return { input, urls, discoveryEvidence };
}

function completedBatchUrls(output: string, retryFailures: boolean) {
  const completed = new Set<string>();
  for (const [index, line] of readFileSync(output, "utf8")
    .split(/\r?\n/)
    .entries()) {
    if (!line.trim()) continue;
    let record: any;
    try {
      record = JSON.parse(line);
    } catch {
      fail(`scrape-batch output has invalid JSON on line ${index + 1}`);
    }
    if (
      record.schema !== "agency/web-page-result/1" ||
      typeof record.requested_url !== "string" ||
      !new Set(["scraped", "partial", "failed"]).has(record.outcome)
    ) {
      fail(`scrape-batch output has an invalid record on line ${index + 1}`);
    }
    if (!retryFailures || record.outcome === "scraped") {
      completed.add(record.requested_url);
    }
  }
  return completed;
}

function interleaveUrlsByOrigin(urls: string[]) {
  const grouped = new Map<string, { urls: string[]; index: number }>();
  for (const url of urls) {
    const origin = new URL(url).origin;
    const group = grouped.get(origin);
    if (group) group.urls.push(url);
    else grouped.set(origin, { urls: [url], index: 0 });
  }
  let active = [...grouped.values()];
  const ordered: string[] = [];
  while (active.length) {
    const remaining = [];
    for (const group of active) {
      ordered.push(group.urls[group.index]);
      group.index += 1;
      if (group.index < group.urls.length) remaining.push(group);
    }
    active = remaining;
  }
  return ordered;
}

function retainedDiscoveryEvidence(
  evidence: DiscoveryEvidence[],
): JsonObject[] {
  return evidence.map((item, index) => {
    const capture = `search:${createHash("sha256")
      .update(`${item.query}\n${item.engine}\n${item.url}\n${index}`)
      .digest("hex")}`;
    const reference: EvidenceReference = {
      source: "search-result",
      capture,
    };
    return {
      ...item,
      provenance: {
        title: [reference],
        url: [reference],
        snippet: [reference],
      },
      quality: [
        {
          code: "search-snippet-only",
          fields: ["title", "url", "snippet"],
          observation:
            "Discovery evidence was retained without rendered source extraction; freshness is unverified",
        },
      ],
    };
  });
}

async function commandScrapeBatch(args: string[]) {
  const options = browserOptions(args);
  const outputValue = takeOption(args, "--output");
  const resume = takeFlag(args, "--resume");
  const retryFailures = takeFlag(args, "--retry-failures");
  const appendInput = takeFlag(args, "--append-input");
  const shouldIndex = takeFlag(args, "--index");
  const delayMs = takeNumber(args, "--delay-ms", 750, 0, 60_000);
  const jitterMs = takeNumber(args, "--jitter-ms", 250, 0, 60_000);
  const originDelayMs = takeNumber(
    args,
    "--origin-delay-ms",
    2_000,
    0,
    120_000,
  );
  const maxPages = takeNumber(args, "--max-pages", 1_000, 1, 100_000);
  if (appendInput && !resume) fail("--append-input requires --resume");
  if (!outputValue) fail("scrape-batch requires --output PATH");
  if (args.length !== 1) fail("scrape-batch requires one URL or search-result file");
  const { input, urls, discoveryEvidence } = batchUrls(args[0]);
  const output = checkedBatchOutput(outputValue, resume, "scrape-batch");
  if (input === realpathSync(output)) {
    fail("scrape-batch input and output must be different files");
  }
  const previouslyCompleted = completedBatchUrls(output, retryFailures);
  const health = healthCheckpoint(
    output,
    resume,
    "scrape-batch",
    options.profile,
    options.ephemeral,
    input,
    appendInput,
  );
  const allPending = urls.filter((url) => !previouslyCompleted.has(url));
  const work = interleaveUrlsByOrigin(allPending.slice(0, maxPages));
  const summary = {
    schema: "agency/web-scrape-batch/1",
    input,
    output,
    total: urls.length,
    resumed: urls.filter((url) => previouslyCompleted.has(url)).length,
    attempted: 0,
    completed: 0,
    partial: 0,
    failed: 0,
    deferred: 0,
    pending: allPending.length,
  };
  if (!work.length) {
    console.log(JSON.stringify(summary, null, 2));
    return;
  }
  const readyWork = work.filter((requestedUrl) => {
    if (!health.cooling("origin", new URL(requestedUrl).origin)) return true;
    summary.deferred += 1;
    return false;
  });
  if (!readyWork.length) {
    console.log(JSON.stringify(summary, null, 2));
    return;
  }
  const originReadyAt = new Map<string, number>();
  let requestReadyAt = 0;
  const indexer = shouldIndex ? pageIndexer() : null;
  try {
    await withBrowser(options, async (browser) => {
      for (const requestedUrl of readyWork) {
        const origin = new URL(requestedUrl).origin;
        if (health.cooling("origin", origin)) {
          summary.deferred += 1;
          continue;
        }
        const now = Date.now();
        const readyAt = Math.max(requestReadyAt, originReadyAt.get(origin) || 0);
        if (readyAt > now) await sleep(readyAt - now);
        summary.attempted += 1;
        const attemptStarted = performance.now();
        try {
          let page = await navigateAndExtract(browser, requestedUrl, options);
          if (options.capture) page = storedCapture(page, browser);
          const partial = page.outcome === "partial";
          if (!partial) indexer?.write(page);
          writeFileSync(
            output,
            `${JSON.stringify({
              schema: "agency/web-page-result/1",
              requested_url: requestedUrl,
              outcome: partial ? "partial" : "scraped",
              ...(partial
                ? {
                    constraint: page.constraint,
                    failed_stage: page.failed_stage,
                  }
                : {}),
              page,
              completed_at: new Date().toISOString(),
            })}\n`,
            { flag: "a" },
          );
          if (partial) {
            summary.partial += 1;
            health.record(
              "origin",
              origin,
              "partial",
              performance.now() - attemptStarted,
              null,
              "navigation",
            );
          } else {
            summary.completed += 1;
            health.record(
              "origin",
              origin,
              "success",
              performance.now() - attemptStarted,
            );
          }
        } catch (error) {
          const message = error instanceof Error ? error.message : String(error);
          const hardGate = message.includes("interactive challenge required")
            ? "hard-challenge"
            : message.includes("interactive login required")
              ? "hard-login"
              : message.includes("origin rate limited")
                ? "rate-limited"
              : "";
          const retainedEvidence = discoveryEvidence.get(requestedUrl) || [];
          if (hardGate && retainedEvidence.length) {
            writeFileSync(
              output,
              `${JSON.stringify({
                schema: "agency/web-page-result/1",
                requested_url: requestedUrl,
                outcome: "partial",
                constraint: hardGate,
                evidence: retainedDiscoveryEvidence(retainedEvidence),
                completed_at: new Date().toISOString(),
              })}\n`,
              { flag: "a" },
            );
            summary.partial += 1;
          } else {
            writeFileSync(
              output,
              `${JSON.stringify({
                schema: "agency/web-page-result/1",
                requested_url: requestedUrl,
                outcome: "failed",
                error: message,
                completed_at: new Date().toISOString(),
              })}\n`,
              { flag: "a" },
            );
            summary.failed += 1;
          }
          health.record(
            "origin",
            origin,
            hardGate === "hard-challenge"
              ? "challenged"
              : hardGate === "hard-login"
                ? "login-required"
                : hardGate === "rate-limited"
                  ? "rate-limited"
                  : "failed",
            performance.now() - attemptStarted,
            error && typeof error === "object"
              ? ((error as { retryAfterSeconds?: number }).retryAfterSeconds ??
                  null)
              : null,
          );
        }
        const completedAt = Date.now();
        requestReadyAt =
          completedAt + delayMs + deterministicJitter(requestedUrl, jitterMs);
        originReadyAt.set(origin, completedAt + originDelayMs);
      }
    });
  } finally {
    indexer?.close();
  }
  summary.pending =
    allPending.length - summary.completed - summary.partial - summary.failed;
  console.log(JSON.stringify(summary, null, 2));
  if (summary.failed) process.exitCode = 1;
}

async function commandRetrieve(args: string[]) {
  const allowPrivate = takeFlag(args, "--allow-private");
  const json = takeFlag(args, "--json");
  const maxBytes = takeNumber(
    args,
    "--max-bytes",
    5 * 1024 * 1024,
    1,
    100 * 1024 * 1024,
  );
  const maxRedirects = takeNumber(args, "--max-redirects", 10, 0, 20);
  const timeoutMs = takeNumber(args, "--timeout-ms", 30_000, 100, 120_000);
  if (!args.length) fail("retrieve requires at least one URL");
  if (args.length > 100) fail("retrieve accepts at most 100 URLs");
  const proxy = await safeProxy(allowPrivate);
  let results;
  try {
    const options = {
      allowPrivate,
      proxyUrl: proxy.url,
      maxBytes,
      maxRedirects,
      timeoutMs,
    };
    results = await boundedMap(args, 4, (url) => retrieveOne(url, options));
  } finally {
    await proxy.close();
  }
  const retrieved = results.filter(
    (result) => result.outcome === "retrieved",
  ).length;
  const report = {
    schema: "agency/web-retrieval/1",
    generated_at: new Date().toISOString(),
    summary: {
      total: results.length,
      retrieved,
      failed: results.length - retrieved,
    },
    results,
  };
  if (json) {
    console.log(JSON.stringify(report, null, 2));
  } else {
    for (const result of results) {
      if (result.outcome === "retrieved" && "retrieval" in result) {
        const retrieval = result.retrieval as JsonObject;
        console.log(
          `${pink}retrieved${reset} ${terminalText(retrieval.http_status)} ${terminalText(result.request.url)} → ${terminalText(retrieval.final_url)}`,
        );
      } else if ("error" in result) {
        const error = result.error as JsonObject;
        console.log(
          `${yellow}failed${reset} ${terminalText(result.request.url)} — ${terminalText(error.code)}: ${terminalText(error.message)}`,
        );
      }
    }
  }
  if (retrieved !== results.length) process.exitCode = 1;
}

async function commandDownload(args: string[]) {
  const outputValue = takeOption(args, "--output");
  const rootValue = takeOption(args, "--output-root");
  const profile = checkedProfile(takeOption(args, "--profile", "default"));
  const expectedValue = takeOption(args, "--expected-type").toLowerCase();
  const allowedOriginValue = takeOption(args, "--allow-origin");
  const contextValue = takeOption(args, "--context-url");
  const maxBytes = takeNumber(
    args,
    "--max-bytes",
    25 * 1024 * 1024,
    1,
    1024 * 1024 * 1024,
  );
  const timeoutMs = takeNumber(args, "--timeout-ms", 60_000, 1000, 600_000);
  const allowPrivate = takeFlag(args, "--allow-private");
  const replace = takeFlag(args, "--replace");
  const json = takeFlag(args, "--json");
  if (args.length !== 1) fail("download requires one URL");
  if (!outputValue || !rootValue) {
    fail("download requires --output PATH and --output-root PATH");
  }
  const sourceValue = args[0];
  const startedAt = new Date().toISOString();
  const started = performance.now();
  let temporaryDirectory = "";
  let report: JsonObject;
  try {
    const source = retrievalUrl(sourceValue);
    const allowedOrigin = allowedOriginValue
      ? retrievalUrl(allowedOriginValue).origin
      : source.origin;
    if (source.origin !== allowedOrigin) {
      throw new RetrievalFailure(
        "policy",
        "origin-not-allowed",
        `source origin does not match ${allowedOrigin}`,
        false,
      );
    }
    const contextUrl = contextValue ? retrievalUrl(contextValue) : null;
    if (contextUrl && contextUrl.origin !== allowedOrigin) {
      throw new RetrievalFailure(
        "policy",
        "context-origin-not-allowed",
        "--context-url must use the allowed source origin",
        false,
      );
    }
    const safety = await checkRetrievalSafety(source, allowPrivate);
    if (contextUrl) await checkRetrievalSafety(contextUrl, allowPrivate);
    const destination = checkedDownloadOutput(outputValue, rootValue, replace);
    const expectedType = inferredDownloadType(
      destination.output,
      expectedValue,
    );
    temporaryDirectory = mkdtempSync(
      join(destination.root, ".web-research-download-"),
    );
    const browserOptions: BrowserOptions = {
      profile,
      ephemeral: false,
      templatePreferences: [],
      headless: true,
      humanTimeout: 0,
      waitMs: 0,
      settleMs: 0,
      navigationTimeoutMs: Math.min(timeoutMs, 45_000),
      maxContentChars: 1,
      maxLinks: 1,
      scrollSteps: 0,
      interactionSteps: 0,
      captureNetworkJson: false,
      capture: false,
      allowPrivate,
    };
    const downloadedPath = await withBrowser(
      browserOptions,
      async (browser) => {
        if (contextUrl) {
          await browser.bidi.navigate(
            browser.context,
            contextUrl.href,
            browserOptions.navigationTimeoutMs,
          );
        }
        let navigationError: Error | null = null;
        try {
          await browser.bidi.command(
            "browsingContext.navigate",
            { context: browser.context, url: source.href, wait: "none" },
            Math.min(timeoutMs, 15_000),
          );
        } catch (error) {
          navigationError =
            error instanceof Error ? error : new Error(String(error));
        }
        try {
          return await waitForDownload(
            temporaryDirectory,
            maxBytes,
            timeoutMs,
          );
        } catch (downloadError) {
          let loginRequired = false;
          try {
            loginRequired = Boolean(
              await browser.bidi.evaluate(browser.context, loginExpression),
            );
          } catch {}
          if (loginRequired) {
            throw new RetrievalFailure(
              "authentication",
              "interactive-login-required",
              `profile '${profile}' requires interactive login`,
              false,
            );
          }
          if (navigationError) {
            throw new RetrievalFailure(
              "browser",
              "navigation-failed",
              navigationError.message,
              true,
            );
          }
          throw downloadError;
        }
      },
      downloadPreferences(temporaryDirectory),
    );
    const bytes = readFileSync(downloadedPath);
    if (bytes.length > maxBytes) {
      throw new RetrievalFailure(
        "limit",
        "download-too-large",
        `download exceeded the ${maxBytes}-byte limit`,
        false,
      );
    }
    verifyDownload(bytes, expectedType);
    if (existsSync(destination.output) && !replace) {
      throw new RetrievalFailure(
        "policy",
        "output-exists",
        "output appeared during retrieval and was not replaced",
        false,
      );
    }
    if (existsSync(destination.output)) {
      const existing = lstatSync(destination.output);
      if (!existing.isFile() || existing.isSymbolicLink()) {
        throw new RetrievalFailure(
          "policy",
          "output-not-regular",
          "output changed to a non-regular file during retrieval",
          false,
        );
      }
    }
    renameSync(downloadedPath, destination.output);
    const completedAt = new Date().toISOString();
    report = {
      schema: "agency/web-download/1",
      outcome: "downloaded",
      source: { url: source.href, allowed_origin: allowedOrigin },
      safety,
      provenance: {
        provider: "firefox-bidi",
        mode: "live-authenticated-browser",
        profile,
        retrieved_at: completedAt,
        redirected_url_disclosed: false,
      },
      output: {
        path: destination.output,
        bytes: bytes.length,
        sha256: createHash("sha256").update(bytes).digest("hex"),
        expected_type: expectedType,
        signature: "valid",
      },
      timing: {
        started_at: startedAt,
        completed_at: completedAt,
        duration_ms: Math.round((performance.now() - started) * 1000) / 1000,
      },
    };
  } catch (unknownError) {
    const error =
      unknownError instanceof RetrievalFailure
        ? unknownError
        : new RetrievalFailure(
            "browser",
            "download-failed",
            unknownError instanceof Error
              ? unknownError.message
              : String(unknownError),
            true,
          );
    report = {
      schema: "agency/web-download/1",
      outcome: "failed",
      source: { url: sourceValue },
      provenance: {
        provider: "firefox-bidi",
        mode: "live-authenticated-browser",
        profile,
        attempted_at: new Date().toISOString(),
        redirected_url_disclosed: false,
      },
      error: {
        kind: error.kind,
        code: error.code,
        message: error.message,
        retriable: error.retriable,
      },
    };
  } finally {
    if (temporaryDirectory) {
      rmSync(temporaryDirectory, { recursive: true, force: true });
    }
  }
  if (json) console.log(JSON.stringify(report, null, 2));
  else if (report.outcome === "downloaded") {
    const output = report.output as JsonObject;
    console.log(
      `${pink}downloaded${reset} ${terminalText(output.path)} (${terminalText(output.bytes)} bytes)`,
    );
  } else {
    const error = report.error as JsonObject;
    console.log(
      `${yellow}failed${reset} ${terminalText(error.code)}: ${terminalText(error.message)}`,
    );
  }
  if (report.outcome !== "downloaded") process.exitCode = 1;
}

async function commandScrape(args: string[]) {
  const options = browserOptions(args);
  const format = takeOption(args, "--format", "markdown");
  const output = takeOption(args, "--output");
  const shouldIndex = takeFlag(args, "--index");
  const shouldPreflight = takeFlag(args, "--preflight");
  const includeFrames = takeFlag(args, "--include-frames");
  const frameOrigins = takeOptions(args, "--frame-origin").map(
    (value) => checkedUrl(value).origin,
  );
  if (!new Set(["markdown", "text", "html", "json"]).has(format)) {
    fail("--format must be markdown, text, html, or json");
  }
  if (includeFrames && format !== "json") {
    fail("--include-frames requires --format json");
  }
  if (options.capture && format !== "json") {
    fail(
      "--capture requires --format json; use: web-research scrape URL --format json --capture --profile TASK",
    );
  }
  if (args.length !== 1) fail("scrape requires one URL");
  const url = checkedUrl(args[0]);
  explicitNetworkTarget(url, options.allowPrivate);
  const cacheEligible =
    shouldPreflight &&
    format !== "html" &&
    !includeFrames &&
    !options.capture &&
    !options.captureNetworkJson &&
    options.scrollSteps === 0 &&
    options.interactionSteps === 0;
  const preflight = cacheEligible
    ? cachedPage(url.href)
    : { cache: "bypass" as const };
  let page = preflight.page;
  if (!page) {
    page = await withBrowser(options, async (browser) => {
      let extracted = await navigateAndExtract(
        browser,
        url.href,
        options,
      );
      let frames: JsonObject[] = [];
      if (includeFrames) {
        let topOrigin = url.origin;
        try {
          topOrigin = new URL(extracted.url).origin;
        } catch {}
        frames = await extractFrames(browser, topOrigin, frameOrigins);
      }
      const input = pageCaptures.get(extracted);
      if (!input) throw new Error("page capture state is unavailable");
      input.frames = frames;
      extracted = fusePageCapture(input);
      pageCaptures.set(extracted, input);
      if (options.capture) {
        extracted = storedCapture(extracted, browser, frames);
      }
      return extracted;
    });
    if ((shouldIndex || shouldPreflight) && page.outcome !== "partial") {
      page.freshness = indexPage(page, url.href, preflight.cache);
    } else {
      const retrievedAt = new Date().toISOString();
      const policy = freshnessPolicy(page, retrievedAt);
      page.freshness = {
        retrieval: "live",
        cache: preflight.cache,
        change_likelihood: policy.changeLikelihood,
        basis: policy.basis,
        retrieved_at: retrievedAt,
        indexed_at: null,
        refresh_after: policy.refreshAfter,
        content_sha256: contentHash(page),
      };
    }
  }
  const content =
    format === "json"
      ? JSON.stringify(page, null, 2)
      : format === "text"
        ? page.text
        : format === "html"
          ? page.html
          : page.markdown;
  if (output) {
    const path = resolve(output);
    await Bun.write(path, `${content}\n`);
    info(`wrote ${path}`);
  } else {
    console.log(terminalText(content));
  }
}

async function commandScrapeMany(args: string[]) {
  const options = browserOptions(args);
  const shouldIndex = takeFlag(args, "--index");
  rejectUnknownOptions(args, "scrape-many");
  if (args.length) fail("scrape-many accepts its request on stdin");
  let payload: unknown;
  try {
    payload = JSON.parse(await Bun.stdin.text());
  } catch {
    fail("scrape-many requires a JSON request on stdin");
  }
  const values = (payload as JsonObject).urls;
  if (
    !Array.isArray(values) ||
    !values.length ||
    values.length > 10 ||
    !values.every((value) => typeof value === "string")
  ) {
    fail("scrape-many urls must contain 1–10 URL strings");
  }
  const urls = values.map((value) => checkedUrl(String(value)));
  for (const url of urls) explicitNetworkTarget(url, options.allowPrivate);
  const pages = new Array<Page | PageBatchFailure>(urls.length);
  const pending: Array<{ index: number; url: URL; cache: "miss" | "stale" }> = [];
  for (const [index, url] of urls.entries()) {
    const preflight = options.capture ? { cache: "bypass" as const } : cachedPage(url.href);
    if (preflight.page) pages[index] = preflight.page;
    else pending.push({
      index,
      url,
      cache: preflight.cache === "stale" ? "stale" : "miss",
    });
  }
  const indexer = shouldIndex ? pageIndexer() : null;
  try {
    if (pending.length) {
      await withBrowser(options, async (browser) => {
        for (const item of pending) {
          try {
            let page = await navigateAndExtract(browser, item.url.href, options);
            if (options.capture) page = storedCapture(page, browser);
            if (page.outcome !== "partial") {
              if (indexer) {
                page.freshness = indexer.write(page, item.url.href, item.cache);
              } else {
                const retrievedAt = new Date().toISOString();
                const policy = freshnessPolicy(page, retrievedAt);
                page.freshness = {
                  retrieval: "live",
                  cache: item.cache,
                  change_likelihood: policy.changeLikelihood,
                  basis: policy.basis,
                  retrieved_at: retrievedAt,
                  indexed_at: null,
                  refresh_after: policy.refreshAfter,
                  content_sha256: contentHash(page),
                };
              }
            }
            pages[item.index] = page;
          } catch (error) {
            const message = terminalText(
              error instanceof Error ? error.message : String(error),
            );
            let kind = "retrieval";
            let code = "page-load-failed";
            let retriable = true;
            if (error instanceof RetrievalFailure) {
              kind = error.kind;
              code = error.code;
              retriable = error.retriable;
            } else if (/interactive login required/i.test(message)) {
              kind = "access";
              code = "interactive-login-required";
              retriable = false;
            } else if (/interactive challenge required/i.test(message)) {
              kind = "access";
              code = "interactive-challenge-required";
              retriable = false;
            } else if (/rate limit/i.test(message)) {
              kind = "network";
              code = "rate-limited";
            }
            pages[item.index] = {
              url: redactedOutputUrl(item.url.href),
              error: { kind, code, message, retriable },
            };
          }
        }
      });
    }
  } finally {
    indexer?.close();
  }
  console.log(JSON.stringify({ pages }));
}

function commandReplay(args: string[]) {
