type PageStability = {
  readyState: string;
  url: string;
  title: string;
  textLength: number;
  scrollHeight: number;
  links: number;
  shadowRoots: number;
};

async function settlePage(
  browser: Awaited<ReturnType<typeof startBrowser>>,
  options: BrowserOptions,
) {
  if (options.waitMs) await sleep(options.waitMs);
  const read = async () =>
    JSON.parse(
      String(
        await browser.bidi.evaluate(browser.context, pageStabilityExpression),
      ),
    ) as PageStability;
  if (!options.settleMs) return read();
  const deadline = Date.now() + options.settleMs;
  let previous = "";
  let stableMatches = 0;
  let state = await read();
  while (true) {
    const signature = JSON.stringify(state);
    stableMatches = signature === previous ? stableMatches + 1 : 0;
    if (state.readyState !== "loading" && stableMatches >= 1) return state;
    if (Date.now() >= deadline) return state;
    previous = signature;
    await sleep(Math.min(200, Math.max(1, deadline - Date.now())));
    state = await read();
  }
}

async function preparePage(
  browser: Awaited<ReturnType<typeof startBrowser>>,
  options: BrowserOptions,
) {
  let state = await settlePage(browser, options);
  await waitForPageAccess(browser, options);
  for (let step = 0; step < options.scrollSteps; step += 1) {
    const before = state.scrollHeight;
    await browser.bidi.evaluate(
      browser.context,
      "window.scrollTo(0, document.documentElement?.scrollHeight || document.body?.scrollHeight || 0)",
    );
    state = await settlePage(browser, options);
    await waitForPageAccess(browser, options);
    if (state.scrollHeight <= before) break;
  }
  return state;
}

const pageAccessExpression = String.raw`(() => {
