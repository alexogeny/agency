                    'type': 'object', 'additionalProperties': False, 'required': ['id', 'profile', 'state'],
                    'properties': {
                        'id': {'type': 'string', 'pattern': '^[A-Za-z0-9_.-]{1,80}$'},
                        'profile': {'type': 'string', 'enum': list(PROFILES)},
