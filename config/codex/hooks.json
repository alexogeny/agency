{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/system-context",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agency-decision-usage --client codex",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agency-decision-usage --client codex",
            "timeout": 3
          }
        ],
        "matcher": "^(Bash|mcp__agency[-_]decide__classify(_batch)?)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agency-decision-usage --client codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agency-decision-usage --client codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
