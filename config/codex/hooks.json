{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/system-context",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
