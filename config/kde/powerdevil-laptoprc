# 🎀 Keep portable hardware responsive on AC and conservative on battery.

[AC][Display]
DimDisplayIdleTimeoutSec=900
DisplayBrightness=86
TurnOffDisplayIdleTimeoutSec=1800
TurnOffDisplayIdleTimeoutWhenLockedSec=300
UseProfileSpecificDisplayBrightness=true

[AC][Performance]
PowerProfile=performance

[AC][SuspendAndShutdown]
AutoSuspendIdleTimeoutSec=1800

[Battery][Display]
DimDisplayIdleTimeoutSec=300
DisplayBrightness=26
TurnOffDisplayIdleTimeoutSec=900
UseProfileSpecificDisplayBrightness=true

[Battery][Performance]
PowerProfile=power-saver

[LowBattery][Display]
DisplayBrightness=9

[LowBattery][Performance]
PowerProfile=power-saver
